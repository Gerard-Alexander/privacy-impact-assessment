<%- include('../layouts/head', { title: title }) %>
	<div class="d-flex">
		<%- include('../layouts/sidebar', { activePage: activePage }) %>
		<div class="flex-grow-1 main-content-offset">
		<%- include('../layouts/topbar', { title: title, user: user }) %>		
			<main class="container-fluid py-4 px-4">
				<%- include('../layouts/stepper', { currentStep: 2, dpsTitle: 'Data Processing System', authParties: 'Authorized Parties', 
					user: user 
				}) %>
				<% if (error) { %>
					<div class="alert alert-danger mx-auto" style="max-width: 850px;"><%= error %></div>
				<% } %>
				<% if (success) { %>
					<div class="alert alert-success mx-auto" style="max-width: 850px;"><%= success %></div>
				<% } %>

				<!-- Privacy Notice Hover Tooltip -->
				<div class="text-start mb-3 mx-3">
					<small class="text-muted">
						Agree to our
						<a href="#" class="text-success text-decoration-none fw-semibold"
							data-bs-toggle="modal" data-bs-target="#privacyModal">
							Privacy Notice
						</a>
					</small>
				</div>

				<div class="modal fade" id="privacyModal" tabindex="-1">
					<div class="modal-dialog modal-lg modal-dialog-centered">
						<div class="modal-content">

							<div class="modal-header bg-info text-white py-2">
								<h6 class="mb-0">Privacy Notice</h6>
								<button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
							</div>

							<div class="modal-body" style="max-height:60vh;overflow:auto">
								<p class="mb-0">
									By submitting this privacy impact assessment, I hereby give my consent to USLT for the collection, processing, and storage of my personal information. This information will be used solely for legitimate educational, research, and institutional purposes, in accordance with University policies and the Republic Act No. 10173, also known as the Data Privacy Act of 2012. I understand that my personal data will be kept confidential and will not be disclosed with unauthorized parties, except as required by law, court order, or with my explicit consent. I acknowledge my rights under the Data Privacy Act, including the right to access, correct, and request the deletion of my personal data, subject to applicable regulations.
								</p>
							</div>

							<div class="modal-footer py-2">
								<button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
							</div>

						</div>
					</div>
				</div>

				<div class="mx-auto" style="max-width: 850px;">
					<% const formData = authorizedPartiesData || {}; %>
					<style>
					/* Modern UI Enhancements */
					.form-floating > .form-control:focus ~ label,
					.form-floating > .form-control:not(:placeholder-shown) ~ label,
					.form-floating > .form-select ~ label {
						color: var(--bs-primary);
						font-weight: 600;
					}
					.form-control, .form-select {
						border-radius: 0.5rem;
						border: 1px solid #dee2e6;
						padding: 0.75rem 1rem;
						transition: all 0.2s ease-in-out;
					}
					.form-control:focus, .form-select:focus {
						border-color: var(--bs-primary);
						box-shadow: 0 0 0 0.25rem rgba(13, 27, 75, 0.1);
					}
					.custom-card {
						border-radius: 1rem;
						background: #ffffff;
						box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
						overflow: hidden;
						animation: fadeIn 0.5s ease-out;
					}
					.custom-header {
						background: linear-gradient(135deg, rgba(13, 27, 75, 0.05) 0%, transparent 100%);
						border-bottom: 2px solid rgba(13, 27, 75, 0.1);
						padding: 1.5rem 2rem;
					}
					.custom-header-title {
						color: #0d1b4b; /* matching sidebar primary color */
						font-weight: 700;
						letter-spacing: -0.5px;
					}
					.btn-modern {
						border-radius: 0.5rem;
						padding: 0.6rem 1.5rem;
						font-weight: 600;
						transition: all 0.3s ease;
						display: inline-flex;
						align-items: center;
						gap: 0.5rem;
					}
					.btn-modern:hover {
						transform: translateY(-2px);
						box-shadow: 0 5px 15px rgba(13, 27, 75, 0.2);
					}
					@keyframes fadeIn {
						from { opacity: 0; transform: translateY(10px); }
						to { opacity: 1; transform: translateY(0); }
					}
					.form-section {
						padding: 2rem;
					}
					.upload-box {
						border: 2px dashed #dee2e6;
						border-radius: 0.75rem;
						transition: all 0.2s ease;
					}
					.upload-box:hover {
						border-color: var(--bs-primary);
						background-color: rgba(13, 27, 75, 0.02);
					}
					</style>
					<form id="authorizedForm" action="/assessment/authorizedparties" method="POST">
						<input type="hidden" name="piaAssessment_id" value="<%= piaAssessmentId %>">
						<div class="card border-0 custom-card mb-4">
							<div class="custom-header d-flex align-items-center">
								<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
									<i class="bi bi-people-fill fs-5"></i>
								</div>
								<div>
									<h5 class="mb-0 custom-header-title">Section B - Authorized Parties</h5>
									<small class="text-muted">Head Office and Compliance Officer Information.</small>
								</div>
							</div>

							<div class="card-body form-section">
								<div class="row g-5">
									<!-- LEFT COLUMN -->
									<div class="col-lg-6 position-relative">
										<h6 class="fw-bold mb-4 text-primary border-bottom pb-2">Head Office / Process Owner</h6>
										
										<div class="row g-3 mb-4">
											<div class="col-md-6">
												<div class="form-floating">
													<input type="text" id="headFirstName" name="headFirstName" class="form-control" placeholder="First Name" required value="<%= formData.headFirstName || '' %>">
													<label for="headFirstName">First Name <span class="text-danger">*</span></label>
												</div>
											</div>
											<div class="col-md-6">
												<div class="form-floating">
													<input type="text" id="headLastName" name="headLastName" class="form-control" placeholder="Last Name" required value="<%= formData.headLastName || '' %>">
													<label for="headLastName">Last Name <span class="text-danger">*</span></label>
												</div>
											</div>
										</div>
										<div class="form-floating mb-4">
											<input type="text" id="headPosition" name="headPosition" class="form-control" placeholder="Position" required value="<%= formData.headPosition || '' %>">
											<label for="headPosition">Position <span class="text-danger">*</span></label>
										</div>
										<div class="form-floating mb-4">
											<input type="text" id="headOfficeUnit" name="headOfficeUnit" class="form-control" placeholder="Office / Unit" required value="<%= formData.headOfficeUnit || '' %>">
											<label for="headOfficeUnit">Office / Unit <span class="text-danger">*</span></label>
										</div>
										<div class="form-floating">
											<input type="date" id="headDateSigned" name="headDateSigned" class="form-control" value="<%= formData.headDateSigned || '' %>">
											<label for="headDateSigned">Date Signed</label>
										</div>
										<!-- Separator line for mobile -->
										<div class="d-lg-none border-bottom my-5"></div>
									</div>

									<!-- RIGHT COLUMN -->
									<div class="col-lg-6">
										<h6 class="fw-bold mb-4 text-primary border-bottom pb-2">Compliance Officer for Privacy (PIP)</h6>
										
										<div class="row g-3 mb-4">
											<div class="col-md-6">
												<div class="form-floating">
													<input type="text" id="compName" name="compName" class="form-control" placeholder="First Name" required value="<%= formData.compName || '' %>">
													<label for="compName">First Name <span class="text-danger">*</span></label>
												</div>
											</div>
											<div class="col-md-6">
												<div class="form-floating">
													<input type="text" id="compLastName" name="compLastName" class="form-control" placeholder="Last Name" required value="<%= formData.compLastName || '' %>">
													<label for="compLastName">Last Name <span class="text-danger">*</span></label>
												</div>
											</div>
										</div>
										<div class="form-floating mb-4">
											<input type="text" id="compPosition" name="compPosition" class="form-control" placeholder="Position" required value="<%= formData.compPosition || '' %>">
											<label for="compPosition">Position <span class="text-danger">*</span></label>
										</div>
										<div class="form-floating mb-4">
											<input type="email" id="compEmail" name="compEmail" class="form-control" placeholder="Email" required value="<%= formData.compEmail || '' %>">
											<label for="compEmail">Email <span class="text-danger">*</span></label>
										</div>
										<div class="form-floating">
											<input type="date" id="compDateSigned" name="compDateSigned" class="form-control" value="<%= formData.compDateSigned || '' %>">
											<label for="compDateSigned">Date Signed</label>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="card border-0 custom-card mb-4">
							<div class="custom-header d-flex align-items-center">
								<div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
									<i class="bi bi-check-circle-fill fs-5"></i>
								</div>
								<div>
									<h5 class="mb-0 custom-header-title">Approvals</h5>
									<small class="text-muted">Reviewed and Approved By Information.</small>
								</div>
							</div>

							<div class="card-body form-section">
								<div class="row g-5">
									<!-- LEFT COLUMN -->
									<div class="col-lg-6">
										<h6 class="fw-bold mb-4 text-success border-bottom pb-2">Reviewed By</h6>
										
										<div class="row g-3 mb-4">
											<div class="col-md-6">
												<div class="form-floating">
													<input type="text" id="reviewFirstName" name="reviewFirstName" class="form-control" placeholder="First Name" required value="<%= formData.reviewFirstName || '' %>">
													<label for="reviewFirstName">First Name <span class="text-danger">*</span></label>
												</div>
											</div>
											<div class="col-md-6">
												<div class="form-floating">
													<input type="text" id="reviewLastName" name="reviewLastName" class="form-control" placeholder="Last Name" required value="<%= formData.reviewLastName || '' %>">
													<label for="reviewLastName">Last Name <span class="text-danger">*</span></label>
												</div>
											</div>
										</div>
										<div class="form-floating mb-4">
											<input type="text" id="reviewPosition" name="reviewPosition" class="form-control" placeholder="Position" required value="<%= formData.reviewPosition || '' %>">
											<label for="reviewPosition">Position <span class="text-danger">*</span></label>
										</div>
										<div class="form-floating">
											<input type="date" id="reviewDateSigned" name="reviewDateSigned" class="form-control" value="<%= formData.reviewDateSigned || '' %>">
											<label for="reviewDateSigned">Date Signed</label>
										</div>
										<!-- Separator line for mobile -->
										<div class="d-lg-none border-bottom my-5"></div>
									</div>

									<!-- RIGHT COLUMN -->
									<div class="col-lg-6">
										<h6 class="fw-bold mb-4 text-success border-bottom pb-2">Approved By</h6>
										
										<div class="row g-3 mb-4">
											<div class="col-md-6">
												<div class="form-floating">
													<input type="text" id="approveFirstName" name="approveFirstName" class="form-control" placeholder="First Name" required value="<%= formData.approveFirstName || '' %>">
													<label for="approveFirstName">First Name <span class="text-danger">*</span></label>
												</div>
											</div>
											<div class="col-md-6">
												<div class="form-floating">
													<input type="text" id="approveLastName" name="approveLastName" class="form-control" placeholder="Last Name" required value="<%= formData.approveLastName || '' %>">
													<label for="approveLastName">Last Name <span class="text-danger">*</span></label>
												</div>
											</div>
										</div>
										<div class="form-floating mb-4">
											<input type="text" id="approvePosition" name="approvePosition" class="form-control" placeholder="Position" required value="<%= formData.approvePosition || '' %>">
											<label for="approvePosition">Position <span class="text-danger">*</span></label>
										</div>
										<div class="form-floating">
											<input type="date" id="approveDateSigned" name="approveDateSigned" class="form-control" value="<%= formData.approveDateSigned || '' %>">
											<label for="approveDateSigned">Date Signed</label>
										</div>
									</div>
								</div>
							</div>
						</div>

					<!-- Footer Buttons -->
					<hr class="my-4 text-muted">
					<div class="d-flex align-items-center justify-content-between mt-2">
						<button type="submit" form="authorizedForm" name="redirectTo" value="previous" formnovalidate
							class="btn btn-danger btn-modern shadow-sm">
							<i class="bi bi-arrow-left-short fs-5"></i> Previous Page
						</button>
						<span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill fw-medium">Step 2 of 7</span>
						<button type="submit" form="authorizedForm" class="btn btn-primary btn-modern shadow-sm">
							Next Page <i class="bi bi-arrow-right-short fs-5"></i>
						</button>
					</div>
				</div>
      </main>
    </div>
  </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
