      <!-- Navigation -->
      <nav class="nav flex-column gap-2 mb-auto">
        <a href="/dashboard" class="nav-link rounded-3 px-3 py-2 <%= activePage === 'dashboard' ? 'active bg-primary text-white shadow-sm' : 'text-white-50 hover-bg' %>" 
