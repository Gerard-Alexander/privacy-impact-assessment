// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

// --- USERS TABLE --- //
enum Role {
  ADMIN
  USER
  REVIEWER
}

model User {
  id              Int               @id @default(autoincrement())
  firstName       String            @db.VarChar(255)
  lastName        String            @db.VarChar(255)
  userName        String            @unique @db.VarChar(255)
  emailAddress    String            @unique @db.VarChar(255)
  password        String
  role            Role              @default(USER)
  rememberToken   String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Assessments created by this user
  createdAssessments PiaAssessment[] @relation("AssessmentCreator")
  // Assessments shared to this user
  sharedAssessments  AssessmentShare[]
}

// --- ROOT TABLE: PIA ASSESSMENT --- //
// This acts as the umbrella for a single submitted PIA form
model PiaAssessment {
  id                          Int      @id @default(autoincrement())
  dpsName                     String   @db.VarChar(255)
  mandate                     String   @db.Text
  dpsModality                 Modality 
  processingRole              RoleType 
  isOutsourced                Boolean
  piaStartDate                DateTime
  piaEndDate                  DateTime
  status                      Status    @default(DRAFT)

  // Creator / owner of this assessment
  creatorId                   Int?
  creator                     User?     @relation("AssessmentCreator", fields: [creatorId], references: [id])

  // Users this assessment is shared with
  sharedWith                  AssessmentShare[]

  // Privacy Notice Agreement
  privacyNoticeAcknowledged   Boolean  @default(false) 

  // Static Form Questions (from the final page checklist)
  isDataTransferredOutsidePh  Boolean?
  hasDataSharingAgreement     Boolean?
  pipName                     String?  @db.VarChar(255)
  isPublicFacing              PublicFacing?
  hasAutomatedDecisionMaking  Boolean?
  hasProfiling                Boolean?
  legalBasis                  String?  @db.VarChar(255)
  otherLegalBasisInfo         String?  @db.Text
  isConsentUsed               Boolean?
  consentProof                ConsentProof?

  // Relationships tying the whole form together
  authorizedParties           AuthorizedParties[]
  pdlc                        PDLC[]
  pii                         PII[]
  threatsAndControls          ThreatsAndControl[]
  securityMeasures            SecurityMeasures[]

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([creatorId])
}

// --- ASSESSMENT SHARING (many-to-many) --- //
model AssessmentShare {
  id               Int           @id @default(autoincrement())

  piaAssessment_id Int
  piaAssessment    PiaAssessment @relation(fields: [piaAssessment_id], references: [id], onDelete: Cascade)

  user_id          Int
  user             User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  createdAt        DateTime      @default(now())

  @@unique([piaAssessment_id, user_id])
  @@index([piaAssessment_id])
  @@index([user_id])
}

enum Modality {
  MANUAL
  ELECTRONIC
  BOTH
}

enum RoleType {
  PIC
  PIP
}
enum Status {
  DRAFT
  COMPLETED
  ARCHIVED
}

enum PublicFacing {
  EXTERNAL
  INTERNAL
  BOTH
}

enum ConsentProof {
  CONSENT_FORM
  OTHER_PROOF
  BOTH
}

// --- AUTHORIZED PARTIES TABLE --- //
model AuthorizedParties {
  id               Int                 @id @default(autoincrement())
  
  // FK to PiaAssessment
  piaAssessment_id Int
  piaAssessment    PiaAssessment       @relation(fields: [piaAssessment_id], references: [id], onDelete: Cascade)
  
  name             String              @db.VarChar(255)
  position         String              @db.VarChar(255)
  officeUnit       String              @db.VarChar(255) 
  email            String              @db.VarChar(255)
  userType         AuthorizedPartyType 
  dateSigned       DateTime?
  
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([piaAssessment_id])
}

enum AuthorizedPartyType {
  HEAD_OFFICE
  COMPLIANCE_OFFICER
  REVIEWER
  APPROVED_BY
}

//***************************************//
// --- A. PROCESS DATA LIFE CYCLE TABLE --- //
model PDLC {
  id               Int           @id @default(autoincrement())
  
  // FK to PiaAssessment
  piaAssessment_id Int
  piaAssessment    PiaAssessment @relation(fields: [piaAssessment_id], references: [id], onDelete: Cascade)
  
  stakeholderName  String        @db.VarChar(255)
  retentionPeriod  String        @db.VarChar(255) 
  retentionDate    DateTime?
  disposalMethod   String        @db.VarChar(255) 
  dlcDiagram       String?       @db.Text
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  collections      PDLCCollection[]
  uses             PDLCUse[]
  sharings         PDLCSharing[]

  threatsAndControls ThreatsAndControl[] 
  
  @@index([piaAssessment_id])
}

model PDLCCollection {
  id            Int      @id @default(autoincrement())

  pdlc_id       Int
  pdlc          PDLC     @relation(fields: [pdlc_id], references: [id], onDelete: Cascade)

  dateCollected DateTime?
  collection    String   @db.VarChar(255)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pdlc_id])
}

model PDLCUse {
  id         Int      @id @default(autoincrement())

  pdlc_id    Int
  pdlc       PDLC     @relation(fields: [pdlc_id], references: [id], onDelete: Cascade)

  useOfData  String   @db.VarChar(255)
  process    String   @db.VarChar(255)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pdlc_id])
}

model PDLCSharing {
  id          Int      @id @default(autoincrement())

  pdlc_id     Int
  pdlc        PDLC     @relation(fields: [pdlc_id], references: [id], onDelete: Cascade)

  dataSharing String   @db.VarChar(255)
  sharedTo    String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pdlc_id])
}

enum DisposalMethod {
  SHREDDING
  DELETION
  SOAKING_WITH_WATER
}

//***********************************************//
// --- B. PERSONAL INFORMATION INVENTORY TABLE --- //
model PII {
  id                  Int              @id @default(autoincrement())
  
  // FK to PiaAssessment
  piaAssessment_id    Int
  piaAssessment       PiaAssessment    @relation(fields: [piaAssessment_id], references: [id], onDelete: Cascade)
  
  formNo              Int
  formName            String           @db.VarChar(255)
  dataProcessing      DataProcessing
  dataFormImagePath   String?          @db.Text
  dataFormImageUploadedAt DateTime?

  // FK to ProcessingBasis (PI)
  piProcessBasis_id   Int
  piProcessBasis      ProcessingBasis  @relation("PiProcessBasis", fields: [piProcessBasis_id], references: [id])

  // FK to ProcessingBasis (SPI)
  spiProcessBasis_id  Int
  spiProcessBasis     ProcessingBasis  @relation("SpiProcessBasis", fields: [spiProcessBasis_id], references: [id])
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  piiDatasubjects     PiiDatasubject[]
  recipientUsers      RecipientUser[]

  @@index([piaAssessment_id])
  @@index([piProcessBasis_id])
  @@index([spiProcessBasis_id])
}

enum DataProcessing {
  ELECTRONIC 
  PAPER_BASED
  BOTH
}

model DataSubjectTypes {
  id              Int         @id @default(autoincrement())
  dataSubjectType datasubject
  piiDatasubjects PiiDatasubject[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum datasubject {
  EMPLOYEES
  CUSTOMERS
  CLIENTS
  SUPPLIERS
}

model PiiDatasubject {
  id                 Int                 @id @default(autoincrement())

  // FK to PII
  pii_id             Int
  pii                PII                 @relation(fields: [pii_id], references: [id], onDelete: Cascade)

  // FK to DataSubjectType
  dataSubjectsType_id Int
  dataSubjectType     DataSubjectTypes   @relation(fields: [dataSubjectsType_id], references: [id])

  name               String              @db.VarChar(255)

  threatsAndControls ThreatsAndControl[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([pii_id])
  @@index([dataSubjectsType_id])
}

model RecipientUser {
  id            Int      @id @default(autoincrement())

  // FK to PII
  pii_id        Int
  pii           PII      @relation(fields: [pii_id], references: [id], onDelete: Cascade)

  recipientName String   @db.VarChar(255)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pii_id])
}

model ProcessingBasis {
  id             Int            @id @default(autoincrement())
  processingType String         @db.VarChar(255)
  basisNum       String         @db.VarChar(255)
  keyword        String         @db.VarChar(255)
  description    String         @db.Text

  piPii          PII[]          @relation("PiProcessBasis")
  spiPii         PII[]          @relation("SpiProcessBasis")

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

//**********************************************//
// --- C. THREATS AND CONTROL MEASURES TABLE --- //
model ThreatsAndControl { 
  id                           Int             @id @default(autoincrement())
  
  // FK to PiaAssessment
  piaAssessment_id             Int
  piaAssessment                PiaAssessment   @relation(fields: [piaAssessment_id], references: [id], onDelete: Cascade)

  // FK to PiiDatasubject
  dataSubject_id               Int
  dataSubjects                 PiiDatasubject @relation(fields: [dataSubject_id], references :[id])

  // FK to PDLC
  pdlc_id                      Int
  pdlc                         PDLC            @relation(fields : [pdlc_id], references :[id])

  threats_possibleConsequences String?          @db.VarChar(255)
  
  // String to allow multi-select (e.g., "CONFIDENTIALITY, INTEGRITY")
  typeOfThreats                String?          @db.VarChar(255) 
  
  currentSeverityLevel         SeverityLevel?   
  currentLikelihoodLevel       LikelihoodLevel? 
  currentRiskRating            Int?             @db.Int
  proposedControl              String?          @db.VarChar(255)

  afterSeverityLevel            SeverityLevel?
  afterLikelihoodLevel          LikelihoodLevel?
  afterRiskRating               Int?             @db.Int
  
  // String to allow multi-select (e.g., "PHYSICAL, TECHNICAL")
  typeOfMeasure                String?          @db.VarChar(255) 
  
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt

  @@index ([piaAssessment_id])
  @@index ([dataSubject_id])
  @@index ([pdlc_id])
}

enum SeverityLevel {
    NEGLIGIBLE_1
    LIMITED_2
    SIGNIFICANT_3
    EXTREME_4
}

enum LikelihoodLevel {
    UNLIKELY_1
    POSSIBLE_2
    LIKELY_3
    ALMOST_CERTAIN_4
}

//***********************************************/
// --- D. SECURITY MEASURES TABLE --- //
model SecurityMeasures {
    id               Int           @id @default(autoincrement())
    
    // FK to PiaAssessment
    piaAssessment_id Int
    piaAssessment    PiaAssessment @relation(fields: [piaAssessment_id], references: [id], onDelete: Cascade)
    
    securityType     SecurityType
    description      String        @db.VarChar(255)
   
    createdAt        DateTime      @default(now())
    updatedAt        DateTime      @updatedAt

    @@index([piaAssessment_id])
}

enum SecurityType {
    TECHNICAL
    ORGANIZATIONAL
    PHYSICAL
}

// --- SESSION STORE --- //
model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}