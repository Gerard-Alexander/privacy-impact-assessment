<%- include('../layouts/head') %>
<main class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card shadow border-0">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="badge bg-primary fs-6 px-3 py-2 mb-3">SLU</div>
                    <h1 class="h4 mb-1">PIA System</h1>
                    <p class="text-muted mb-0">University of Saint Louis Portal</p>
                </div>

                <% if (typeof error !== 'undefined' && error === 'invalid') { %>
                <div class="alert alert-danger" role="alert">
                    Invalid username or password.
                </div>
                <% } %>

                <% if (typeof error !== 'undefined' && error === 'server') { %>
                <div class="alert alert-danger" role="alert">
                    Unable to process login right now. Please try again.
                </div>
                <% } %>
                <form action="/login" method="POST">
                  <div class="mb-3">
                  <label class="form-label">Username</label>
                  <input type="text" name="username" class="form-control" placeholder="Enter your username" required>
                  </div>
                  <div class="mb-4">
                      <label class="form-label">Password</label>
                      <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
                  </div>
                
                  <button type="submit" class="btn btn-primary w-100">
                      Sign In
                  </button>

                  <div class="d-flex justify-content-between mt-3 small">
                      <a href="/register-page" class="text-decoration-none">Create account</a>
                      <a href="#" class="text-decoration-none">Forgot password?</a>
                  </div>
                </form>
            </div>
        </div>
    </div>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>