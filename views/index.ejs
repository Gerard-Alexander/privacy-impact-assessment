<%- include('layouts/head', { title: title }) %>
<main class="container min-vh-100 d-flex align-items-center py-4">
    <section class="row w-100 g-4 align-items-center">
        <div class="col-12 col-lg-7">
            <div class="p-2 p-md-4">
                <span class="badge rounded-pill bg-primary px-3 py-2 mb-3">SLU Data Protection Office</span>
                <h1 class="display-6 fw-bold mb-3">Privacy Impact Assessment System</h1>
                <p class="lead text-muted mb-4">
                    Manage privacy assessments, data inventories, and risk controls in one secure workspace.
                    Sign in to continue to your profile and start your workflow.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/login-page" class="btn btn-primary btn-lg">Sign In</a>
                    <a href="/register-page" class="btn btn-outline-secondary btn-lg">Create Account</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3">Quick Access</h2>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0">Start and track assessment forms</li>
                        <li class="list-group-item px-0">Maintain personal data inventory records</li>
                        <li class="list-group-item px-0">Review risk and control documentation</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>