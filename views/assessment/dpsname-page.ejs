<%- include('../layouts/head', { title: title }) %>
	<div class="d-flex">
		<%- include('../layouts/sidebar', { activePage: activePage }) %>
		<div class="flex-grow-1">
		<%- include('../layouts/topbar', { title: title, user: user }) %>
			
			<main class="container-fluid py-4 px-4">
				<%- include('../layouts/stepper', { currentStep: 1 }) %>	
				<div class="mx-auto" style="max-width: 1000px;">

					<div class="card shadow-sm border-0 mb-4">
					<div class="card-header bg-primary text-white">
						<h5 class="mb-0">Section A — Data Processing System (DPS) Information</h5>
					</div>

					<div class="card-body">
						<form action="/assessment" method="POST">

						<!-- 70 / 30 Layout -->
						<div class="row g-4">

							<!-- LEFT COLUMN (70%) -->
							<div class="col-md-8">

							<!-- Name -->
							<div class="mb-3">
								<label class="form-label fw-bold">
								Name of Data Processing System (DPS):
								<span class="text-danger">*</span>
								</label>
								<input type="text" name="systemName" class="form-control form-control-sm"
								placeholder="e.g. Student Enrollment Management System" required>
							</div>

							<!-- Mandate -->
							<div class="mb-3">
								<label class="form-label fw-bold">
								Mandate / Purpose:
								<span class="text-danger">*</span>
								</label>
								<textarea name="mandate" class="form-control form-control-sm" rows="3"
								placeholder="Describe the mandate or purpose..." required></textarea>
							</div>

							<!-- Dates -->
							<div class="row g-3">
								<div class="col-md-6">
								<label class="form-label fw-bold">PIA Starting Date:</label>
								<input type="date" name="piaStartDate" class="form-control form-control-sm">
								</div>
								<div class="col-md-6">
								<label class="form-label fw-bold">PIA Ending Date:</label>
								<input type="date" name="piaEndDate" class="form-control form-control-sm">
								</div>
							</div>

							</div>

							<!-- RIGHT COLUMN (30%) -->
							<div class="col-md-4 d-flex flex-column gap-3">

							<!-- DPS Modality -->
							<div>
								<label class="form-label fw-bold">DPS Modality:</label>
								<select name="dpsModality" class="form-select form-select-sm">
								<option value="">Select...</option>
								<option value="ELECTRONIC">Electronic</option>
								<option value="MANUAL">Paper-based</option>
								<option value="BOTH">Both</option>
								</select>
							</div>

							<!-- Processing Role -->
							<div>
								<label class="form-label fw-bold">Processing Role / Entity:</label>
								<select name="processingRole" class="form-select form-select-sm">
								<option value="">Select...</option>
								<option value="PIC">Personal Information Controller (PIC)</option>
								<option value="PIP">Personal Information Processor (PIP)</option>
								</select>
							</div>

							<!-- Outsourced -->
							<div>
								<label class="form-label fw-bold">Outsourced/Subcontracted?</label>
								<div class="d-flex gap-3">
								<div class="form-check">
									<input class="form-check-input" type="radio" name="isOutsourced" value="1">
									<label class="form-check-label small">Yes</label>
								</div>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="isOutsourced" value="0" checked>
									<label class="form-check-label small">No</label>
								</div>
								</div>
							</div>

							</div>

						</div>

						<!-- Submit -->
						<div class="d-flex justify-content-end mt-4">
							<button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm">
							Save and Continue
							</button>
						</div>

						</form>
					</div>
					</div>

				</div>
			</main>
		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	</body>

	</html>