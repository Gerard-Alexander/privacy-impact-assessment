<%- include('../layouts/head', { title: title }) %>
	<div class="d-flex">
		<%- include('../layouts/sidebar', { activePage: activePage }) %>
		<div class="flex-grow-1 main-content-offset">
		<%- include('../layouts/topbar', { title: title, user: user }) %>		
			<main class="container-fluid py-4 px-4">
				<%- include('../layouts/stepper', { currentStep: 2, dpsTitle: 'Data Processing System', authParties: 'Authorized Parties', 
					user: user 
				}) %>
				<% if (error) { %>
					<div class="alert alert-danger mx-auto" style="max-width: 1000px;"><%= error %></div>
				<% } %>
				<% if (success) { %>
					<div class="alert alert-success mx-auto" style="max-width: 1000px;"><%= success %></div>
				<% } %>

				<!-- Privacy Notice Hover Tooltip -->
				<div class="text-start mb-3 mx-3">
					<small class="text-muted">
						Agree to our
						<a href="#" class="text-success text-decoration-none fw-semibold"
							data-bs-toggle="modal" data-bs-target="#privacyModal">
							Privacy Notice
						</a>
					</small>
				</div>

				<div class="modal fade" id="privacyModal" tabindex="-1">
					<div class="modal-dialog modal-lg modal-dialog-centered">
						<div class="modal-content">

							<div class="modal-header bg-info text-white py-2">
								<h6 class="mb-0">Privacy Notice</h6>
								<button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
							</div>

							<div class="modal-body" style="max-height:60vh;overflow:auto">
								<p class="mb-0">
									By submitting this privacy impact assessment, I hereby give my consent to USLT for the collection, processing, and storage of my personal information. This information will be used solely for legitimate educational, research, and institutional purposes, in accordance with University policies and the Republic Act No. 10173, also known as the Data Privacy Act of 2012. I understand that my personal data will be kept confidential and will not be disclosed with unauthorized parties, except as required by law, court order, or with my explicit consent. I acknowledge my rights under the Data Privacy Act, including the right to access, correct, and request the deletion of my personal data, subject to applicable regulations.
								</p>
							</div>

							<div class="modal-footer py-2">
								<button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
							</div>

						</div>
					</div>
				</div>

				<div class="mx-auto" style="max-width: 1000px;">
					<% const formData = authorizedPartiesData || {}; %>
					<form id="authorizedForm" action="/assessment/authorizedparties" method="POST">
						<input type="hidden" name="piaAssessment_id" value="<%= piaAssessmentId %>">
						<div class="card shadow-sm border-0 mb-4">

						<!-- Header -->
						<div class="card-header text-white" style="background-color: #0f235d;">
							<h5 class="mb-0">Section B - Authorized Parties</h5>
						</div>

						<!-- Sub-header -->
						<div class="card-body text-black shadow-sm" style="background-color: #c8ddf7;">
							<div class="row text-center align-items-center">
								<div class="col-md-6 border-end border-secondary">
									<h6 class="mb-0">Head Office / Process Owner</h6>
								</div>
								<div class="col-md-6">
									<h6 class="mb-0">Compliance Officer for Privacy (PIP)</h6>
								</div>						
							</div>
						</div>

						<!-- Form Body -->
						<div class="card-body bg-white">
							<div class="row">
								<!-- LEFT COLUMN -->
								<div class="col-md-6 mb-4 border-end border-secondary pe-4">
									<!-- Name -->
									<div class="d-flex gap-3 mb-3">
										<div class="w-100">
											<label class="form-label">First Name</label>
											<input type="text" name="headFirstName" class="form-control" required value="<%= formData.headFirstName || '' %>">
										</div>
										<div class="w-100">
											<label class="form-label">Last Name</label>
											<input type="text" name="headLastName" class="form-control" required value="<%= formData.headLastName || '' %>">
										</div>
									</div>
									<!-- Position -->
									<div class="mb-3">
										<label class="form-label">Position</label>
										<input type="text" name="headPosition" class="form-control" required value="<%= formData.headPosition || '' %>">
									</div>
									<!-- Office -->
									<div class="mb-3">
										<label class="form-label">Office / Unit</label>
										<input type="text" name="headOfficeUnit" class="form-control" required value="<%= formData.headOfficeUnit || '' %>">
									</div>
									<!-- Signature Text -->
									<div class="mb-3">
										<label class="form-label">Signature</label>
										<input type="text" name="headSignature" class="form-control" required value="<%= formData.headSignature || '' %>">
									</div>
									<!-- Upload Box -->
									<div class="mb-3">
										<label class="form-label">Signature (upload image)</label>
										<label class="border border-2 border-dashed rounded p-4 text-center w-100 bg-light position-relative" style="cursor: pointer;">
											<input type="file" class="d-none"
														name="head_signaturePath"
														accept="image/*"
														onchange="previewSig(this,'head-preview')">
											<div class="text-muted">
												<i class="bi bi-cloud-upload fs-3 d-block mb-2"></i>
												<span class="fw-semibold">Click to upload</span><br>
												<small>PNG, JPG allowed</small>
											</div>
											<img id="head-preview" class="img-fluid mt-3 rounded d-none">
										</label>
									</div>
									<!-- Date -->
									<div>
										<label class="form-label fw-bold">Date Signed:</label>
										<input type="date" name="headDateSigned" class="form-control form-control-sm" value="<%= formData.headDateSigned || '' %>">
									</div>
								</div>

								<!-- RIGHT COLUMN -->
								<div class="col-md-6 mb-4 ps-4">
									<!-- Name -->
									<div class="d-flex gap-3 mb-3">
										<div class="w-100">
											<label class="form-label">First Name</label>
											<input type="text" name="compName" class="form-control" required value="<%= formData.compName || '' %>">
										</div>
										<div class="w-100">
											<label class="form-label">Last Name</label>
											<input type="text" name="compLastName" class="form-control" required value="<%= formData.compLastName || '' %>">
										</div>
									</div>
									<!-- Position -->
									<div class="mb-3">
										<label class="form-label">Position</label>
										<input type="text" name="compPosition" class="form-control" required value="<%= formData.compPosition || '' %>">
									</div>
									<!-- Email -->
									<div class="mb-3">
										<label class="form-label">Email</label>
										<input type="email" name="compEmail" class="form-control" required value="<%= formData.compEmail || '' %>">
									</div>
									<!-- Signature Text -->
									<div class="mb-3">
										<label class="form-label">Signature</label>
										<input type="text" name="compSignature" class="form-control" required value="<%= formData.compSignature || '' %>">
									</div>
									<!-- Upload Box -->
									<div class="mb-3">
										<label class="form-label">Signature (upload image)</label>
										<label class="border border-2 border-dashed rounded p-4 text-center w-100 bg-light position-relative" style="cursor: pointer;">
											<input type="file" class="d-none"
														name="compsignaturePath"
														accept="image/*"
														onchange="previewSig(this,'comp-preview')">
											<div class="text-muted">
												<i class="bi bi-cloud-upload fs-3 d-block mb-2"></i>
												<span class="fw-semibold">Click to upload</span><br>
												<small>PNG, JPG allowed</small>
											</div>
											<img id="comp-preview" class="img-fluid mt-3 rounded d-none">
										</label>
									</div>
									<!-- Date -->
									<div>
										<label class="form-label fw-bold">Date Signed:</label>
										<input type="date" name="compDateSigned" class="form-control form-control-sm" value="<%= formData.compDateSigned || '' %>">
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="card shadow-sm border-0 mb-4">

						<!-- Sub-header -->
						<div class="card-body text-black shadow-sm" style="background-color: #c8ddf7;">
							<div class="row text-center align-items-center">
								<div class="col-md-6 border-end border-secondary">
									<h6 class="mb-0">Reviewed By</h6>
								</div>
								<div class="col-md-6">
									<h6 class="mb-0">Approved By</h6>
								</div>						
							</div>
						</div>

						<!-- Form Body -->
						<div class="card-body bg-white">
							<div class="row">
								<!-- LEFT COLUMN -->
								<div class="col-md-6 mb-4 border-end border-secondary pe-4">
									<!-- Name -->
									<div class="d-flex gap-3 mb-3">
										<div class="w-100">
											<label class="form-label">First Name</label>
											<input type="text" name="reviewFirstName" class="form-control" required value="<%= formData.reviewFirstName || '' %>">
										</div>
										<div class="w-100">
											<label class="form-label">Last Name</label>
											<input type="text" name="reviewLastName" class="form-control" required value="<%= formData.reviewLastName || '' %>">
										</div>
									</div>
									<!-- Position -->
									<div class="mb-3">
										<label class="form-label">Position</label>
										<input type="text" name="reviewPosition" class="form-control" required value="<%= formData.reviewPosition || '' %>">
									</div>
									<!-- Signature Text -->
									<div class="mb-3">
										<label class="form-label">Signature</label>
										<input type="text" name="reviewSignature" class="form-control" required value="<%= formData.reviewSignature || '' %>">
									</div>
									<!-- Upload Box -->
									<div class="mb-3">
										<label class="form-label">Signature (upload image)</label>
										<label class="border border-2 border-dashed rounded p-4 text-center w-100 bg-light position-relative" style="cursor: pointer;">
											<input type="file" class="d-none"
														name="head_signaturePath"
														accept="image/*"
														onchange="previewSig(this,'head-preview')">
											<div class="text-muted">
												<i class="bi bi-cloud-upload fs-3 d-block mb-2"></i>
												<span class="fw-semibold">Click to upload</span><br>
												<small>PNG, JPG allowed</small>
											</div>
											<img id="head-preview" class="img-fluid mt-3 rounded d-none">
										</label>
									</div>
									<!-- Date -->
									<div>
										<label class="form-label fw-bold">Date Signed:</label>
										<input type="date" name="reviewDateSigned" class="form-control form-control-sm" value="<%= formData.reviewDateSigned || '' %>">
									</div>
								</div>

								<!-- RIGHT COLUMN -->
								<div class="col-md-6 mb-4 ps-4">
									<!-- Name -->
									<div class="d-flex gap-3 mb-3">
										<div class="w-100">
											<label class="form-label">First Name</label>
											<input type="text" name="approveFirstName" class="form-control" required value="<%= formData.approveFirstName || '' %>">
										</div>
										<div class="w-100">
											<label class="form-label">Last Name</label>
											<input type="text" name="approveLastName" class="form-control" required value="<%= formData.approveLastName || '' %>">
										</div>
									</div>
									<!-- Position -->
									<div class="mb-3">
										<label class="form-label">Position</label>
										<input type="text" name="approvePosition" class="form-control" required value="<%= formData.approvePosition || '' %>">
									</div>
									<!-- Signature Text -->
									<div class="mb-3">
										<label class="form-label">Signature</label>
										<input type="text" name="approveSignature" class="form-control" required value="<%= formData.approveSignature || '' %>">
									</div>
									<!-- Upload Box -->
									<div class="mb-3">
										<label class="form-label">Signature (upload image)</label>
										<label class="border border-2 border-dashed rounded p-4 text-center w-100 bg-light position-relative" style="cursor: pointer;">
											<input type="file" class="d-none"
														name="compsignaturePath"
														accept="image/*"
														onchange="previewSig(this,'comp-preview')">
											<div class="text-muted">
												<i class="bi bi-cloud-upload fs-3 d-block mb-2"></i>
												<span class="fw-semibold">Click to upload</span><br>
												<small>PNG, JPG allowed</small>
											</div>
											<img id="comp-preview" class="img-fluid mt-3 rounded d-none">
										</label>
									</div>
									<!-- Date -->
									<div>
										<label class="form-label fw-bold">Date Signed:</label>
										<input type="date" name="approveDateSigned" class="form-control form-control-sm" value="<%= formData.approveDateSigned || '' %>">
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Footer Buttons -->
					</form>
					<div class="d-flex justify-content-between align-items-center mt-4">
						<a href="/assessment?id=<%= piaAssessmentId %>" class="btn btn-danger btn-sm px-4 shadow-sm">
							Previous Page
						</a>
						<div>2 of 5</div>
						<button type="submit" form="authorizedForm" class="btn btn-primary btn-sm px-4 shadow-sm">
							Next Page
						</button>
					</div>
				</div>
      </main>
    </div>
  </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
