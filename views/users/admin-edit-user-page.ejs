<%- include('../layouts/head', { title: title }) %>

<div class="d-flex">
  <!-- SIDEBAR -->
  <%- include('../layouts/sidebar', { activePage: 'manage-users' }) %>
  
  <!-- MAIN AREA -->
  <div class="flex-grow-1 main-content-offset">
    <!-- TOPBAR -->
    <%- include('../layouts/topbar', { title: title, user: user }) %>

    <!-- PAGE CONTENT -->
    <main class="container-fluid py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom border-light">
                        <h5 class="fw-bold mb-0 text-primary">Admin: Edit User Account</h5>
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 small fw-bold">
                            Account ID: #<%= targetUser.id %>
                        </span>
                    </div>
                    <div class="card-body p-4">
                        <form action="/user-profile/manage-users/edit/<%= targetUser.id %>" method="POST">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">First Name</label>
                                    <input type="text" name="firstName" class="form-control rounded-3" value="<%= targetUser.firstName %>" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Last Name</label>
                                    <input type="text" name="lastName" class="form-control rounded-3" value="<%= targetUser.lastName %>" required>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Email Address</label>
                                    <input type="email" name="emailAddress" class="form-control rounded-3" value="<%= targetUser.emailAddress %>" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Username</label>
                                    <input type="text" name="userName" class="form-control rounded-3" value="<%= targetUser.userName %>" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">System Role</label>
                                    <select name="role" class="form-select rounded-3">
                                        <option value="USER" <%= targetUser.role === 'USER' ? 'selected' : '' %>>USER</option>
                                        <option value="ADMIN" <%= targetUser.role === 'ADMIN' ? 'selected' : '' %>>ADMIN</option>
                                        <option value="REVIEWER" <%= targetUser.role === 'REVIEWER' ? 'selected' : '' %>>REVIEWER</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <hr class="my-4 border-light">
                                    <h6 class="fw-bold text-dark mb-3">Security</h6>
                                    <label class="form-label small fw-bold text-muted text-uppercase">Reset Password</label>
                                    <input type="password" name="password" class="form-control rounded-3" placeholder="Leave blank to keep current password">
                                    <small class="text-muted">Minimum 6 characters for a new password.</small>
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-5 pt-3 border-top border-light">
                                <button type="submit" class="btn btn-primary px-5 rounded-pill fw-bold">Update Account</button>
                                <a href="/user-profile/manage-users" class="btn btn-outline-secondary px-4 rounded-pill fw-bold">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </main>
  </div>
</div>

<style>
    .main-content-offset {
        background-color: #f1f5f9;
        min-height: 100vh;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
