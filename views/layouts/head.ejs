<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'PIA System | SLU' %></title>
  <meta name="description" content="Saint Louis University - Data Protection Office Privacy Impact Assessment System">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">

<style>
  :root {
    --sidebar-width: 220px;
    --topbar-height: 68px;
  }

  html {
    font-size: 85%;
  }

  /* Fixed Sidebar */
  .fixed-sidebar {
    position: fixed !important;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--sidebar-width);
    z-index: 1030;
    overflow-y: auto;
  }

  /* Fixed Topbar */
  .fixed-topbar {
    position: fixed !important;
    top: 0;
    left: var(--sidebar-width);
    right: 0;
    z-index: 1040;
    border-radius: 0 !important;
  }

  /* Main content offset */
  .main-content-offset {
    margin-left: var(--sidebar-width);
    padding-top: var(--topbar-height);
  }

  /* Mobile adjustments */
  @media (max-width: 991.98px) {
    .fixed-topbar {
      left: 0 !important;
    }
    .main-content-offset {
      margin-left: 0 !important;
    }
  }

  /* Backdrop for sidebar on mobile if needed */
  body.sidebar-open {
    overflow: hidden;
  }
</style>
 <script>
   
    (function () {
      document.addEventListener('contextmenu', function (event) {
        event.preventDefault();
      });

      document.addEventListener('keydown', function (event) {
        const key = event.key ? event.key.toLowerCase() : '';
        const ctrlShiftCombo = event.ctrlKey && event.shiftKey && ['i', 'j', 'c'].includes(key);
        if (event.key === 'F12' || ctrlShiftCombo || (event.ctrlKey && key === 'u')) {
          event.preventDefault();
          event.stopPropagation();
        }
      });

      document.addEventListener('selectstart', function (event) {
        event.preventDefault();
      });
    })();
    window.history.replaceState(null, '', '/');
  </script>
</head>
<body class="bg-body-tertiary">

