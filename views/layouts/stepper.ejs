<style>
  .custom-stepper {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
    position: relative;
  }
  .custom-stepper::before {
    content: '';
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    height: 4px;
    background: #e9ecef;
    z-index: 0;
    border-radius: 4px;
  }
  .custom-step-item {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
  }
  .custom-step-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #e9ecef;
    color: #6c757d;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1rem;
    margin-bottom: 0.5rem;
    transition: all 0.3s ease;
    border: 3px solid #fff;
    box-shadow: 0 0 0 2px transparent;
  }
  .custom-step-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: #6c757d;
    max-width: 120px;
  }
  
  /* Active Step */
  .custom-step-item.active .custom-step-circle {
    background: #0d6efd;
    color: #fff;
    box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25);
  }
  .custom-step-item.active .custom-step-label {
    color: #0d6efd;
  }
  
  /* Done Step */
  .custom-step-item.done .custom-step-circle {
    background: #198754;
    color: #fff;
  }
  .custom-step-item.done .custom-step-label {
    color: #198754;
  }
</style>

<div class="custom-stepper px-3">
  <% const processDataLabel = typeof processDataCycle !== 'undefined' ? processDataCycle : 'Process Data LifeCycle'; %>
    <% const steps = [
    { title: dpsTitle, user: user },
    { title: authParties, user: user },
  	{ title: processDataLabel, user: user },
    { title: 'Information Inventory' },
    { title: 'Threats & Controls' },
    { title: 'Security Measures' }
    ]; %>
    <% steps.forEach((step, i) => {
    const stepNum = i + 1;
    const isDone = currentStep > stepNum;
    const isActive = currentStep === stepNum;
    const cls = isDone ? 'done' : (isActive ? 'active' : '');
    %>
    <div class="custom-step-item <%= cls %>">
        <div class="custom-step-circle"><%= isDone ? '✓' : stepNum %></div>
        <div class="custom-step-label"><%= step.title %></div>
    </div>
    <% }) %>
</div>
