<%- include('../layouts/head', { title: title }) %>
	<div class="d-flex">
		<%- include('../layouts/sidebar', { activePage: activePage }) %>
		<div class="flex-grow-1 main-content-offset">
		<%- include('../layouts/topbar', { title: title, user: user }) %>

			
			<main class="container-fluid py-4 px-4">
				<%- include('../layouts/stepper', { currentStep: 1, 
					dpsTitle: 'Data Processing System', authParties: 'Authorized Parties', 
					user: user 
				}) %>
				<div class="mx-auto" style="max-width: 1000px;">

					<style>
					/* Modern UI Enhancements */
					.form-floating > .form-control:focus ~ label,
					.form-floating > .form-control:not(:placeholder-shown) ~ label,
					.form-floating > .form-select ~ label {
						color: var(--bs-primary);
						font-weight: 600;
					}
					.form-control, .form-select {
						border-radius: 0.5rem;
						border: 1px solid #dee2e6;
						padding: 0.75rem 1rem;
						transition: all 0.2s ease-in-out;
					}
					.form-control:focus, .form-select:focus {
						border-color: var(--bs-primary);
						box-shadow: 0 0 0 0.25rem rgba(13, 27, 75, 0.1);
					}
					.custom-card {
						border-radius: 1rem;
						background: #ffffff;
						box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
						overflow: hidden;
						animation: fadeIn 0.5s ease-out;
					}
					.custom-header {
						background: linear-gradient(135deg, rgba(13, 27, 75, 0.05) 0%, transparent 100%);
						border-bottom: 2px solid rgba(13, 27, 75, 0.1);
						padding: 1.5rem 2rem;
					}
					.custom-header-title {
						color: #0d1b4b;
						font-weight: 700;
						letter-spacing: -0.5px;
					}
					.btn-modern {
						border-radius: 0.5rem;
						padding: 0.6rem 1.5rem;
						font-weight: 600;
						transition: all 0.3s ease;
						display: inline-flex;
						align-items: center;
						gap: 0.5rem;
					}
					.btn-modern:hover {
						transform: translateY(-2px);
						box-shadow: 0 5px 15px rgba(13, 27, 75, 0.2);
					}
					.modern-radio-group .btn-outline-primary {
						border-color: #dee2e6;
						color: #6c757d;
					}
					.modern-radio-group .btn-check:checked + .btn-outline-primary {
						background-color: rgba(13, 27, 75, 0.1);
						border-color: #0d1b4b;
						color: #0d1b4b;
						font-weight: 600;
					}
					@keyframes fadeIn {
						from { opacity: 0; transform: translateY(10px); }
						to { opacity: 1; transform: translateY(0); }
					}
					.form-section {
						padding: 2rem;
					}

					/* Share Modal Styles */
					.share-user-item {
						border: 1.5px solid #e9ecef;
						border-radius: 0.6rem;
						padding: 0.65rem 0.9rem;
						cursor: pointer;
						transition: all 0.18s ease;
						user-select: none;
					}
					.share-user-item:hover {
						border-color: #0d1b4b;
						background: rgba(13, 27, 75, 0.04);
					}
					.share-user-item.selected {
						border-color: #0d1b4b;
						background: rgba(13, 27, 75, 0.07);
					}
					.share-user-item .user-check {
						width: 20px;
						height: 20px;
						border-radius: 50%;
						border: 2px solid #ced4da;
						display: flex;
						align-items: center;
						justify-content: center;
						transition: all 0.18s ease;
						flex-shrink: 0;
					}
					.share-user-item.selected .user-check {
						background: #0d1b4b;
						border-color: #0d1b4b;
						color: white;
					}
					.shared-badge {
						display: inline-flex;
						align-items: center;
						gap: 0.3rem;
						background: rgba(13, 27, 75, 0.07);
						border: 1px solid rgba(13, 27, 75, 0.18);
						border-radius: 2rem;
						padding: 0.2rem 0.65rem;
						font-size: 0.75rem;
						font-weight: 500;
						color: #0d1b4b;
					}
					.shared-badge img {
						width: 18px;
						height: 18px;
						border-radius: 50%;
						background: #0d1b4b;
						object-fit: cover;
					}
					.avatar-initials {
						width: 32px;
						height: 32px;
						border-radius: 50%;
						background: linear-gradient(135deg, #0d1b4b, #2d4e8a);
						color: white;
						font-size: 0.7rem;
						font-weight: 700;
						display: flex;
						align-items: center;
						justify-content: center;
						flex-shrink: 0;
					}
					#shareUserSearch {
						border-radius: 0.5rem;
					}
					.share-users-list {
						max-height: 320px;
						overflow-y: auto;
						scrollbar-width: thin;
					}
					</style>

					<div class="card border-0 custom-card mb-4">
						<div class="custom-header d-flex align-items-center justify-content-between flex-wrap gap-2">
							<div class="d-flex align-items-center gap-3">
								<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; flex-shrink:0;">
									<i class="bi bi-info-circle-fill fs-5"></i>
								</div>
								<div>
									<h5 class="mb-0 custom-header-title">Section A — Data Processing System (DPS) Information</h5>
									<small class="text-muted">Please provide the initial details of the system being assessed.</small>
								</div>
							</div>

							<!-- Share Button — always visible, disabled on brand-new unsaved assessments -->
							<div class="d-flex align-items-center gap-2 flex-wrap">
								<% if (sharedUsers && sharedUsers.length > 0) { %>
								<div class="d-flex align-items-center gap-1 flex-wrap" id="sharedWithBadges">
									<small class="text-muted me-1">Shared with:</small>
									<% sharedUsers.slice(0, 3).forEach(u => { %>
									<span class="shared-badge" title="<%= u.emailAddress %>">
										<span style="width:16px;height:16px;border-radius:50%;background:#0d1b4b;color:white;font-size:0.6rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;">
											<%= (u.firstName[0] + u.lastName[0]).toUpperCase() %>
										</span>
										<%= u.firstName %> <%= u.lastName %>
									</span>
									<% }) %>
									<% if (sharedUsers.length > 3) { %>
									<span class="shared-badge">+<%= sharedUsers.length - 3 %> more</span>
									<% } %>
								</div>
								<% } else { %>
								<div id="sharedWithBadges"></div>
								<% } %>
								<% if (piaAssessmentId) { %>
								<button type="button" class="btn btn-outline-primary btn-modern btn-sm" id="shareBtn"
									data-assessment-id="<%= piaAssessmentId %>"
									data-bs-toggle="modal" data-bs-target="#shareModal">
									<i class="bi bi-share-fill"></i> Share
								</button>
								<% } else { %>
								<button type="button" class="btn btn-outline-secondary btn-modern btn-sm" id="shareBtn"
									disabled title="Save the assessment first to enable sharing">
									<i class="bi bi-share-fill"></i> Share
								</button>
								<% } %>
							</div>
						</div>

						<div class="card-body form-section">
							<form action="/assessment/dpsname" method="POST">
								<input type="hidden" name="piaAssessmentId" value="<%= piaAssessmentId || '' %>">
								<% const selectedAssessment = assessment || {}; %>
								<% if (error) { %>
									<div class="alert alert-danger mb-4 rounded-3 shadow-sm" role="alert">
										<i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
									</div>
								<% } %>
								<% if (success) { %>
									<div class="alert alert-success mb-4 rounded-3 shadow-sm" role="alert">
										<i class="bi bi-check-circle-fill me-2"></i><%= success %>
									</div>
								<% } %>
								
								<div class="row g-4">
									<!-- LEFT COLUMN -->
									<div class="col-lg-7">
										<!-- Name -->
										<div class="form-floating mb-4">
											<input type="text" id="systemName" name="systemName" class="form-control"
											placeholder="e.g. Student Enrollment Management System" value="<%= selectedAssessment.dpsName || '' %>" required>
											<label for="systemName">Name of Data Processing System (DPS) <span class="text-danger">*</span></label>
										</div>

										<!-- Mandate -->
										<div class="form-floating mb-4">
											<textarea id="mandate" name="mandate" class="form-control" style="height: 120px;"
											placeholder="Describe the mandate or purpose..." required><%= selectedAssessment.mandate || '' %></textarea>
											<label for="mandate">Mandate / Purpose <span class="text-danger">*</span></label>
										</div>

										<!-- Dates -->
										<div class="row g-3 mb-4">
											<div class="col-md-6">
												<div class="form-floating">
													<input type="date" id="piaStartDate" name="piaStartDate" class="form-control" value="<%= selectedAssessment.piaStartDate || '' %>" required>
													<label for="piaStartDate">PIA Starting Date <span class="text-danger">*</span></label>
												</div>
											</div>
											<div class="col-md-6">
												<div class="form-floating">
													<input type="date" id="piaEndDate" name="piaEndDate" class="form-control" value="<%= selectedAssessment.piaEndDate || '' %>" required>
													<label for="piaEndDate">PIA Ending Date <span class="text-danger">*</span></label>
												</div>
											</div>
										</div>
									</div>

									<!-- RIGHT COLUMN -->
									<div class="col-lg-5">
										<div class="p-4 bg-light rounded-4 border h-100 d-flex flex-column gap-4">
											<!-- DPS Modality -->
											<div>
												<label class="form-label fw-semibold text-dark mb-2">
													<i class="bi bi-display me-2 text-primary"></i>DPS Modality
												</label>
												<select name="dpsModality" class="form-select form-select-lg fs-6">
													<option value="" <%= !selectedAssessment.dpsModality ? 'selected' : '' %>>Select modality...</option>
													<option value="ELECTRONIC" <%= selectedAssessment.dpsModality === 'ELECTRONIC' ? 'selected' : '' %>>Electronic</option>
													<option value="MANUAL" <%= selectedAssessment.dpsModality === 'MANUAL' ? 'selected' : '' %>>Paper-based</option>
													<option value="BOTH" <%= selectedAssessment.dpsModality === 'BOTH' ? 'selected' : '' %>>Both</option>
												</select>
											</div>

											<!-- Processing Role -->
											<div>
												<label class="form-label fw-semibold text-dark mb-2">
													<i class="bi bi-person-badge me-2 text-primary"></i>Processing Role / Entity
												</label>
												<select name="processingRole" class="form-select form-select-lg fs-6">
													<option value="" <%= !selectedAssessment.processingRole ? 'selected' : '' %>>Select role...</option>
													<option value="PIC" <%= selectedAssessment.processingRole === 'PIC' ? 'selected' : '' %>>Personal Information Controller (PIC)</option>
													<option value="PIP" <%= selectedAssessment.processingRole === 'PIP' ? 'selected' : '' %>>Personal Information Processor (PIP)</option>
												</select>
											</div>

											<!-- Outsourced -->
											<div>
												<label class="form-label fw-semibold text-dark mb-2">
													<i class="bi bi-building-gear me-2 text-primary"></i>Outsourced / Subcontracted?
												</label>
												<div class="d-flex gap-2 modern-radio-group w-100">
													<input type="radio" class="btn-check" name="isOutsourced" id="outsourcedYes" value="1" <%= selectedAssessment.isOutsourced === '1' ? 'checked' : '' %>>
													<label class="btn btn-outline-primary flex-fill" for="outsourcedYes">Yes</label>

													<input type="radio" class="btn-check" name="isOutsourced" id="outsourcedNo" value="0" <%= selectedAssessment.isOutsourced === '1' ? '' : 'checked' %>>
													<label class="btn btn-outline-primary flex-fill" for="outsourcedNo">No</label>
												</div>
											</div>
										</div>
									</div>
								</div>

								<!-- Submit -->
								<hr class="my-4 text-muted">
								<div class="d-flex align-items-center justify-content-between mt-2">
									<span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill fw-medium">Step 1 of 7</span>
									<button type="submit" class="btn btn-primary btn-modern shadow-sm">
										Save and Continue <i class="bi bi-arrow-right-short fs-5"></i>
									</button>
								</div>
							</form>
						</div>
					</div>
				</div>
			</main>
		</div>
	</div>

<!-- ===== SHARE MODAL ===== -->
<div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="shareModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 480px;">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 1rem; overflow: hidden;">
      <div class="modal-header border-0 pb-0" style="background: linear-gradient(135deg, #0d1b4b 0%, #1a3a6b 100%); color: white; padding: 1.4rem 1.6rem;">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-share-fill fs-5"></i>
          <h6 class="modal-title fw-bold mb-0" id="shareModalLabel">Share Assessment</h6>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body px-4 pt-3 pb-2">
        <p class="text-muted small mb-3">Select users to grant edit access to this assessment. Only selected users and you (the creator) can edit it.</p>

        <!-- Search -->
        <div class="input-group mb-3">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" id="shareUserSearch" class="form-control border-start-0 ps-0"
            placeholder="Search users…" autocomplete="off">
        </div>

        <!-- User List -->
        <div class="share-users-list" id="shareUsersList">
          <div class="text-center py-4 text-muted" id="shareUsersLoading">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading users…
          </div>
        </div>

        <div id="shareNoResults" class="text-center py-3 text-muted small d-none">No users match your search.</div>
      </div>

      <div class="modal-footer border-0 pt-1 px-4 pb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span class="text-muted small" id="shareSelectedCount">0 user(s) selected</span>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-light btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold" id="shareSaveBtn">
            <i class="bi bi-check-lg me-1"></i>Save Access
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Share toast notification -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
  <div id="shareToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive"
       style="min-width: 280px; border-radius: 0.75rem;">
    <div class="d-flex">
      <div class="toast-body fw-medium" id="shareToastMsg">Saved.</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- Server-rendered share data (read by the IIFE below) -->
<script id="shareInitData" type="application/json">
  {"assessmentId": "<%- piaAssessmentId || '' %>", "sharedUserIds": <%- JSON.stringify(sharedUserIds || []) %>}
</script>
<script>
(function () {
  const _init = JSON.parse(document.getElementById('shareInitData').textContent);
  const assessmentId = _init.assessmentId;
  if (!assessmentId) return; // No share functionality on new assessment

  let selectedUserIds = new Set(_init.sharedUserIds);
  let allUsersData = [];

  const modal = document.getElementById('shareModal');
  const listEl = document.getElementById('shareUsersList');
  const loadingEl = document.getElementById('shareUsersLoading');
  const searchEl = document.getElementById('shareUserSearch');
  const countEl = document.getElementById('shareSelectedCount');
  const noResultsEl = document.getElementById('shareNoResults');
  const saveBtn = document.getElementById('shareSaveBtn');
  const toast = new bootstrap.Toast(document.getElementById('shareToast'), { delay: 3500 });

  function getInitials(first, last) {
    return ((first[0] || '') + (last[0] || '')).toUpperCase();
  }

  function updateCount() {
    countEl.textContent = `${selectedUserIds.size} user(s) selected`;
  }

  function renderUsers(users) {
    if (users.length === 0) {
      listEl.innerHTML = '';
      noResultsEl.classList.remove('d-none');
      return;
    }
    noResultsEl.classList.add('d-none');
    listEl.innerHTML = users.map(u => {
      const isSelected = selectedUserIds.has(u.id);
      return `
        <div class="share-user-item d-flex align-items-center gap-3 mb-2 ${isSelected ? 'selected' : ''}"
             data-user-id="${u.id}" role="button">
          <div class="avatar-initials">${getInitials(u.firstName, u.lastName)}</div>
          <div class="flex-grow-1 overflow-hidden">
            <div class="fw-semibold text-dark text-truncate" style="font-size:0.875rem;">${u.firstName} ${u.lastName}</div>
            <div class="text-muted text-truncate" style="font-size:0.75rem;">${u.emailAddress}</div>
          </div>
          <div class="user-check">
            ${isSelected ? '<i class="bi bi-check2" style="font-size:0.75rem;"></i>' : ''}
          </div>
        </div>`;
    }).join('');

    // Attach click events
    listEl.querySelectorAll('.share-user-item').forEach(item => {
      item.addEventListener('click', () => {
        const uid = parseInt(item.dataset.userId, 10);
        if (selectedUserIds.has(uid)) {
          selectedUserIds.delete(uid);
          item.classList.remove('selected');
          item.querySelector('.user-check').innerHTML = '';
        } else {
          selectedUserIds.add(uid);
          item.classList.add('selected');
          item.querySelector('.user-check').innerHTML = '<i class="bi bi-check2" style="font-size:0.75rem;"></i>';
        }
        updateCount();
      });
    });
  }

  function filterUsers(query) {
    const q = query.toLowerCase().trim();
    const filtered = q
      ? allUsersData.filter(u =>
          `${u.firstName} ${u.lastName}`.toLowerCase().includes(q) ||
          u.emailAddress.toLowerCase().includes(q) ||
          u.userName.toLowerCase().includes(q))
      : allUsersData;
    renderUsers(filtered);
  }

  // Load users when modal opens
  modal.addEventListener('show.bs.modal', async () => {
    loadingEl.style.display = '';
    listEl.innerHTML = '';
    searchEl.value = '';
    try {
      const res = await fetch(`/assessment/share/users?piaAssessmentId=${assessmentId}`);
      const data = await res.json();
      if (data.success) {
        allUsersData = data.allUsers;
        selectedUserIds = new Set(data.sharedUserIds);
        loadingEl.style.display = 'none';
        renderUsers(allUsersData);
        updateCount();
      }
    } catch (e) {
      loadingEl.innerHTML = '<span class="text-danger">Failed to load users.</span>';
    }
  });

  // Live search
  searchEl.addEventListener('input', () => filterUsers(searchEl.value));

  // Save
  saveBtn.addEventListener('click', async () => {
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';

    const payload = {
      piaAssessmentId: assessmentId,
      userIds: Array.from(selectedUserIds)
    };

    try {
      const res = await fetch('/assessment/share', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      const toastEl = document.getElementById('shareToast');
      const toastMsg = document.getElementById('shareToastMsg');

      if (data.success) {
        toastEl.style.background = '#198754';
        toastMsg.textContent = data.message;

        // Refresh the shared badges in header
        updateSharedBadges(data.sharedUsers);

        bootstrap.Modal.getInstance(document.getElementById('shareModal')).hide();
      } else {
        toastEl.style.background = '#dc3545';
        toastMsg.textContent = data.message || 'Failed to save.';
      }
      toast.show();
    } catch (e) {
      console.error(e);
    } finally {
      saveBtn.disabled = false;
      saveBtn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Save Access';
    }
  });

  function updateSharedBadges(users) {
    const container = document.getElementById('sharedWithBadges');
    if (!container) return;

    if (!users || users.length === 0) {
      container.innerHTML = '';
      return;
    }

    const displayed = users.slice(0, 3);
    const rest = users.length - displayed.length;

    container.innerHTML =
      '<small class="text-muted me-1">Shared with:</small>' +
      displayed.map(u => `
        <span class="shared-badge" title="${u.emailAddress}">
          <span style="width:16px;height:16px;border-radius:50%;background:#0d1b4b;color:white;font-size:0.6rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;">
            ${getInitials(u.firstName, u.lastName)}
          </span>
          ${u.firstName} ${u.lastName}
        </span>`).join('') +
      (rest > 0 ? `<span class="shared-badge">+${rest} more</span>` : '');
  }

  updateCount();
})();
</script>
</body>
</html>