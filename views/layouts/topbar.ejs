<header class="card border-0 shadow-sm mb-4 w-100">
    <!-- Top Navigation Links -->
    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 w-100">
        
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center">
                <img src="/images/slu-logo.svg" alt="University of Saint Louis logo" class="img-fluid" style="max-height: 48px; width: auto;">
            </div>
            <div class="text-center align-items-center">
                <h1 class="h5 mb-1"><%= typeof title !== 'undefined' ? title : 'PIA System' %></h1>
            </div>
        </div>
        <!-- Nav Links -->
        <div class="text-center align-items-center">
            <a href="#" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : 'text-black' %>">Dashboard</a>
        </div>
        <div class="text-center align-items-center">
            <a href="#" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : 'text-black' %>">Create Assesment</a>
        </div>
        <div class="text-center align-items-center">
            <a href="#" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : 'text-black' %>">Reports</a>
        </div>

        <!-- User Dropdown -->
        <div class="dropdown ms-3">
        <button 
            class="btn d-flex align-items-center gap-2 px-3 py-2 border-0 bg-white text-secondary"
            data-bs-toggle="dropdown"
            aria-expanded="false"
        >
            <span class="fw-medium">
            <%= user && user.username ? user.username : 'Administrator' %>
            </span>

            <!-- Chevron -->
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
            class="bi bi-chevron-down">
            <path fill-rule="evenodd"
                d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 
                .708.708l-6 6a.5.5 0 0 1-.708 
                0l-6-6a.5.5 0 0 1 0-.708z"/>
            </svg>
        </button>

        <ul class="dropdown-menu dropdown-menu-end mt-2">
            <li>
            <a class="dropdown-item" href="#">Profile</a>
            </li>
            <li>
            <a class="dropdown-item text-danger" href="#">Logout</a>
            </li>
        </ul>
        </div>
    </div>
</header>
