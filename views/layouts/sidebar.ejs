<aside class="d-none d-lg-block fixed-sidebar" style="min-height: 100vh;">

  <div class="card shadow-sm border-0 h-100" style="background: linear-gradient(180deg, #0d1b4b 0%, #0d1b4b 100%);">
    <div class="card-body d-flex flex-column p-3 text-white">

      <!-- Logo/Brand -->
      <div class="mb-4 text-center">
        <span class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle border shadow-sm fw-bold"
              style="width: 50px; height: 50px; font-size: 1.2rem;">
          <% if (user && user.firstName && user.lastName) { %>
            <%= (user.firstName[0] + user.lastName[0]).toUpperCase() %>
          <% } else if (user && user.username) { %>
            <%= user.username.substring(0, 2).toUpperCase() %>
          <% } else { %>
            U
          <% } %>
        </span>
        <h6 class="mt-2 mb-1 fw-semibold">PIA Portal</h6>
        <small class="opacity-75">Privacy Impact Assessment</small>
      </div>

      <!-- Navigation -->
      <nav class="nav flex-column gap-2 mb-auto">
        <a href="/dashboard" class="nav-link rounded-3 px-3 py-2 <%= activePage === 'dashboard' ? 'active bg-primary text-white shadow-sm' : 'text-white-50 hover-bg' %>" 
           data-bs-toggle="tooltip" title="Dashboard">
          <i class="bi bi-house-door-fill me-2"></i>Dashboard
        </a>
				<a href="/assessment" class="nav-link rounded-3 px-3 py-2 <%= activePage === 'dpsname' || activePage === 'assessment' ? 'active bg-primary text-white shadow-sm' : 'text-white-50 hover-bg' %>" 
           data-bs-toggle="tooltip" title="Start New Assessment">
          <i class="bi bi-file-earmark-plus-fill me-2"></i>New Assessment
        </a>
        <a href="/dashboard/all" class="nav-link rounded-3 px-3 py-2 <%= activePage === 'all-assessments' ? 'active bg-primary text-white shadow-sm' : 'text-white-50 hover-bg' %>" 
           data-bs-toggle="tooltip" title="All Assessments">
          <i class="bi bi-collection-fill me-2"></i>All Assessment
        </a>
        <a href="/reports" class="nav-link rounded-3 px-3 py-2 <%= activePage === 'reports' ? 'active bg-primary text-white shadow-sm' : 'text-white-50 hover-bg' %>" 
           data-bs-toggle="tooltip" title="View Reports">
          <i class="bi bi-bar-chart-line-fill me-2"></i>Reports
        </a>
				<a href="/user-profile" class="nav-link rounded-3 px-3 py-2 <%= activePage === 'profile' ? 'active bg-primary text-white shadow-sm' : 'text-white-50 hover-bg' %>" 
           data-bs-toggle="tooltip" title="Account Profile">
          <i class="bi bi-person-circle me-2"></i>Account Profile
        </a>

        <% if (user && user.role === 'ADMIN') { %>
					<div class="mt-2 nav-link rounded-3  text-white-50 hover-bg <%= (activePage === 'create-user' || activePage === 'users-create') ? 'active bg-primary text-white shadow-sm' : '' %>">
						<div class="dropdown w-100">
							<button class="nav-link d-flex align-items-center justify-content-between w-100 rounded-3 <%= (activePage === 'create-user' || activePage === 'users-create') ? 'active text-white' : 'text-white-50' %>" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-weight: 500;">
								<span class="d-flex align-items-center">
									<i class="bi bi-three-dots me-2"></i>Settings
								</span>
								<i class="bi bi-chevron-down"></i>
							</button>
							<ul class="dropdown-menu dropdown-menu-dark w-100 border-0 shadow-lg">
								<li>
									<a class="dropdown-item rounded-3" href="/user-profile/manage-users">
										<i class="bi bi-people me-2"></i>Edit Accounts
									</a>
								</li>
								<li>
									<a class="dropdown-item rounded-3" href="/user-profile/create-user">
										<i class="bi bi-person-plus me-2"></i>Add Account
									</a>
								</li>
							</ul>
						</div>
					</div>
        <% } %>
      </nav>

      <!-- Logout -->
      <div class="mt-auto pt-3 border-top border-white border-opacity-25">
        <a href="/logout" class="btn btn-outline-light btn-sm w-100 text-nowrap">
          <i class="bi bi-box-arrow-right me-2"></i>Logout
        </a>
      </div>
    </div>
  </div>
</aside>

<style>
.hover-bg {
  transition: all 0.2s ease;
}
.hover-bg:hover {
  background-color: rgba(13, 110, 253, 0.2) !important;
  transform: translateX(4px);
}
.nav-link.active {
  box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4);
}
</style>

