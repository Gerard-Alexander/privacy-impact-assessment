<%- include('../layouts/head', { title: title }) %>
<div class="d-flex">
	<%- include('../layouts/sidebar', { activePage: activePage }) %>
		<div class="flex-grow-1 main-content-offset">
			<%- include('../layouts/topbar', { title: title, user: user }) %>
				<main class="container-fluid py-4 px-4">
					<%
						const piiRows = Array.isArray(piiData) ? piiData : (Array.isArray(pdlcData) ? pdlcData : []);
						const dataSubjectTypeOptions = Array.isArray(dataSubjectTypes) ? dataSubjectTypes : [];
						const dataProcessingOptions = ['ELECTRONIC', 'PAPER_BASED', 'BOTH'];
						const piBasisOptions = Array.isArray(piProcessingBasisOptions) ? piProcessingBasisOptions : [];
						const spiBasisOptions = Array.isArray(spiProcessingBasisOptions) ? spiProcessingBasisOptions : [];
						const assessmentId = typeof piaAssessmentId !== 'undefined' ? piaAssessmentId : (typeof piiAssessmentId !== 'undefined' ? piiAssessmentId : '');
					%>
					<%- include('../layouts/stepper', { currentStep: 4, dpsTitle: 'Data Processing System' ,
						authParties: 'Authorized Parties' , processDataCycle: 'Process Data LifeCycle' , personalInfoInventory: 'Personal Information Inventory' , user: user
					}) %>
					
					<% if (error) { %>
						<div class="alert alert-danger mx-auto" style="max-width: 1000px;">
							<%= error %>
						</div>
						<% } %>
						<% if (success) { %>
						<div class="alert alert-success mx-auto" style="max-width: 1000px;">
							<%= success %>
						</div>
					<% } %>
					<div class="mx-auto" style="max-width: 1000px;">
						<style>
						/* Premium Modern UI Enhancements */
						:root {
							--primary-color: #0f172a;
							--primary-light: #1e293b;
							--accent-color: #3b82f6;
							--accent-hover: #2563eb;
							--bg-soft: #f8fafc;
							--border-light: #e2e8f0;
							--text-muted: #64748b;
							--text-dark: #0f172a;
							--shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
							--shadow-md: 0 8px 16px rgba(0,0,0,0.04);
							--shadow-hover: 0 12px 24px rgba(59, 130, 246, 0.1);
							--glass-bg: rgba(255, 255, 255, 0.95);
						}

						.form-control, .form-select {
							border-radius: 0.75rem;
							border: 1px solid var(--border-light);
							padding: 0.85rem 1.2rem;
							font-size: 0.95rem;
							background-color: #ffffff;
							transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
							box-shadow: inset 0 2px 4px rgba(0,0,0,0.01);
						}
						.form-control:focus, .form-select:focus {
							border-color: var(--accent-color);
							box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
							background-color: #ffffff;
							outline: none;
						}
						textarea.form-control {
							line-height: 1.5;
						}
						.custom-card {
							border-radius: 1.25rem;
							background: var(--glass-bg);
							backdrop-filter: blur(10px);
							border: 1px solid var(--border-light);
							box-shadow: var(--shadow-md);
							overflow: hidden;
							animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
						}
						.custom-header {
							background: linear-gradient(135deg, rgba(13, 27, 75, 0.05) 0%, transparent 100%);
							border-bottom: 2px solid rgba(13, 27, 75, 0.1);
							padding: 1.5rem 2rem;
						}
						.custom-header-title {
							color: #0d1b4b; /* matching sidebar primary color */
							font-weight: 700;
							letter-spacing: -0.5px;
						}
						.btn-modern.btn-sm {
							padding: 0.4rem 1rem;
							font-size: 0.875rem;
							border-radius: 0.5rem;
						}
						.btn-modern {
							border-radius: 0.75rem;
							padding: 0.75rem 1.75rem;
							font-weight: 600;
							letter-spacing: 0.3px;
							transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
							display: inline-flex;
							align-items: center;
							justify-content: center;
							gap: 0.6rem;
							border: none;
						}
						.btn-primary.btn-modern {
							background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
							color: white;
							box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
						}
						.btn-primary.btn-modern:hover {
							transform: translateY(-2px);
							box-shadow: 0 8px 20px rgba(59, 130, 246, 0.35);
							background: linear-gradient(135deg, var(--accent-hover), #1d4ed8);
						}
						.btn-danger.btn-modern {
							background: #fff;
							color: #ef4444;
							border: 1px solid #fee2e2;
							box-shadow: var(--shadow-sm);
						}
						.btn-danger.btn-modern:hover {
							background: #fef2f2;
							border-color: #fca5a5;
							transform: translateY(-2px);
						}
						.inner-card {
							background: #ffffff;
							border: 1px solid var(--border-light);
							border-radius: 1rem;
							box-shadow: var(--shadow-sm);
							padding: 1rem;
							height: 100%;
							transition: all 0.3s ease;
						}
						.inner-card:hover {
							transform: translateY(-4px);
							box-shadow: var(--shadow-hover);
							border-color: rgba(59, 130, 246, 0.3);
						}
						.inner-card-title {
							font-size: 1.1rem;
							font-weight: 700;
							color: var(--text-dark);
							margin-bottom: 0.25rem;
							display: flex;
							align-items: center;
							gap: 0.5rem;
						}
						.inner-card-desc {
							font-size: 0.85rem;
							color: var(--text-muted);
							margin-bottom: 1.25rem;
						}
						.sub-header-bar {
							background: linear-gradient(90deg, #f8fafc, #ffffff);
							border-bottom: 1px solid var(--border-light);
						}
						@keyframes slideUpFade {
							from { opacity: 0; transform: translateY(20px); }
							to { opacity: 1; transform: translateY(0); }
						}
						.section-label {
							font-weight: 600;
							color: var(--text-dark);
							font-size: 0.85rem;
							margin-bottom: 0.5rem;
							letter-spacing: 0.2px;
						}
						.bg-soft {
							background-color: var(--bg-soft) !important;
						}
						.pii-image-controls {
							display: none;
						}
						.pii-image-mode .pii-form-fields {
							display: none;
						}
						.pii-image-mode .pii-image-controls {
							display: block;
						}
						</style>
						<form id="piiForm" action="/assessment/personalinfoinventory" method="POST" enctype="multipart/form-data">
							<input type="hidden" name="piaAssessment_id" value="<%= assessmentId %>">

						<div id="pdlcRowsContainer">
							<% if (piiRows.length > 0) { %>
								<% piiRows.forEach(function(pii, index) { %>
								<!-- Single Row Template (Populated) -->
								<div class="pdlc-row border-0 custom-card mb-4">
									<% if (index === 0) { %>
									<!-- Header (First Row Only) -->
									<div class="custom-header pdlc-main-header d-flex justify-content-between align-items-center flex-wrap gap-3">
										<div class="d-flex align-items-center">
											<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
												</div>
											<div>
												<h5 class="mb-0 custom-header-title">Section D - Personal Information Inventory</h5>
												<small class="text-muted">Inventory of personal data collected and processed.</small>
											</div>
										</div>
										<button type="button" id="addRowBtn"
											class="btn btn-primary btn-modern btn-sm shadow-sm add-row-btn">
											<i class="bi bi-plus-lg me-1"></i> Add Row
										</button>
									</div>
									<% } %>

									<!-- Sub-header -->
									<div class="sub-header-bar d-flex justify-content-between align-items-center py-3 px-4">
										<h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
											<i class="bi bi-arrow-repeat text-primary fs-5"></i>
											Personal Information <span class="badge bg-primary rounded-pill row-number ms-1"><%= index + 1 %></span>
										</h6>
										<div>
											<button type="button" class="btn btn-primary btn-sm me-2 add-row-btn shadow-sm <%= index === 0 ? 'd-none' : '' %>" title="Add a new Personal Info Row">
												<i class="bi bi-plus-lg"></i> Add Row
											</button>
											<button type="button" class="btn btn-outline-danger btn-sm remove-row-btn <%= index === 0 ? 'd-none' : '' %>">
												<i class="bi bi-trash3 me-1"></i> Remove Row
											</button>
											<button type="button" class="btn btn-sm btn-light text-secondary me-2 toggle-collapse-btn" title="Minimize/Maximize">
												<i class="bi bi-chevron-up"></i>
											</button>
										</div>
									</div>

									<div class="pdlc-row-body bg-white p-4">
										<div class="row g-4">
											<!-- Card 1: Data Capture -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="d-flex justify-content-between align-items-center">
														<div class="inner-card-title">Data Capture</div>
														<button type="button" class="btn btn-outline-primary btn-sm toggle-image-mode-btn">
															<i class="bi bi-image me-1"></i> Upload Image/URL
														</button>
													</div>
													<div class="section-label mb-2">Form details and processing type.</div>
											
													<div class="pii-standard-fields">
														<div class="pii-form-fields">
															<div class="inner-card-desc">Name of Data Capture</div>
															<input type="text" name="formName[<%= index %>]" data-top-field="formName" class="form-control mb-3" value="<%= pii.formName || '' %>" required>
					
															<div class="inner-card-desc">Number of Data Capture</div>
															<input type="text" name="formNo[<%= index %>]" data-top-field="formNo" class="form-control mb-3" value="<%= pii.formNo || '' %>" required>
														</div>
														<div class="pii-image-controls mt-3">
															<div class="inner-card-desc">Upload Data Form Name and Number (Optional)</div>
															<input type="file" name="dataFormImage[<%= index %>]" data-top-field="dataFormImage" class="form-control" accept="image/*">
															<div class="inner-card-desc mt-2">Image URL or File Path</div>
															<input type="text" name="dataFormImagePath[<%= index %>]" data-top-field="dataFormImagePath" class="form-control" value="<%= pii.dataFormImagePath || '' %>">
															<small class="text-muted d-none pii-image-warning">Choose either a file or a URL. The other option will be cleared.</small>
															<input type="hidden" name="dataFormImageUploadedAt[<%= index %>]" data-top-field="dataFormImageUploadedAt" value="<%= pii.dataFormImageUploadedAt ? new Date(pii.dataFormImageUploadedAt).toISOString() : '' %>">
															<% if (pii.dataFormImagePath) { %>
																<% const imageLink = /^https?:\/\//i.test(pii.dataFormImagePath) ? pii.dataFormImagePath : '/' + pii.dataFormImagePath; %>
																<small class="text-muted d-block mt-2">
																	Current upload: <a href="<%= imageLink %>" target="_blank" rel="noopener noreferrer">View image</a>
																</small>
															<% } %>
														</div>					
													</div>

												</div>
											</div>

											<!-- Card 2: Processing Basis -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">Data Processing</div>
													<select name="dataProcessing[<%= index %>]" data-top-field="dataProcessing" class="form-select" required>
														<option value="" <%= !pii.dataProcessingValue ? 'selected' : '' %>>Select...</option>
														<% dataProcessingOptions.forEach(function(option) { %>
															<option value="<%= option %>" <%= pii.dataProcessingValue === option ? 'selected' : '' %>><%= option.replace('_', ' ') %></option>
														<% }); %>
													</select>
													<div class="inner-card-title mt-3">Processing Basis</div>
													<div class="inner-card-desc mb-2">Legal basis for processing.</div>
													<div class="pii-standard-fields">
														<div class="section-label">PI Processing Basis</div>
														<select name="piProcessBasisId[<%= index %>]" data-top-field="piProcessBasisId" class="form-select mb-3" required>
															<option value="" <%= !pii.piProcessBasisId ? 'selected' : '' %>>Select...</option>
															<% piBasisOptions.forEach(function(option) { %>
																<option value="<%= option.id %>" <%= Number(pii.piProcessBasisId) === Number(option.id) ? 'selected' : '' %>>
																	<%= option.basisNum %> - <%= option.keyword %>
																</option>
															<% }); %>
														</select>
											
														<div class="section-label">SPI Processing Basis</div>
														<select name="spiProcessBasisId[<%= index %>]" data-top-field="spiProcessBasisId" class="form-select" required>
															<option value="" <%= !pii.spiProcessBasisId ? 'selected' : '' %>>Select...</option>
															<% spiBasisOptions.forEach(function(option) { %>
																<option value="<%= option.id %>" <%= Number(pii.spiProcessBasisId) === Number(option.id) ? 'selected' : '' %>>
																	<%= option.basisNum %> - <%= option.keyword %>
																</option>
															<% }); %>
														</select>
													</div>
												</div>
											</div>

											<!-- Card 3: Recipient Users -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Recipient Users
													</div>
													<div class="inner-card-desc mb-2">Users who will receive the data.</div>

													<div class="pii-standard-fields">
														<div class="pii-recipients">
															<% const recipients = pii.recipients && pii.recipients.length ? pii.recipients : [{}]; %>
															<% recipients.forEach(function(entry, entryIndex) { %>
															<div class="pii-recipient pdlc-subentry mb-2">
																<div class="d-flex align-items-center gap-2">
																	<input type="text" name="recipients[<%= index %>][<%= entryIndex %>][recipientName]" data-field="recipientName" class="form-control" placeholder="Recipient name" value="<%= entry.recipientName || '' %>" required>
																	<button type="button" class="btn btn-outline-danger btn-sm remove-subentry-btn <%= entryIndex === 0 ? 'd-none' : '' %>" data-section="recipients" title="Remove" style="padding: 0.6rem 0.8rem;">
																		<i class="bi bi-trash3"></i>
																	</button>
																</div>
															</div>
															<% }); %>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-auto add-subentry-btn w-100" data-section="recipients" style="border-style: dashed;">
															<i class="bi bi-plus-lg me-1"></i> Add Recipient
														</button>
													</div>
												</div>
											</div>

											<!-- Card 4: Data Subjects -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Data Subjects
													</div>
													<div class="inner-card-desc mb-2">Subject information and contact details.</div>
											
													<div class="pii-standard-fields">
														<div class="pii-datasubjects">
															<% const dataSubjects = pii.dataSubjects && pii.dataSubjects.length ? pii.dataSubjects : [{}]; %>
															<% dataSubjects.forEach(function(entry, entryIndex) { %>
															<div class="pii-datasubject pdlc-subentry mb-3 p-3 bg-soft rounded-3 border border-light">
																<div class="d-flex justify-content-between align-items-center mb-3">
																	<span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 rounded-pill fw-medium" style="font-size: 0.75rem;">Subject Entry</span>
																	<button type="button" class="btn btn-sm btn-outline-danger remove-subentry-btn <%= entryIndex === 0 ? 'd-none' : '' %>" data-section="dataSubjects" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">
																		<i class="bi bi-trash3 me-1"></i>Remove
																	</button>
																</div>
																<div class="row g-2">
																	<div class="col-12 col-md-6">
																		<div class="section-label">Subject Type</div>
																		<select id="dataSubjectType" name="dataSubjects[<%= index %>][<%= entryIndex %>][dataSubjectsTypeId]" data-field="dataSubjectsTypeId" class="form-select" required>
																			<option value="" <%= !entry.dataSubjectsType_id ? 'selected' : '' %>>Select...</option>
																			<% dataSubjectTypeOptions.forEach(function(typeOption) { %>
																				<option value="<%= typeOption.id %>" <%= Number(entry.dataSubjectsType_id) === Number(typeOption.id) ? 'selected' : '' %>><%= typeOption.dataSubjectType %></option>
																			<% }); %>
																		</select>
																	</div>
																	<div class="col-12 col-md-6">
																		<div class="section-label">Name</div>
																		<input type="text" id="dataSubjectName" name="dataSubjects[<%= index %>][<%= entryIndex %>][name]" data-field="name" class="form-control" value="<%= entry.name || '' %>" placeholder="Subject name" required>
																	</div>
																</div>
															</div>
															<% }); %>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-auto add-subentry-btn w-100" data-section="dataSubjects" style="border-style: dashed;">
															<i class="bi bi-plus-lg me-1"></i> Add Subject
														</button>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
								<% }); %>
								<% } else { %>
								<!-- Single Row Template (Empty) -->
								<div class="pdlc-row border-0 custom-card mb-4">
									<!-- Header (First Row Only) -->
									<div class="custom-header pdlc-main-header d-flex justify-content-between align-items-center flex-wrap gap-3">
										<div class="d-flex align-items-center">
											<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
												</div>
											<div>
												<h5 class="mb-0 custom-header-title">Section D - Personal Information Inventory</h5>
												<small class="text-muted">Inventory of personal data collected and processed.</small>
											</div>
										</div>
										<button type="button" id="addRowBtn"
											class="btn btn-primary btn-modern shadow-sm add-row-btn">
											<i class="bi bi-plus-lg me-1"></i> Add Row
										</button>
									</div>

									<!-- Sub-header -->
									<div class="sub-header-bar d-flex justify-content-between align-items-center py-3 px-4">
										<h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
											<i class="bi bi-arrow-repeat text-primary fs-5"></i>
											Personal Information <span class="badge bg-primary rounded-pill row-number ms-1">1</span>
										</h6>
										<div>
											<button type="button" class="btn btn-primary btn-sm me-2 add-row-btn shadow-sm d-none" title="Add a new Personal Info Row">
												<i class="bi bi-plus-lg"></i> Add Row
											</button>
											<button type="button" class="btn btn-outline-danger btn-sm remove-row-btn d-none">
												<i class="bi bi-trash3 me-1"></i> Remove Row
											</button>
											<button type="button" class="btn btn-sm btn-light text-secondary me-2 toggle-collapse-btn" title="Minimize/Maximize">
												<i class="bi bi-chevron-up"></i>
											</button>
										</div>
									</div>

									<div class="pdlc-row-body bg-white p-4">
										<div class="row g-4">
											<!-- Card 1: Data Capture -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="d-flex justify-content-between align-items-center">
														<div class="inner-card-title">Data Capture</div>
														<button type="button" class="btn btn-outline-primary btn-sm toggle-image-mode-btn">
															<i class="bi bi-image me-1"></i> Upload Image/URL
														</button>
													</div>
													<div class="inner-card-desc mb-2">Form details and processing type.</div>
											
													<div class="pii-standard-fields">
														<div class="pii-form-fields">
															<div class="section-label">Name of Data Capture</div>
															<input type="text" name="formName[0]" data-top-field="formName" class="form-control mb-3" required>
					
															<div class="section-label">Number of Data Capture</div>
															<input type="text" name="formNo[0]" data-top-field="formNo" class="form-control mb-3" required>
														</div>
					
														<div class="section-label">Data Processing</div>
														<select name="dataProcessing[0]" data-top-field="dataProcessing" class="form-select" required>
															<option value="">Select...</option>
															<% dataProcessingOptions.forEach(function(option) { %>
																<option value="<%= option %>"><%= option.replace('_', ' ') %></option>
															<% }); %>
														</select>
													</div>

													<div class="pii-image-controls mt-3">
														<div class="section-label">Upload Data Form Image (Optional)</div>
														<small class="text-muted d-block mb-2">Use this for form name/number reference only.</small>
														<input type="file" name="dataFormImage[0]" data-top-field="dataFormImage" class="form-control" accept="image/*">
														<div class="section-label mt-2">Image URL or File Path</div>
														<input type="text" name="dataFormImagePath[0]" data-top-field="dataFormImagePath" class="form-control" value="">
														<small class="text-muted d-none pii-image-warning">Choose either a file or a URL. The other option will be cleared.</small>
														<input type="hidden" name="dataFormImageUploadedAt[0]" data-top-field="dataFormImageUploadedAt" value="">
													</div>
												</div>
											</div>

											<!-- Card 2: Processing Basis -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Processing Basis
													</div>
													<div class="inner-card-desc mb-2">Legal basis for processing.</div>
											
													<div class="pii-standard-fields">
														<div class="section-label">PI Processing Basis</div>
														<select name="piProcessBasisId[0]" data-top-field="piProcessBasisId" class="form-select mb-3" required>
															<option value="">Select...</option>
															<% piBasisOptions.forEach(function(option) { %>
																<option value="<%= option.id %>"><%= option.basisNum %> - <%= option.keyword %></option>
															<% }); %>
														</select>
					
														<div class="section-label">SPI Processing Basis</div>
														<select name="spiProcessBasisId[0]" data-top-field="spiProcessBasisId" class="form-select" required>
															<option value="">Select...</option>
															<% spiBasisOptions.forEach(function(option) { %>
																<option value="<%= option.id %>"><%= option.basisNum %> - <%= option.keyword %></option>
															<% }); %>
														</select>
													</div>
												</div>
											</div>

											<!-- Card 3: Recipient Users -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Recipient Users
													</div>
													<div class="inner-card-desc mb-2">Users who will receive the data.</div>

													<div class="pii-standard-fields">
														<div class="pii-recipients">
															<div class="pii-recipient pdlc-subentry mb-2">
																<div class="d-flex align-items-center gap-2">
																	<input type="text" name="recipients[0][0][recipientName]" data-field="recipientName" class="form-control" placeholder="Recipient name" required>
																	<button type="button" class="btn btn-outline-danger btn-sm remove-subentry-btn d-none" data-section="recipients" title="Remove" style="padding: 0.6rem 0.8rem;">
																		<i class="bi bi-trash3"></i>
																	</button>
																</div>
															</div>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-auto add-subentry-btn w-100" data-section="recipients" style="border-style: dashed;">
															<i class="bi bi-plus-lg me-1"></i> Add Recipient
														</button>
													</div>
												</div>
											</div>

											<!-- Card 4: Data Subjects -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Data Subjects
													</div>
													<div class="inner-card-desc mb-2">Subject information and contact details.</div>
											
													<div class="pii-standard-fields">
														<div class="pii-datasubjects">
															<div class="pii-datasubject pdlc-subentry mb-3 p-3 bg-soft rounded-3 border border-light">
																<div class="d-flex justify-content-between align-items-center mb-3">
																	<span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 rounded-pill fw-medium" style="font-size: 0.75rem;">Subject Entry</span>
																	<button type="button" class="btn btn-sm btn-outline-danger remove-subentry-btn d-none" data-section="dataSubjects" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">
																		<i class="bi bi-trash3 me-1"></i>Remove
																	</button>
																</div>
																<div class="row g-2">
																	<div class="col-12 col-md-6">
																		<div class="section-label">Subject Type</div>
																		<select id="dataSubjectType" name="dataSubjects[0][0][dataSubjectsTypeId]" data-field="dataSubjectsTypeId" class="form-select" required>
																			<option value="">Select...</option>
																			<% dataSubjectTypeOptions.forEach(function(typeOption) { %>
																				<option value="<%= typeOption.id %>"><%= typeOption.dataSubjectType %></option>
																			<% }); %>
																		</select>
																	</div>
																	<div class="col-12 col-md-6">
																		<div class="section-label">Name</div>
																		<input type="text" id="dataSubjectName" name="dataSubjects[0][0][name]" data-field="name" class="form-control" placeholder="Subject name" required>
																	</div>
																</div>
															</div>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-auto add-subentry-btn w-100" data-section="dataSubjects" style="border-style: dashed;">
															<i class="bi bi-plus-lg me-1"></i> Add Subject
														</button>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
								<% } %>
						</div>
						</form>
					</div>
					<hr class="my-4 text-muted">
					<div class="mx-auto d-flex justify-content-between align-items-center mt-2" style="max-width: 1000px;">
						<button type="submit" form="piiForm" name="redirectTo" value="previous" formnovalidate
							class="btn btn-danger btn-modern shadow-sm">
							<i class="bi bi-arrow-left-short fs-5"></i> Previous Page
						</button>
						<span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill fw-medium">Step 4 of 7</span>
						<button type="submit" form="piiForm"
							class="btn btn-primary btn-modern shadow-sm">
							Next Page <i class="bi bi-arrow-right-short fs-5"></i>
						</button>
					</div>
				</main>
		</div>
</div>

<script>
	(function () {
		const container = document.getElementById('pdlcRowsContainer');
		if (!container) {
			return;
		}

		const sectionConfig = {
			recipients: { containerClass: 'pii-recipients', entryClass: 'pii-recipient' },
			dataSubjects: { containerClass: 'pii-datasubjects', entryClass: 'pii-datasubject' }
		};

		const createBlankValue = (element) => {
			if (element.tagName === 'SELECT') {
				element.selectedIndex = 0;
				return;
			}

			if (element.tagName === 'TEXTAREA' || element.tagName === 'INPUT') {
				element.value = '';
			}
		};

		const updateRowNumbers = () => {
			const rows = container.querySelectorAll('.pdlc-row');
			rows.forEach((row, index) => {
				const rowNumber = row.querySelector('.row-number');
				if (rowNumber) {
					rowNumber.textContent = String(index + 1);
				}

				const removeButton = row.querySelector('.remove-row-btn');
				if (removeButton) {
					removeButton.classList.toggle('d-none', index === 0);
				}

				const subHeaderAddBtn = row.querySelector('.sub-header-bar .add-row-btn');
				if (subHeaderAddBtn) {
					subHeaderAddBtn.classList.toggle('d-none', index === 0);
				}
			});
		};

		const updateSubEntryButtons = (row) => {
			Object.keys(sectionConfig).forEach((section) => {
				const config = sectionConfig[section];
				const containerEl = row.querySelector('.' + config.containerClass);
				if (!containerEl) return;
				const entries = containerEl.querySelectorAll('.' + config.entryClass);
				for (let i = 0; i < entries.length; i += 1) {
					const removeBtn = entries[i].querySelector('.remove-subentry-btn');
					if (!removeBtn) continue;
					removeBtn.classList.toggle('d-none', entries.length <= 1);
				}
			});
		};

		const updateAllNames = () => {
			const rows = container.querySelectorAll('.pdlc-row');
			for (let i = 0; i < rows.length; i += 1) {
				const row = rows[i];
				const topFields = row.querySelectorAll('[data-top-field]');
				for (let j = 0; j < topFields.length; j += 1) {
					const field = topFields[j].getAttribute('data-top-field');
					topFields[j].name = field + '[' + i + ']';
				}

				Object.keys(sectionConfig).forEach((section) => {
					const config = sectionConfig[section];
					const containerEl = row.querySelector('.' + config.containerClass);
					if (!containerEl) return;
					const entries = containerEl.querySelectorAll('.' + config.entryClass);
					for (let entryIndex = 0; entryIndex < entries.length; entryIndex += 1) {
						const inputs = entries[entryIndex].querySelectorAll('[data-field]');
						for (let k = 0; k < inputs.length; k += 1) {
							const fieldName = inputs[k].getAttribute('data-field');
							inputs[k].name = section + '[' + i + '][' + entryIndex + '][' + fieldName + ']';
						}
					}
				});
			}
		};

		const updateToggleButton = (row, enabled) => {
			const button = row.querySelector('.toggle-image-mode-btn');
			if (!button) return;
			if (enabled) {
				button.classList.remove('btn-outline-primary');
				button.classList.add('btn-outline-secondary');
				button.innerHTML = '<i class="bi bi-pencil me-1"></i> Use Form Inputs';
			} else {
				button.classList.remove('btn-outline-secondary');
				button.classList.add('btn-outline-primary');
				button.innerHTML = '<i class="bi bi-image me-1"></i> Upload Image/URL';
			}
		};

		const updateImageInputs = (row, source) => {
			const fileInput = row.querySelector('input[type="file"][name^="dataFormImage"]');
			const urlInput = row.querySelector('input[name^="dataFormImagePath"]');
			const warning = row.querySelector('.pii-image-warning');
			const hasFile = fileInput && fileInput.files && fileInput.files.length > 0;
			const hasUrl = urlInput && String(urlInput.value || '').trim().length > 0;

			if (warning) {
				warning.classList.add('d-none');
			}

			if (source === 'file' && hasFile && hasUrl && urlInput) {
				urlInput.value = '';
				if (warning) warning.classList.remove('d-none');
			}

			if (source === 'url' && hasUrl && hasFile && fileInput) {
				fileInput.value = '';
				if (warning) warning.classList.remove('d-none');
			}

			const finalHasFile = fileInput && fileInput.files && fileInput.files.length > 0;
			const finalHasUrl = urlInput && String(urlInput.value || '').trim().length > 0;

			if (fileInput) {
				fileInput.disabled = finalHasUrl;
			}
			if (urlInput) {
				urlInput.disabled = finalHasFile;
			}
		};

			const setRowImageMode = (row, enabled) => {
				row.classList.toggle('pii-image-mode', enabled);
				const formFields = row.querySelectorAll('[data-top-field="formName"], [data-top-field="formNo"]');
				for (const field of formFields) {
					if (enabled) {
						if (!field.dataset.wasRequired) {
							field.dataset.wasRequired = field.required ? '1' : '0';
						}
						field.required = false;
						field.disabled = true;
					} else {
						field.disabled = false;
						if (field.dataset.wasRequired === '1') {
							field.required = true;
						}
					}
				}
				updateToggleButton(row, enabled);
			};

		const validateRow = (row) => {
			const inputs = row.querySelectorAll('input, select, textarea');
			for (const input of inputs) {
				if (!input.required) {
					continue;
				}
				if (!input.value || input.value.trim() === '') {
					return false;
				}
			}
			return true;
		};

		document.addEventListener('click', function (event) {
			const imageToggleBtn = event.target.closest('.toggle-image-mode-btn');
			if (imageToggleBtn) {
				event.preventDefault();
				const row = imageToggleBtn.closest('.pdlc-row');
				if (row) {
					const nextState = !row.classList.contains('pii-image-mode');
					setRowImageMode(row, nextState);
					if (nextState) {
						const urlInput = row.querySelector('input[name^="dataFormImagePath"]');
						if (urlInput) {
							urlInput.focus();
						}
					}
				}
			}

			if (event.target.closest('.add-row-btn')) {
				event.preventDefault();

				const firstRow = container.querySelector('.pdlc-row');
				if (!firstRow) {
					return;
				}

				const newRow = firstRow.cloneNode(true);

				const mainHeader = newRow.querySelector('.pdlc-main-header');
				if (mainHeader) mainHeader.remove();

				const body = newRow.querySelector('.pdlc-row-body');
				if (body) body.style.display = 'block';
				const toggleIcon = newRow.querySelector('.toggle-collapse-btn i');
				if (toggleIcon) {
					toggleIcon.classList.remove('bi-chevron-down');
					toggleIcon.classList.add('bi-chevron-up');
				}

				newRow.querySelectorAll('input, select, textarea').forEach(createBlankValue);

				Object.keys(sectionConfig).forEach((section) => {
					const config = sectionConfig[section];
					const containerEl = newRow.querySelector('.' + config.containerClass);
					if (!containerEl) return;
					const entries = containerEl.querySelectorAll('.' + config.entryClass);
					for (let i = entries.length - 1; i >= 1; i -= 1) {
						entries[i].parentNode.removeChild(entries[i]);
					}
					if (entries[0]) {
						entries[0].querySelectorAll('input, select, textarea').forEach(createBlankValue);
					}
				});

				const removeButton = newRow.querySelector('.remove-row-btn');
				if (removeButton) {
					removeButton.classList.remove('d-none');
				}

				container.appendChild(newRow);
				updateRowNumbers();
				updateAllNames();
				updateSubEntryButtons(newRow);
				setRowImageMode(newRow, false);
				updateImageInputs(newRow, 'init');
			}

			const removeButton = event.target.closest('.remove-row-btn');
			if (removeButton) {
				event.preventDefault();
				const row = removeButton.closest('.pdlc-row');
				if (row) {
					row.remove();
					updateRowNumbers();
					updateAllNames();
				}
			}

			const toggleBtn = event.target.closest('.toggle-collapse-btn');
			if (toggleBtn) {
				const row = toggleBtn.closest('.pdlc-row');
				if (row) {
					const body = row.querySelector('.pdlc-row-body');
					const icon = toggleBtn.querySelector('i');
					if (body) {
						if (body.style.display === 'none') {
							body.style.display = 'block';
							icon.classList.remove('bi-chevron-down');
							icon.classList.add('bi-chevron-up');
						} else {
							body.style.display = 'none';
							icon.classList.remove('bi-chevron-up');
							icon.classList.add('bi-chevron-down');
						}
					}
				}
			}

			const addSubBtn = event.target.closest('.add-subentry-btn');
			if (addSubBtn) {
				const section = addSubBtn.getAttribute('data-section');
				const config = sectionConfig[section];
				if (!config) return;
				const row = addSubBtn.closest('.pdlc-row');
				if (!row) return;
				const containerEl = row.querySelector('.' + config.containerClass);
				if (!containerEl) return;
				const firstEntry = containerEl.querySelector('.' + config.entryClass);
				if (!firstEntry) return;
				const newEntry = firstEntry.cloneNode(true);
				newEntry.querySelectorAll('input, select, textarea').forEach(createBlankValue);
				containerEl.appendChild(newEntry);
				updateSubEntryButtons(row);
				updateAllNames();
			}

			const removeSubBtn = event.target.closest('.remove-subentry-btn');
			if (removeSubBtn) {
				const section = removeSubBtn.getAttribute('data-section');
				const config = sectionConfig[section];
				if (!config) return;
				const row = removeSubBtn.closest('.pdlc-row');
				if (!row) return;
				const entry = removeSubBtn.closest('.' + config.entryClass);
				const containerEl = row.querySelector('.' + config.containerClass);
				if (entry && containerEl && containerEl.querySelectorAll('.' + config.entryClass).length > 1) {
					containerEl.removeChild(entry);
					updateSubEntryButtons(row);
					updateAllNames();
				}
			}
		});

		document.addEventListener('change', function (event) {
			const target = event.target;
			if (!target) return;
			if (target.type !== 'file' || !target.name.startsWith('dataFormImage')) return;
			const row = target.closest('.pdlc-row');
			if (row) {
				updateImageInputs(row, 'file');
			}
		});

		document.addEventListener('input', function (event) {
			const target = event.target;
			if (!target) return;
			if (!target.name || !target.name.startsWith('dataFormImagePath')) return;
			const row = target.closest('.pdlc-row');
			if (row) {
				updateImageInputs(row, 'url');
			}
		});

		const piiForm = document.getElementById('piiForm');
		if (piiForm) {
			piiForm.addEventListener('submit', function (e) {
				// Bypass validation if "Previous Page" was clicked
				const submitter = e.submitter || document.activeElement;
				if (submitter && submitter.name === 'redirectTo' && submitter.value === 'previous') {
					return;
				}

				const rows = container.querySelectorAll('.pdlc-row');
				for (let i = 0; i < rows.length; i += 1) {
					if (!validateRow(rows[i])) {
						e.preventDefault();
						alert('Please complete all fields in every row before submitting.');
						return;
					}
				}
			});
		}

		updateRowNumbers();
		updateAllNames();
		const initRows = container.querySelectorAll('.pdlc-row');
		for (let r = 0; r < initRows.length; r += 1) {
			updateSubEntryButtons(initRows[r]);
			const urlInput = initRows[r].querySelector('input[name^="dataFormImagePath"]');
			const hasUrl = urlInput && String(urlInput.value || '').trim().length > 0;
			setRowImageMode(initRows[r], hasUrl);
			updateImageInputs(initRows[r], 'init');
		}
	})();
</script>
