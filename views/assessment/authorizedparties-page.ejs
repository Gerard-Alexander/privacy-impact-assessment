	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		const createUnitForm = document.getElementById('createUnitForm');
		createUnitForm.addEventListener('submit', async (event) => {
			event.preventDefault();
			const unitInput = document.getElementById('newUnitName');
			const errorMessage = document.getElementById('createUnitError');
			const saveButton = document.getElementById('saveUnitButton');
			const name = unitInput.value.trim();
			errorMessage.classList.add('d-none');
			if (!name) {
				unitInput.focus();
				return;
			}

			saveButton.disabled = true;
			try {
				const assessmentId = document.querySelector('#authorizedForm [name="piaAssessmentId"]').value;
				const response = await fetch('/assessment/authorizedparties/units', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ name, piaAssessmentId: assessmentId })
				});
				const result = await response.json();
				if (!response.ok) throw new Error(result.error || 'Unable to save this unit.');

				let option = Array.from(document.getElementById('headOfficeUnit').options).find(item => item.value === result.unit.name);
				if (!option) {
					option = new Option(result.unit.name, result.unit.name);
					document.getElementById('headOfficeUnit').add(option);
				}
				document.getElementById('headOfficeUnit').value = result.unit.name;
				bootstrap.Modal.getInstance(document.getElementById('createUnitModal')).hide();
				unitInput.value = '';
			} catch (error) {
				errorMessage.textContent = error.message;
				errorMessage.classList.remove('d-none');
			} finally {
				saveButton.disabled = false;
			}
		});
	</script>
