<%- include('../layouts/head', { title: title }) %>

<div class="d-flex">
	<%- include('../layouts/sidebar', { activePage: activePage }) %>

	<div class="flex-grow-1 main-content-offset">
		<%- include('../layouts/topbar', { title: title, user: user }) %>

		<main class="container-fluid py-4">
			<div class="card border-0 shadow-sm">
				<div class="card-body">
					<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
						<div>
							<h4 class="mb-1 fw-bold">Reports Overview</h4>
							<div class="text-muted">Summary of assessments, risks, and coverage.</div>
						</div>
						<div class="text-muted small">Updated: <%= new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
					</div>

					<div class="row g-3 mb-4">
						<div class="col-12 col-sm-6 col-lg-3">
							<div class="card border-0 shadow-sm h-100" style="border-left: 5px solid #1a3a6b !important;">
								<div class="card-body py-4 px-3 px-md-4">
									<div class="small fw-bold text-uppercase text-secondary mb-2 lh-1" style="letter-spacing: 0.07em; font-size: 0.875rem;">Total Assessments</div>
									<div class="h3 mb-0 fw-bold" style="color: #1a3a6b;"><%= totalAssessments || 0 %></div>
								</div>
							</div>
						</div>
						<div class="col-12 col-sm-6 col-lg-3">
							<div class="card border-0 shadow-sm h-100" style="border-left: 5px solid #e6a817 !important;">
								<div class="card-body py-4 px-3 px-md-4">
									<div class="small fw-bold text-uppercase text-secondary mb-2 lh-1" style="letter-spacing: 0.07em; font-size: 0.875rem;">Draft Assessments</div>
									<div class="h3 mb-0 fw-bold" style="color: #1a3a6b;"><%= draftAssessments || 0 %></div>
								</div>
							</div>
						</div>
						<div class="col-12 col-sm-6 col-lg-3">
							<div class="card border-0 shadow-sm h-100" style="border-left: 5px solid #2e9e50 !important;">
								<div class="card-body py-4 px-3 px-md-4">
									<div class="small fw-bold text-uppercase text-secondary mb-2 lh-1" style="letter-spacing: 0.07em; font-size: 0.875rem;">Completed</div>
									<div class="h3 mb-0 fw-bold" style="color: #1a3a6b;"><%= completedAssessments || 0 %></div>
								</div>
							</div>
						</div>
						<div class="col-12 col-sm-6 col-lg-3">
							<div class="card border-0 shadow-sm h-100" style="border-left: 5px solid #c0392b !important;">
								<div class="card-body py-4 px-3 px-md-4">
									<div class="small fw-bold text-uppercase text-secondary mb-2 lh-1" style="letter-spacing: 0.07em; font-size: 0.875rem;">Control Coverage</div>
									<div class="h3 mb-0 fw-bold" style="color: #1a3a6b;"><%= coveragePercent || 0 %>%</div>
									<div class="text-muted small"><%= threatsWithControl || 0 %> of <%= totalThreats || 0 %> threats</div>
								</div>
							</div>
						</div>
					</div>

					<div class="row g-3 mb-4">
						<div class="col-12 col-lg-7">
							<div class="card border-0 shadow-sm h-100">
								<div class="card-header bg-white border-0 pb-0">
									<div class="d-flex align-items-center justify-content-between">
										<h6 class="fw-bold mb-0">Top Risks</h6>
										<span class="text-muted small">Highest current ratings</span>
									</div>
								</div>
								<div class="card-body">
									<% if (topRisks && topRisks.length > 0) { %>
										<div class="table-responsive">
											<table class="table table-sm align-middle">
												<thead>
													<tr class="text-muted">
														<th>Assessment</th>
														<th>Data Subject</th>
														<th>Stakeholder</th>
														<th class="text-end">Risk</th>
													</tr>
												</thead>
												<tbody>
													<% topRisks.forEach(risk => { 
														const riskValue = typeof risk.currentRiskRating === 'number'
															? risk.currentRiskRating
															: (typeof risk.afterRiskRating === 'number' ? risk.afterRiskRating : null);
													%>
														<tr>
															<td class="fw-semibold">
																<%= risk.piaAssessment && risk.piaAssessment.dpsName ? risk.piaAssessment.dpsName : 'Untitled' %>
															</td>
															<td>
																<%= risk.dataSubjects && risk.dataSubjects.name ? risk.dataSubjects.name : 'N/A' %>
															</td>
															<td>
																<%= risk.pdlc && risk.pdlc.stakeholderName ? risk.pdlc.stakeholderName : 'N/A' %>
															</td>
															<td class="text-end">
																<span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
																	<%= riskValue !== null ? riskValue : 'N/A' %>
																</span>
															</td>
														</tr>
													<% }) %>
												</tbody>
											</table>
										</div>
									<% } else { %>
										<div class="text-center text-muted py-4">No risk data available yet.</div>
									<% } %>
								</div>
							</div>
						</div>

						<div class="col-12 col-lg-5">
							<div class="card border-0 shadow-sm h-100">
								<div class="card-header bg-white border-0 pb-0">
									<div class="d-flex align-items-center justify-content-between">
										<h6 class="fw-bold mb-0">Inventory Snapshot</h6>
										<span class="text-muted small">Counts from active access</span>
									</div>
								</div>
								<div class="card-body">
									<div class="row g-3">
										<div class="col-6">
											<div class="p-3 rounded-3" style="background-color: #f8f9fa;">
												<div class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">PII Entries</div>
												<div class="h4 mb-0 fw-bold text-primary"><%= piiCount || 0 %></div>
											</div>
										</div>
										<div class="col-6">
											<div class="p-3 rounded-3" style="background-color: #f8f9fa;">
												<div class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">Data Subjects</div>
												<div class="h4 mb-0 fw-bold text-primary"><%= dataSubjectCount || 0 %></div>
											</div>
										</div>
										<div class="col-12">
											<div class="p-3 rounded-3" style="background-color: #f8f9fa;">
												<div class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">PDLC Records</div>
												<div class="h4 mb-0 fw-bold text-primary"><%= pdlcCount || 0 %></div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="card border-0 shadow-sm">
						<div class="card-header bg-white border-0 pb-0">
							<div class="d-flex align-items-center justify-content-between">
								<h6 class="fw-bold mb-0">Recent Assessments</h6>
								<a href="/dashboard" class="small text-decoration-none">View dashboard</a>
							</div>
						</div>
						<div class="card-body">
							<% if (recentAssessments && recentAssessments.length > 0) { %>
								<div class="list-group list-group-flush">
									<% recentAssessments.forEach(assessment => { 
										const statusColor = assessment.status === 'COMPLETED' ? 'success' : 'warning';
									%>
										<div class="list-group-item d-flex justify-content-between align-items-center">
											<div>
												<div class="fw-semibold"><%= assessment.dpsName || 'Untitled Assessment' %></div>
												<div class="text-muted small">Updated <%= new Date(assessment.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
											</div>
											<div class="d-flex align-items-center gap-2">
												<span class="badge bg-<%= statusColor %> bg-opacity-10 text-<%= statusColor %> border border-<%= statusColor %> border-opacity-25 rounded-pill px-2 py-1" style="font-size: 0.65rem;">
													<%= assessment.status %>
												</span>
												<a href="/assessment?id=<%= assessment.id %>" class="btn btn-outline-primary btn-sm">Open</a>
													<a href="/export/assessment?id=<%= assessment.id %>" class="btn btn-outline-success btn-sm" title="Export Excel">
														<i class="bi bi-file-earmark-spreadsheet me-1"></i>Export
													</a>
											</div>
										</div>
									<% }) %>
								</div>
							<% } else { %>
								<div class="text-center text-muted py-4">No recent assessments found.</div>
							<% } %>
						</div>
					</div>
				</div>
			</div>
		</main>
	</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
