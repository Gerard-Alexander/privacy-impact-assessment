<%- include('../layouts/head', { title: title }) %>
<div class="d-flex">
	<%- include('../layouts/sidebar', { activePage: activePage }) %>
		<div class="flex-grow-1 main-content-offset">
			<%- include('../layouts/topbar', { title: title, user: user }) %>
				<main class="container-fluid py-4 px-4">
					<%
						const piiRows = Array.isArray(piiData) ? piiData : (Array.isArray(pdlcData) ? pdlcData : []);
						const dataSubjectTypeOptions = Array.isArray(dataSubjectTypes) ? dataSubjectTypes : [];
						const dataProcessingOptions = ['ELECTRONIC', 'PAPER_BASED', 'BOTH'];
						const processingTypeOptions = ['PI', 'SPI'];
						const basisOptions = ['TYPE_1', 'TYPE_2', 'TYPE_3', 'TYPE_4', 'TYPE_5', 'TYPE_6'];
						const assessmentId = typeof piaAssessmentId !== 'undefined' ? piaAssessmentId : (typeof piiAssessmentId !== 'undefined' ? piiAssessmentId : '');
					%>
					<%- include('../layouts/stepper', { currentStep: 4, dpsTitle: 'Data Processing System' ,
						authParties: 'Authorized Parties' , processDataCycle: 'Process Data LifeCycle' , personalInfoInventory: 'Personal Information Inventory' , user: user
					}) %>
					
					<% if (error) { %>
						<div class="alert alert-danger mx-auto" style="max-width: 1000px;">
							<%= error %>
						</div>
						<% } %>
						<% if (success) { %>
						<div class="alert alert-success mx-auto" style="max-width: 1000px;">
							<%= success %>
						</div>
					<% } %>
					<div class="mx-auto" style="max-width: 1000px;">
						<style>
						/* Premium Modern UI Enhancements */
						:root {
							--primary-color: #0f172a;
							--primary-light: #1e293b;
							--accent-color: #3b82f6;
							--accent-hover: #2563eb;
							--bg-soft: #f8fafc;
							--border-light: #e2e8f0;
							--text-muted: #64748b;
							--text-dark: #0f172a;
							--shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
							--shadow-md: 0 8px 16px rgba(0,0,0,0.04);
							--shadow-hover: 0 12px 24px rgba(59, 130, 246, 0.1);
							--glass-bg: rgba(255, 255, 255, 0.95);
						}

						.form-control, .form-select {
							border-radius: 0.75rem;
							border: 1px solid var(--border-light);
							padding: 0.85rem 1.2rem;
							font-size: 0.95rem;
							background-color: #ffffff;
							transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
							box-shadow: inset 0 2px 4px rgba(0,0,0,0.01);
						}
						.form-control:focus, .form-select:focus {
							border-color: var(--accent-color);
							box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
							background-color: #ffffff;
							outline: none;
						}
						textarea.form-control {
							line-height: 1.5;
						}
						.custom-card {
							border-radius: 1.25rem;
							background: var(--glass-bg);
							backdrop-filter: blur(10px);
							border: 1px solid var(--border-light);
							box-shadow: var(--shadow-md);
							overflow: hidden;
							animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
						}
						.custom-header {
							background: linear-gradient(135deg, rgba(13, 27, 75, 0.05) 0%, transparent 100%);
							border-bottom: 2px solid rgba(13, 27, 75, 0.1);
							padding: 1.5rem 2rem;
						}
						.custom-header-title {
							color: #0d1b4b; /* matching sidebar primary color */
							font-weight: 700;
							letter-spacing: -0.5px;
						}
						.btn-modern.btn-sm {
							padding: 0.4rem 1rem;
							font-size: 0.875rem;
							border-radius: 0.5rem;
						}
						.btn-modern {
							border-radius: 0.75rem;
							padding: 0.75rem 1.75rem;
							font-weight: 600;
							letter-spacing: 0.3px;
							transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
							display: inline-flex;
							align-items: center;
							justify-content: center;
							gap: 0.6rem;
							border: none;
						}
						.btn-primary.btn-modern {
							background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
							color: white;
							box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
						}
						.btn-primary.btn-modern:hover {
							transform: translateY(-2px);
							box-shadow: 0 8px 20px rgba(59, 130, 246, 0.35);
							background: linear-gradient(135deg, var(--accent-hover), #1d4ed8);
						}
						.btn-danger.btn-modern {
							background: #fff;
							color: #ef4444;
							border: 1px solid #fee2e2;
							box-shadow: var(--shadow-sm);
						}
						.btn-danger.btn-modern:hover {
							background: #fef2f2;
							border-color: #fca5a5;
							transform: translateY(-2px);
						}
						.inner-card {
							background: #ffffff;
							border: 1px solid var(--border-light);
							border-radius: 1rem;
							box-shadow: var(--shadow-sm);
							padding: 1rem;
							height: 100%;
							transition: all 0.3s ease;
						}
						.inner-card:hover {
							transform: translateY(-4px);
							box-shadow: var(--shadow-hover);
							border-color: rgba(59, 130, 246, 0.3);
						}
						.inner-card-title {
							font-size: 1.1rem;
							font-weight: 700;
							color: var(--text-dark);
							margin-bottom: 0.25rem;
							display: flex;
							align-items: center;
							gap: 0.5rem;
						}
						.inner-card-desc {
							font-size: 0.85rem;
							color: var(--text-muted);
							margin-bottom: 1.25rem;
						}
						.sub-header-bar {
							background: linear-gradient(90deg, #f8fafc, #ffffff);
							border-bottom: 1px solid var(--border-light);
						}
						@keyframes slideUpFade {
							from { opacity: 0; transform: translateY(20px); }
							to { opacity: 1; transform: translateY(0); }
						}
						.section-label {
							font-weight: 600;
							color: var(--text-dark);
							font-size: 0.85rem;
							margin-bottom: 0.5rem;
							letter-spacing: 0.2px;
						}
						</style>
						<form id="piiForm" action="/assessment/personalinfoinventory" method="POST">
							<input type="hidden" name="piaAssessment_id" value="<%= assessmentId %>">

						<div id="pdlcRowsContainer">
							<% if (piiRows.length > 0) { %>
								<% piiRows.forEach(function(pii, index) { %>
								<!-- Single Row Template (Populated) -->
								<div class="pdlc-row border-0 custom-card mb-4">
									<% if (index === 0) { %>
									<!-- Header (First Row Only) -->
									<div class="custom-header pdlc-main-header d-flex justify-content-between align-items-center flex-wrap gap-3">
										<div class="d-flex align-items-center">
											<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
												</div>
											<div>
												<h5 class="mb-0 custom-header-title">Section D - Personal Information Inventory</h5>
												<small class="text-muted">Inventory of personal data collected and processed.</small>
											</div>
										</div>
										<button type="button" id="addRowBtn"
											class="btn btn-primary btn-modern btn-sm shadow-sm add-row-btn">
											<i class="bi bi-plus-lg me-1"></i> Add Row
										</button>
									</div>
									<% } %>

									<!-- Sub-header -->
									<div class="sub-header-bar d-flex justify-content-between align-items-center py-3 px-4">
										<h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
											<i class="bi bi-arrow-repeat text-primary fs-5"></i>
											Personal Information <span class="badge bg-primary rounded-pill row-number ms-1"><%= index + 1 %></span>
										</h6>
										<div>
											<button type="button" class="btn btn-primary btn-sm me-2 add-row-btn shadow-sm <%= index === 0 ? 'd-none' : '' %>" title="Add a new Personal Info Row">
												<i class="bi bi-plus-lg"></i> Add Row
											</button>
											<button type="button" class="btn btn-sm btn-light text-secondary me-2 toggle-collapse-btn" title="Minimize/Maximize">
												<i class="bi bi-chevron-up"></i>
											</button>
											<button type="button" class="btn btn-outline-danger btn-sm remove-row-btn <%= index === 0 ? 'd-none' : '' %>">
												<i class="bi bi-trash3 me-1"></i> Remove Cycle
											</button>
										</div>
									</div>

									<div class="pdlc-row-body bg-white p-4">
										<div class="row g-4">
											<!-- Card 1: Data Capture & Recipients -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Data Capture & Recipients
													</div>
													<div class="inner-card-desc mb-2">Form details, processing type, and recipients.</div>
													
													<div class="section-label">Name of Data Capture</div>
													<input type="text" name="formName[]" class="form-control mb-3" value="<%= pii.formName || '' %>" required>
													
													<div class="section-label">Number of Data Capture</div>
													<input type="text" name="formNo[]" class="form-control mb-3" value="<%= pii.formNo || '' %>" required>
													
													<div class="section-label">Data Processing</div>
													<select name="dataProcessing[]" class="form-select mb-3" required>
														<option value="" <%= !pii.dataProcessingValue ? 'selected' : '' %>>Select...</option>
														<% dataProcessingOptions.forEach(function(option) { %>
															<option value="<%= option %>" <%= pii.dataProcessingValue === option ? 'selected' : '' %>><%= option.replace('_', ' ') %></option>
														<% }); %>
													</select>

													<div class="section-label mt-auto">Recipient Users</div>
													<textarea name="recipientsUsers[]" class="form-control flex-grow-1" style="min-height: 80px; resize: vertical;" placeholder="Who receives this data?" required><%= pii.recipientsUsers || '' %></textarea>
												</div>
											</div>

											<!-- Card 2: Data Subjects -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Data Subjects
													</div>
													<div class="inner-card-desc mb-2">Subject information and contact details.</div>
													
													<div class="section-label">Subject Type</div>
													<select id="dataSubjectType" name="dataSubjectTypeId[]" class="form-select mb-3" required>
														<option value="" <%= !pii.dataSubjectsType_id ? 'selected' : '' %>>Select...</option>
														<% dataSubjectTypeOptions.forEach(function(typeOption) { %>
															<option value="<%= typeOption.id %>" <%= Number(pii.dataSubjectsType_id) === Number(typeOption.id) ? 'selected' : '' %>><%= typeOption.dataSubjectType %></option>
														<% }); %>
													</select>
													
													<div class="section-label">Name</div>
													<input type="text" id="dataSubjectName" name="dataSubjectName[]" class="form-control mb-3" value="<%= pii.dataSubjectName || '' %>" required>
													
													<div class="section-label">Email</div>
													<input type="email" id="dataSubjectEmail" name="dataSubjectEmail[]" class="form-control mb-3" value="<%= pii.dataSubjectEmail || '' %>" required>
													
													<div class="section-label mt-auto">Phone</div>
													<input type="tel" id="dataSubjectPhone" name="dataSubjectPhone[]" class="form-control" value="<%= pii.dataSubjectPhone || '' %>" required>
												</div>
											</div>

											<!-- Card 3: Processing Basis -->
											<div class="col-12 col-md-4">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Processing Basis
													</div>
													<div class="inner-card-desc mb-2">Legal basis for processing.</div>
													
													<div class="section-label">Basis Type</div>
													<select name="processingType[]" class="form-select mb-3" required>
														<option value="" <%= !pii.processingTypeValue ? 'selected' : '' %>>Select...</option>
														<% processingTypeOptions.forEach(function(option) { %>
															<option value="<%= option %>" <%= pii.processingTypeValue === option ? 'selected' : '' %>><%= option %></option>
														<% }); %>
													</select>
													
													<div class="section-label mt-auto">Number of Bases Used</div>
													<select name="basisNum[]" class="form-select" required>
														<option value="" <%= !pii.basisNumValue ? 'selected' : '' %>>Select...</option>
														<% basisOptions.forEach(function(option) { %>
															<option value="<%= option %>" <%= pii.basisNumValue === option ? 'selected' : '' %>><%= option %></option>
														<% }); %>
													</select>
												</div>
											</div>

											<!-- Card 4: Purpose of Processing -->
											<div class="col-12 col-md-8">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Purpose of Processing
													</div>
													<div class="inner-card-desc mb-2">Why is this data being processed?</div>
													
													<textarea name="purposeOfProcessing[]" class="form-control flex-grow-1" style="min-height: 80px; resize: vertical;" required><%= pii.purposeOfProcessing || '' %></textarea>
												</div>
											</div>
										</div>
									</div>
								</div>
								<% }); %>
								<% } else { %>
								<!-- Single Row Template (Empty) -->
								<div class="pdlc-row border-0 custom-card mb-4">
									<!-- Header (First Row Only) -->
									<div class="custom-header pdlc-main-header d-flex justify-content-between align-items-center flex-wrap gap-3">
										<div class="d-flex align-items-center">
											<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
												</div>
											<div>
												<h5 class="mb-0 custom-header-title">Section D - Personal Information Inventory</h5>
												<small class="text-muted">Inventory of personal data collected and processed.</small>
											</div>
										</div>
										<button type="button" id="addRowBtn"
											class="btn btn-primary btn-modern shadow-sm add-row-btn">
											<i class="bi bi-plus-lg me-1"></i> Add Row
										</button>
									</div>

									<!-- Sub-header -->
									<div class="sub-header-bar d-flex justify-content-between align-items-center py-3 px-4">
										<h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
											<i class="bi bi-arrow-repeat text-primary fs-5"></i>
											Personal Information <span class="badge bg-primary rounded-pill row-number ms-1">1</span>
										</h6>
										<div>
											<button type="button" class="btn btn-primary btn-sm me-2 add-row-btn shadow-sm d-none" title="Add a new Personal Info Row">
												<i class="bi bi-plus-lg"></i> Add Row
											</button>
											<button type="button" class="btn btn-sm btn-light text-secondary me-2 toggle-collapse-btn" title="Minimize/Maximize">
												<i class="bi bi-chevron-up"></i>
											</button>
											<button type="button" class="btn btn-outline-danger btn-sm remove-row-btn d-none">
												<i class="bi bi-trash3 me-1"></i> Remove Cycle
											</button>
										</div>
									</div>

									<div class="pdlc-row-body bg-white p-4">
										<div class="row g-4">
											<!-- Card 1: Data Capture & Recipients -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Data Capture & Recipients
													</div>
													<div class="inner-card-desc mb-2">Form details, processing type, and recipients.</div>
													
													<div class="section-label">Name of Data Capture</div>
													<input type="text" name="formName[]" class="form-control mb-3" required>
													
													<div class="section-label">Number of Data Capture</div>
													<input type="text" name="formNo[]" class="form-control mb-3" required>
													
													<div class="section-label">Data Processing</div>
													<select name="dataProcessing[]" class="form-select mb-3" required>
														<option value="">Select...</option>
														<% dataProcessingOptions.forEach(function(option) { %>
															<option value="<%= option %>"><%= option.replace('_', ' ') %></option>
														<% }); %>
													</select>

													<div class="section-label mt-auto">Recipient Users</div>
													<textarea name="recipientsUsers[]" class="form-control flex-grow-1" style="min-height: 80px; resize: vertical;" placeholder="Who receives this data?" required></textarea>
												</div>
											</div>

											<!-- Card 2: Data Subjects -->
											<div class="col-12 col-md-6">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Data Subjects
													</div>
													<div class="inner-card-desc mb-2">Subject information and contact details.</div>
													
													<div class="section-label">Subject Type</div>
													<select id="dataSubjectType" name="dataSubjectTypeId[]" class="form-select mb-3" required>
														<option value="">Select...</option>
														<% dataSubjectTypeOptions.forEach(function(typeOption) { %>
															<option value="<%= typeOption.id %>"><%= typeOption.dataSubjectType %></option>
														<% }); %>
													</select>
													
													<div class="section-label">Name</div>
													<input type="text" id="dataSubjectName" name="dataSubjectName[]" class="form-control mb-3" required>
													
													<div class="section-label">Email</div>
													<input type="email" id="dataSubjectEmail" name="dataSubjectEmail[]" class="form-control mb-3" required>
													
													<div class="section-label mt-auto">Phone</div>
													<input type="tel" id="dataSubjectPhone" name="dataSubjectPhone[]" class="form-control" required>
												</div>
											</div>

											<!-- Card 3: Processing Basis -->
											<div class="col-12 col-md-4">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Processing Basis
													</div>
													<div class="inner-card-desc mb-2">Legal basis for processing.</div>
													
													<div class="section-label">Basis Type</div>
													<select name="processingType[]" class="form-select mb-3" required>
														<option value="">Select...</option>
														<% processingTypeOptions.forEach(function(option) { %>
															<option value="<%= option %>"><%= option %></option>
														<% }); %>
													</select>
													
													<div class="section-label mt-auto">Number of Bases Used</div>
													<select name="basisNum[]" class="form-select" required>
														<option value="">Select...</option>
														<% basisOptions.forEach(function(option) { %>
															<option value="<%= option %>"><%= option %></option>
														<% }); %>
													</select>
												</div>
											</div>

											<!-- Card 4: Purpose of Processing -->
											<div class="col-12 col-md-8">
												<div class="inner-card d-flex flex-column h-100">
													<div class="inner-card-title">
														Purpose of Processing
													</div>
													<div class="inner-card-desc mb-2">Why is this data being processed?</div>
													
													<textarea name="purposeOfProcessing[]" class="form-control flex-grow-1" style="min-height: 80px; resize: vertical;" required></textarea>
												</div>
											</div>
										</div>
									</div>
								</div>
								<% } %>
						</div>
						</form>
					</div>
					<hr class="my-4 text-muted">
					<div class="mx-auto d-flex justify-content-between align-items-center mt-2" style="max-width: 1000px;">
							<a href="/assessment/processdatalifecycle?id=<%= assessmentId %>"
							class="btn btn-danger btn-modern shadow-sm">
							<i class="bi bi-arrow-left-short fs-5"></i> Previous Page
						</a>
						<span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill fw-medium">Step 4 of 5</span>
						<button type="submit" form="piiForm"
							class="btn btn-primary btn-modern shadow-sm">
							Next Page <i class="bi bi-arrow-right-short fs-5"></i>
						</button>
					</div>
				</main>
		</div>
</div>

<script>
	(function () {
		const container = document.getElementById('pdlcRowsContainer');
		if (!container) {
			return;
		}

		const createBlankValue = (element) => {
			if (element.tagName === 'SELECT') {
				element.selectedIndex = 0;
				return;
			}

			if (element.tagName === 'TEXTAREA' || element.tagName === 'INPUT') {
				element.value = '';
			}
		};

		const updateRowNumbers = () => {
			const rows = container.querySelectorAll('.pdlc-row');
			rows.forEach((row, index) => {
				const rowNumber = row.querySelector('.row-number');
				if (rowNumber) {
					rowNumber.textContent = String(index + 1);
				}

				const removeButton = row.querySelector('.remove-row-btn');
				if (removeButton) {
					removeButton.classList.toggle('d-none', index === 0);
				}

				const subHeaderAddBtn = row.querySelector('.sub-header-bar .add-row-btn');
				if (subHeaderAddBtn) {
					subHeaderAddBtn.classList.toggle('d-none', index === 0);
				}
			});
		};

		const validateRow = (row) => {
			const inputs = row.querySelectorAll('input, select, textarea');
			for (const input of inputs) {
				if (!input.value || input.value.trim() === '') {
					return false;
				}
			}
			return true;
		};

		document.addEventListener('click', function (event) {
			if (event.target.closest('.add-row-btn')) {
				event.preventDefault();

				const firstRow = container.querySelector('.pdlc-row');
				if (!firstRow) {
					return;
				}

				const newRow = firstRow.cloneNode(true);
				
				// Delete the dark blue main header from the cloned row
				const mainHeader = newRow.querySelector('.pdlc-main-header');
				if (mainHeader) mainHeader.remove();

				// Reset toggle state to open
				const body = newRow.querySelector('.pdlc-row-body');
				if (body) body.style.display = 'block';
				const toggleIcon = newRow.querySelector('.toggle-collapse-btn i');
				if (toggleIcon) {
					toggleIcon.classList.remove('bi-chevron-down');
					toggleIcon.classList.add('bi-chevron-up');
				}

				newRow.querySelectorAll('input, select, textarea').forEach(createBlankValue);
				const removeButton = newRow.querySelector('.remove-row-btn');
				if (removeButton) {
					removeButton.classList.remove('d-none');
				}

				container.appendChild(newRow);
				updateRowNumbers();
			}

			const removeButton = event.target.closest('.remove-row-btn');
			if (removeButton) {
				event.preventDefault();

				const row = removeButton.closest('.pdlc-row');
				if (row) {
					row.remove();
					updateRowNumbers();
				}
			}

			const toggleBtn = event.target.closest('.toggle-collapse-btn');
			if (toggleBtn) {
				const row = toggleBtn.closest('.pdlc-row');
				if (row) {
					const body = row.querySelector('.pdlc-row-body');
					const icon = toggleBtn.querySelector('i');
					if (body) {
						if (body.style.display === 'none') {
							body.style.display = 'block';
							icon.classList.remove('bi-chevron-down');
							icon.classList.add('bi-chevron-up');
						} else {
							body.style.display = 'none';
							icon.classList.remove('bi-chevron-up');
							icon.classList.add('bi-chevron-down');
						}
					}
				}
			}
		});

		const piiForm = document.getElementById('piiForm');
		if (piiForm) {
			piiForm.addEventListener('submit', function (e) {
				const rows = container.querySelectorAll('.pdlc-row');
				for (let i = 0; i < rows.length; i++) {
					if (!validateRow(rows[i])) {
						e.preventDefault();
						alert('Please complete all fields in every row before submitting.');
						return;
					}
				}
			});
		}

		updateRowNumbers();
	})();
</script>
