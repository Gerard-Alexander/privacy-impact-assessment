<header class="card border-0 shadow-sm fixed-topbar" style="border-bottom: 3px solid transparent; background: linear-gradient(90deg, #f8fafc 0%, #f1f5f9 100%); border-radius: 0 !important; margin-bottom: 0 !important;">

  <div class="card-body d-flex justify-content-between align-items-center px-4 py-3">

    <!-- Left: Logo + Title -->
    <div class="d-flex align-items-center gap-3">
      <img src="/images/slu-logo.svg" alt="SLU Logo" style="height: 40px; width: auto;">
      <div class="d-flex flex-column">
        <h2 class="h4 mb-0 fw-bold text-dark"><%= title %></h2>
        <small class="text-muted">Data Protection Office</small>
      </div>
    </div>

    <!-- Removed User Dropdown as requested -->
    <div></div>

  </div>
</header>

