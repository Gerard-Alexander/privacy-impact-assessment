<%- include('../layouts/head', { title: title }) %>
<div class="d-flex">
	<%- include('../layouts/sidebar', { activePage: activePage }) %>
	<div class="flex-grow-1 main-content-offset">
		<%- include('../layouts/topbar', { title: title, user: user }) %>
		<main class="container-fluid py-4 px-4">
			<%- include('../layouts/stepper', { currentStep: 3, dpsTitle: 'Data Processing System' ,
				authParties: 'Authorized Parties' , processDataCycle: 'Process Data LifeCycle' , user: user,
				piaAssessmentId: piaAssessmentId  }) %>
			<% if (error) { %>
			<div class="alert alert-danger mx-auto" style="max-width: 1000px;">
				<%= error %>
			</div>
			<% } %>
			<% if (success) { %>
				<div class="alert alert-success mx-auto" style="max-width: 1000px;">
					<%= success %>
				</div>
			<% } %>

			<div class="mx-auto" style="max-width: 850px;">
					<style>
					/* Premium Modern UI Enhancements */
					:root {
						--primary-color: #0f172a;
						--primary-light: #1e293b;
						--accent-color: #3b82f6;
						--accent-hover: #2563eb;
						--bg-soft: #f8fafc;
						--border-light: #e2e8f0;
						--text-muted: #64748b;
						--text-dark: #0f172a;
						--shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
						--shadow-md: 0 8px 16px rgba(0,0,0,0.04);
						--shadow-hover: 0 12px 24px rgba(59, 130, 246, 0.1);
						--glass-bg: rgba(255, 255, 255, 0.95);
					}

					.form-control, .form-select {
						border-radius: 0.75rem;
						border: 1px solid var(--border-light);
						padding: 0.85rem 1.2rem;
						font-size: 0.95rem;
						background-color: #ffffff;
						transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
						box-shadow: inset 0 2px 4px rgba(0,0,0,0.01);
					}
					.form-control:focus, .form-select:focus {
						border-color: var(--accent-color);
						box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
						background-color: #ffffff;
						outline: none;
					}
					textarea.form-control {
						line-height: 1.5;
					}
					.custom-card {
						border-radius: 1.25rem;
						background: var(--glass-bg);
						backdrop-filter: blur(10px);
						border: 1px solid var(--border-light);
						box-shadow: var(--shadow-md);
						overflow: hidden;
						animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
					}
					.custom-header {
						background: linear-gradient(135deg, rgba(13, 27, 75, 0.05) 0%, transparent 100%);
						border-bottom: 2px solid rgba(13, 27, 75, 0.1);
						padding: 1.5rem 2rem;
					}
					.custom-header-title {
						color: #0d1b4b; /* matching sidebar primary color */
						font-weight: 700;
						letter-spacing: -0.5px;
					}
					.btn-modern.btn-sm {
						padding: 0.4rem 1rem;
						font-size: 0.875rem;
						border-radius: 0.5rem;
					}
					.btn-modern {
						border-radius: 0.75rem;
						padding: 0.75rem 1.75rem;
						font-weight: 600;
						letter-spacing: 0.3px;
						transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
						display: inline-flex;
						align-items: center;
						justify-content: center;
						gap: 0.6rem;
						border: none;
					}
					.btn-primary.btn-modern {
						background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
						color: white;
						box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
					}
					.btn-primary.btn-modern:hover {
						transform: translateY(-2px);
						box-shadow: 0 8px 20px rgba(59, 130, 246, 0.35);
						background: linear-gradient(135deg, var(--accent-hover), #1d4ed8);
					}
					.btn-danger.btn-modern {
						background: #fff;
						color: #ef4444;
						border: 1px solid #fee2e2;
						box-shadow: var(--shadow-sm);
					}
					.btn-danger.btn-modern:hover {
						background: #fef2f2;
						border-color: #fca5a5;
						transform: translateY(-2px);
					}
					.inner-card {
						background: #ffffff;
						border: 1px solid var(--border-light);
						border-radius: 1rem;
						box-shadow: var(--shadow-sm);
						padding: 1rem;
						height: 100%;
						transition: all 0.3s ease;
					}
					.inner-card:hover {
						transform: translateY(-4px);
						box-shadow: var(--shadow-hover);
						border-color: rgba(59, 130, 246, 0.3);
					}
					.inner-card-title {
						font-size: 1.1rem;
						font-weight: 700;
						color: var(--text-dark);
						margin-bottom: 0.25rem;
						display: flex;
						align-items: center;
						gap: 0.5rem;
					}
					.inner-card-desc {
						font-size: 0.85rem;
						color: var(--text-muted);
						margin-bottom: 1.25rem;
					}
					.pdlc-subentry {
						background: var(--bg-soft);
						border: 1px dashed var(--border-light);
						border-radius: 0.75rem;
						padding: 1rem;
						margin-bottom: 0.75rem;
						transition: all 0.2s ease;
					}
					.pdlc-subentry:hover {
						border-color: rgba(59, 130, 246, 0.4);
						background: #f0f7ff;
					}
					.sub-header-bar {
						background: linear-gradient(90deg, #f8fafc, #ffffff);
						border-bottom: 1px solid var(--border-light);
					}
					@keyframes slideUpFade {
						from { opacity: 0; transform: translateY(20px); }
						to { opacity: 1; transform: translateY(0); }
					}
					.upload-box {
						border: 2px dashed var(--border-light);
						border-radius: 1rem;
						transition: all 0.3s ease;
						background: var(--bg-soft);
						position: relative;
						overflow: hidden;
						cursor: pointer;
					}
					.upload-box::before {
						content: '';
						position: absolute;
						top: 0; left: 0; right: 0; bottom: 0;
						background: var(--accent-color);
						opacity: 0;
						transition: opacity 0.3s ease;
					}
					.upload-box:hover {
						border-color: var(--accent-color);
						transform: scale(1.01);
					}
					.upload-box:hover::before {
						opacity: 0.03;
					}

					.section-label {
						font-weight: 600;
						color: var(--text-dark);
						font-size: 0.85rem;
						margin-bottom: 0.5rem;
						letter-spacing: 0.2px;
					}
					.btn-outline-primary, .btn-outline-danger {
						border-radius: 0.5rem;
						font-weight: 600;
					}
					</style>
				<form id="pdlcForm" action="/assessment/processdatalifecycle" method="POST" enctype="multipart/form-data">
					<input type="hidden" name="piaAssessment_id" value="<%= piaAssessmentId %>">
					<input type="hidden" name="piaAssessmentId" value="<%= piaAssessmentId %>">

					<div id="pdlcRowsContainer">
						<% if (typeof pdlcData !=='undefined' && pdlcData && pdlcData.length> 0) { %>
							<% pdlcData.forEach(function(pdlc, index) { %>
								<!-- Single Row Template (Populated) -->
								<div class="pdlc-row border-0 custom-card mb-4">
									<% if (index === 0) { %>
									<!-- Header (First Row Only) -->
									<div class="custom-header pdlc-main-header d-flex justify-content-between align-items-center flex-wrap gap-3">
										<div class="d-flex align-items-center">
											<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
												<i class="bi bi-diagram-3-fill fs-5"></i>
											</div>
											<div>
												<h5 class="mb-0 custom-header-title">Section A - Process Data Life Cycle</h5>
												<small class="text-muted">Data life cycle and processes.</small>
											</div>
										</div>
									</div>
									<% } %>

									<div class="sub-header-bar d-flex justify-content-between align-items-center py-3 px-4">
										<div class="d-flex align-items-center gap-3">
											<h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
												<i class="bi bi-arrow-repeat text-primary fs-5"></i>
												Lifecycle <span class="badge bg-primary rounded-pill row-number ms-1"><%= index + 1 %></span>
											</h6>
										</div>
										<div class="d-flex align-items-center gap-2">
											<button type="button" class="btn btn-primary btn-modern btn-sm shadow-sm add-row-btn" title="Add a new Lifecycle Row">
												<i class="bi bi-plus-lg me-1"></i> Add Row
											</button>
											<button type="button" class="btn btn-sm btn-light text-secondary toggle-collapse-btn" title="Minimize/Maximize">
												<i class="bi bi-chevron-up"></i>
											</button>
											<button type="button" class="btn btn-outline-danger btn-sm remove-row-btn <%= index === 0 ? 'd-none' : '' %>" title="Remove Cycle">
												<i class="bi bi-trash3"></i>
											</button>
										</div>
									</div>

									<div class="pdlc-row-body bg-white p-4">
										<div class="row g-4">

											<!-- 1. Stakeholders / Parties -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																<i class="bi bi-people text-primary"></i> Stakeholders / Parties
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">Who is involved in this process?</div>
														</div>
													</div>
													<div class="inner-card-body">
														<textarea name="stakeholderName[<%= index %>]" data-top-field="stakeholderName" class="form-control" style="min-height: 80px; resize: vertical;" placeholder="e.g. HR Department, Third-party vendors..."><%= pdlc.stakeholderName || '' %></textarea>
													</div>
												</div>
											</div>

											<!-- 2. Collection & Creation -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																Collection &amp; Creation
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">How is data collected or created?</div>
														</div>
														<button type="button" class="btn btn-sm btn-light text-secondary toggle-inner-collapse-btn py-0 px-2" title="Minimize/Maximize">
															<i class="bi bi-chevron-up"></i>
														</button>
													</div>
													<div class="inner-card-body">
														<div class="pdlc-collections">
															<% const collections = pdlc.collections && pdlc.collections.length ? pdlc.collections : [{}]; %>
															<% collections.forEach(function(entry, entryIndex) { %>
															<div class="pdlc-collection pdlc-subentry">
																<div class="row g-2">
																	<div class="col-12 col-md-8">
																		<textarea name="collections[<%= index %>][<%= entryIndex %>][collection]" data-field="collection" class="form-control" style="min-height: 50px; resize: vertical;" placeholder="e.g. Via online forms, paper documents..."><%= entry.collection || '' %></textarea>
																	</div>
																	<div class="col-12 col-md-4">
																		<div class="section-label mb-1">Remarks</div>
																		<input type="text" name="collections[<%= index %>][<%= entryIndex %>][collectionRemarks]" data-field="collectionRemarks" class="form-control mb-2" placeholder="e.g. Upon enrollment, annually..." value="<%= entry.collectionRemarks || '' %>">
																		<button type="button" class="btn btn-outline-danger btn-sm w-100 remove-subentry-btn <%= entryIndex === 0 ? 'd-none' : '' %>" data-section="collections">
																			<i class="bi bi-trash3 me-1"></i> Remove
																		</button>
																	</div>
																</div>
															</div>
															<% }); %>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-1 add-subentry-btn" data-section="collections">
															<i class="bi bi-plus-lg me-1"></i> Add Collection
														</button>
													</div>
												</div>
											</div>

											<!-- 3. Use / Processing -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																Use / Processing
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">How is the data used and processed?</div>
														</div>
														<button type="button" class="btn btn-sm btn-light text-secondary toggle-inner-collapse-btn py-0 px-2" title="Minimize/Maximize">
															<i class="bi bi-chevron-up"></i>
														</button>
													</div>
													<div class="inner-card-body">
														<div class="pdlc-uses">
															<% const uses = pdlc.uses && pdlc.uses.length ? pdlc.uses : [{}]; %>
															<% uses.forEach(function(entry, entryIndex) { %>
															<div class="pdlc-use pdlc-subentry">
																<div class="row g-2">
																	<div class="col-12">
																		<textarea name="uses[<%= index %>][<%= entryIndex %>][useOfData]" data-field="useOfData" class="form-control mb-2" style="min-height: 50px; resize: vertical;" placeholder="e.g. Used for payroll processing, analytics..."><%= entry.useOfData || '' %></textarea>
																	</div>
																	<div class="col-12">
																		<div class="text-end">
																			<button type="button" class="btn btn-outline-danger btn-sm remove-subentry-btn <%= entryIndex === 0 ? 'd-none' : '' %>" data-section="uses">
																				<i class="bi bi-trash3 me-1"></i> Remove
																			</button>
																		</div>
																	</div>
																</div>
															</div>
															<% }); %>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-1 add-subentry-btn" data-section="uses">
															<i class="bi bi-plus-lg me-1"></i> Add Use
														</button>
													</div>
												</div>
											</div>

											<!-- 4. Storage & Transmission -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																<i class="bi bi-server text-primary"></i> Storage &amp; Transmission
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">Where and how is the data stored or transmitted?</div>
														</div>
														<button type="button" class="btn btn-sm btn-light text-secondary toggle-inner-collapse-btn py-0 px-2" title="Minimize/Maximize">
															<i class="bi bi-chevron-up"></i>
														</button>
													</div>
													<div class="inner-card-body">
														<div class="pdlc-storages">
															<% const storages = pdlc.uses && pdlc.uses.length ? pdlc.uses : [{}]; %>
															<% storages.forEach(function(entry, entryIndex) { %>
															<div class="pdlc-storage pdlc-subentry">
																<div class="row g-2">
																	<div class="col-12">
																		<textarea name="uses[<%= index %>][<%= entryIndex %>][process]" data-field="process" class="form-control mb-2" style="min-height: 50px; resize: vertical;" placeholder="e.g. Stored in cloud DB, sent via encrypted email..."><%= entry.process || '' %></textarea>
																	</div>
																	<div class="col-12">
																		<div class="text-end">
																			<button type="button" class="btn btn-outline-danger btn-sm remove-subentry-btn <%= entryIndex === 0 ? 'd-none' : '' %>" data-section="storages">
																				<i class="bi bi-trash3 me-1"></i> Remove
																			</button>
																		</div>
																	</div>
																</div>
															</div>
															<% }); %>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-1 add-subentry-btn" data-section="storages">
															<i class="bi bi-plus-lg me-1"></i> Add Storage
														</button>
													</div>
												</div>
											</div>

											<!-- 5. Sharing -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																Sharing
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">How is the data being shared?</div>
														</div>
														<button type="button" class="btn btn-sm btn-light text-secondary toggle-inner-collapse-btn py-0 px-2" title="Minimize/Maximize">
															<i class="bi bi-chevron-up"></i>
														</button>
													</div>
													<div class="inner-card-body">
														<div class="pdlc-sharings">
															<% const sharings = pdlc.sharings && pdlc.sharings.length ? pdlc.sharings : [{}]; %>
															<% sharings.forEach(function(entry, entryIndex) { %>
															<div class="pdlc-sharing pdlc-subentry">
																<div class="row g-2">
																	<div class="col-12 col-md-6">
																		<textarea name="sharings[<%= index %>][<%= entryIndex %>][dataSharing]" data-field="dataSharing" class="form-control h-100" style="min-height: 50px; resize: vertical;" placeholder="e.g. Shared with external auditors, partners..."><%= entry.dataSharing || '' %></textarea>
																	</div>
																	<div class="col-12 col-md-6">
																		<div class="section-label mb-1">Who is it shared with?</div>
																		<textarea name="sharings[<%= index %>][<%= entryIndex %>][sharedTo]" data-field="sharedTo" class="form-control mb-2" style="min-height: 50px; resize: vertical;" placeholder="e.g. Third-party vendor"><%= entry.sharedTo || '' %></textarea>
																		<div class="text-end">
																			<button type="button" class="btn btn-outline-danger btn-sm remove-subentry-btn <%= entryIndex === 0 ? 'd-none' : '' %>" data-section="sharings">
																				<i class="bi bi-trash3 me-1"></i> Remove
																			</button>
																		</div>
																	</div>
																</div>
															</div>
															<% }); %>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-1 add-subentry-btn" data-section="sharings">
															<i class="bi bi-plus-lg me-1"></i> Add Sharing
														</button>
													</div>
												</div>
											</div>

											<!-- 6. Disposal & Destruction (LAST) — includes Retention Period -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																<i class="bi bi-trash3 text-primary"></i> Disposal &amp; Destruction
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">How and when is the data destroyed?</div>
														</div>
														<button type="button" class="btn btn-sm btn-light text-secondary toggle-inner-collapse-btn py-0 px-2" title="Minimize/Maximize">
															<i class="bi bi-chevron-up"></i>
														</button>
													</div>
													<div class="inner-card-body">
														<div class="section-label mb-1">Retention Period with Reckoning date/time (How long is the data retained?)</div>
														<textarea name="retentionPeriod[<%= index %>]" data-top-field="retentionPeriod" class="form-control mb-3" style="min-height: 80px; resize: vertical;" placeholder="e.g. 2 years after collection"><%= pdlc.retentionPeriod || '' %></textarea>

														<div class="section-label mb-1">Disposal Method</div>
														<textarea name="disposalMethod[<%= index %>]" data-top-field="disposalMethod" class="form-control mb-3" style="min-height: 80px; resize: vertical;" placeholder="e.g. Secure wiping after 5 years, physical shredding..."><%= pdlc.disposalMethod || '' %></textarea>

														<div class="section-label mt-2">Upload DLC Diagram</div>
														<input type="hidden" name="dlcDiagramPath[<%= index %>]" data-top-field="dlcDiagramPath" value="<%= pdlc.dlcDiagram || '' %>">
														<label class="upload-box p-3 text-center w-100 d-block mb-0">
															<input type="file" class="d-none" name="dlcDiagram[<%= index %>]" data-top-field="dlcDiagram" accept="image/jpeg,image/png,image/gif,image/webp" onchange="previewDlcDiagram(this)">
															<div class="text-muted">
																<span class="fw-semibold text-dark">Click to upload</span><br>
																<small style="font-size: 0.75rem;">PNG, JPG, GIF</small>
															</div>
															<img class="dlc-preview img-fluid mt-2 rounded <%= pdlc.dlcDiagram ? '' : 'd-none' %> shadow-sm" src="<%= pdlc.dlcDiagram ? `/${pdlc.dlcDiagram}` : '' %>">
														</label>
													</div>
												</div>
											</div>

										</div>
									</div>
								</div>
							<% }); %>
						<% } else { %>
								<!-- Single Row Template (Empty) -->
								<div class="pdlc-row border-0 custom-card mb-4">
									<!-- Header (First Row Only) -->
									<div class="custom-header pdlc-main-header d-flex justify-content-between align-items-center flex-wrap gap-3">
										<div class="d-flex align-items-center">
											<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
												<i class="bi bi-diagram-3-fill fs-5"></i>
											</div>
											<div>
												<h5 class="mb-0 custom-header-title">Section A - Process Data Life Cycle</h5>
												<small class="text-muted">Data life cycle and processes.</small>
											</div>
										</div>
									</div>

									<div class="sub-header-bar d-flex justify-content-between align-items-center py-3 px-4">
										<div class="d-flex align-items-center gap-3">
											<h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
												<i class="bi bi-arrow-repeat text-primary fs-5"></i>
												Lifecycle <span class="badge bg-primary rounded-pill row-number ms-1">1</span>
											</h6>
										</div>
										<div class="d-flex align-items-center gap-2">
											<button type="button" class="btn btn-primary btn-modern btn-sm shadow-sm add-row-btn" title="Add a new Lifecycle Row">
												<i class="bi bi-plus-lg me-1"></i> Add Row
											</button>
											<button type="button" class="btn btn-sm btn-light text-secondary toggle-collapse-btn" title="Minimize/Maximize">
												<i class="bi bi-chevron-up"></i>
											</button>
											<button type="button" class="btn btn-outline-danger btn-sm remove-row-btn d-none" title="Remove Cycle">
												<i class="bi bi-trash3"></i>
											</button>
										</div>
									</div>

									<div class="pdlc-row-body bg-white p-4">
										<div class="row g-4">

											<!-- 1. Stakeholders / Parties -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																<i class="bi bi-people text-primary"></i> Stakeholders / Parties
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">Who is involved in this process?</div>
														</div>
													</div>
													<div class="inner-card-body">
														<textarea name="stakeholderName[0]" data-top-field="stakeholderName" class="form-control" style="min-height: 80px; resize: vertical;" placeholder="e.g. HR Department, Third-party vendors..."></textarea>
													</div>
												</div>
											</div>

											<!-- 2. Collection & Creation -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																Collection &amp; Creation
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">How is data collected or created?</div>
														</div>
														<button type="button" class="btn btn-sm btn-light text-secondary toggle-inner-collapse-btn py-0 px-2" title="Minimize/Maximize">
															<i class="bi bi-chevron-up"></i>
														</button>
													</div>
													<div class="inner-card-body">
														<div class="pdlc-collections">
															<div class="pdlc-collection pdlc-subentry">
																<div class="row g-2">
																	<div class="col-12 col-md-8">
																		<textarea name="collections[0][0][collection]" data-field="collection" class="form-control" style="min-height: 50px; resize: vertical;" placeholder="e.g. Via online forms, paper documents..."></textarea>
																	</div>
																	<div class="col-12 col-md-4">
																		<div class="section-label mb-1">Remarks</div>
																		<input type="text" name="collections[0][0][collectionRemarks]" data-field="collectionRemarks" class="form-control mb-2" placeholder="e.g. Upon enrollment, annually...">
																		<button type="button" class="btn btn-outline-danger btn-sm w-100 remove-subentry-btn d-none" data-section="collections">
																			<i class="bi bi-trash3 me-1"></i> Remove
																		</button>
																	</div>
																</div>
															</div>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-1 add-subentry-btn" data-section="collections">
															<i class="bi bi-plus-lg me-1"></i> Add Collection
														</button>
													</div>
												</div>
											</div>

											<!-- 3. Use / Processing -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																Use / Processing
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">How is the data used and processed?</div>
														</div>
														<button type="button" class="btn btn-sm btn-light text-secondary toggle-inner-collapse-btn py-0 px-2" title="Minimize/Maximize">
															<i class="bi bi-chevron-up"></i>
														</button>
													</div>
													<div class="inner-card-body">
														<div class="pdlc-uses">
															<div class="pdlc-use pdlc-subentry">
																<div class="row g-2">
																	<div class="col-12">
																		<textarea name="uses[0][0][useOfData]" data-field="useOfData" class="form-control mb-2" style="min-height: 50px; resize: vertical;" placeholder="e.g. Used for payroll processing, analytics..."></textarea>
																	</div>
																	<div class="col-12">
																		<div class="text-end">
																			<button type="button" class="btn btn-outline-danger btn-sm remove-subentry-btn d-none" data-section="uses">
																				<i class="bi bi-trash3 me-1"></i> Remove
																			</button>
																		</div>
																	</div>
																</div>
															</div>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-1 add-subentry-btn" data-section="uses">
															<i class="bi bi-plus-lg me-1"></i> Add Use
														</button>
													</div>
												</div>
											</div>

											<!-- 4. Storage & Transmission -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																<i class="bi bi-server text-primary"></i> Storage &amp; Transmission
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">Where and how is the data stored or transmitted?</div>
														</div>
														<button type="button" class="btn btn-sm btn-light text-secondary toggle-inner-collapse-btn py-0 px-2" title="Minimize/Maximize">
															<i class="bi bi-chevron-up"></i>
														</button>
													</div>
													<div class="inner-card-body">
														<div class="pdlc-storages">
															<div class="pdlc-storage pdlc-subentry">
																<div class="row g-2">
																	<div class="col-12">
																		<textarea name="uses[0][0][process]" data-field="process" class="form-control mb-2" style="min-height: 50px; resize: vertical;" placeholder="e.g. Stored in cloud DB, sent via encrypted email..."></textarea>
																	</div>
																	<div class="col-12">
																		<div class="text-end">
																			<button type="button" class="btn btn-outline-danger btn-sm remove-subentry-btn d-none" data-section="storages">
																				<i class="bi bi-trash3 me-1"></i> Remove
																			</button>
																		</div>
																	</div>
																</div>
															</div>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-1 add-subentry-btn" data-section="storages">
															<i class="bi bi-plus-lg me-1"></i> Add Storage
														</button>
													</div>
												</div>
											</div>

											<!-- 5. Sharing -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																Sharing
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">How is the data being shared?</div>
														</div>
														<button type="button" class="btn btn-sm btn-light text-secondary toggle-inner-collapse-btn py-0 px-2" title="Minimize/Maximize">
															<i class="bi bi-chevron-up"></i>
														</button>
													</div>
													<div class="inner-card-body">
														<div class="pdlc-sharings">
															<div class="pdlc-sharing pdlc-subentry">
																<div class="row g-2">
																	<div class="col-12 col-md-6">
																		<textarea name="sharings[0][0][dataSharing]" data-field="dataSharing" class="form-control h-100" style="min-height: 50px; resize: vertical;" placeholder="e.g. Shared with external auditors, partners..."></textarea>
																	</div>
																	<div class="col-12 col-md-6">
																		<div class="section-label mb-1">Who is it shared with?</div>
																		<textarea name="sharings[0][0][sharedTo]" data-field="sharedTo" class="form-control mb-2" style="min-height: 50px; resize: vertical;" placeholder="e.g. Third-party vendor"></textarea>
																		<div class="text-end">
																			<button type="button" class="btn btn-outline-danger btn-sm remove-subentry-btn d-none" data-section="sharings">
																				<i class="bi bi-trash3 me-1"></i> Remove
																			</button>
																		</div>
																	</div>
																</div>
															</div>
														</div>
														<button type="button" class="btn btn-outline-primary btn-sm mt-1 add-subentry-btn" data-section="sharings">
															<i class="bi bi-plus-lg me-1"></i> Add Sharing
														</button>
													</div>
												</div>
											</div>

											<!-- 6. Disposal & Destruction (LAST) — includes Retention Period -->
											<div class="col-12">
												<div class="inner-card">
													<div class="d-flex justify-content-between align-items-center mb-3">
														<div>
															<div class="inner-card-title mb-0">
																<i class="bi bi-trash3 text-primary"></i> Disposal &amp; Destruction
															</div>
															<div class="inner-card-desc mb-0" style="margin-bottom:0 !important">How and when is the data destroyed?</div>
														</div>
														<button type="button" class="btn btn-sm btn-light text-secondary toggle-inner-collapse-btn py-0 px-2" title="Minimize/Maximize">
															<i class="bi bi-chevron-up"></i>
														</button>
													</div>
													<div class="inner-card-body">
														<div class="section-label mb-1">Retention Period with Reckoning date/time (How long is the data retained?)</div>
														<textarea name="retentionPeriod[0]" data-top-field="retentionPeriod" class="form-control mb-3" style="min-height: 80px; resize: vertical;" placeholder="e.g. 2 years after collection"></textarea>

														<div class="section-label mb-1">Disposal Method</div>
														<textarea name="disposalMethod[0]" data-top-field="disposalMethod" class="form-control mb-3" style="min-height: 80px; resize: vertical;" placeholder="e.g. Secure wiping after 5 years, physical shredding..."></textarea>

														<div class="section-label mt-2">Upload DLC Diagram</div>
														<input type="hidden" name="dlcDiagramPath[0]" data-top-field="dlcDiagramPath" value="">
														<label class="upload-box p-3 text-center w-100 d-block mb-0">
															<input type="file" class="d-none" name="dlcDiagram[0]" data-top-field="dlcDiagram" accept="image/jpeg,image/png,image/gif,image/webp" onchange="previewDlcDiagram(this)">
															<div class="text-muted">
																<span class="fw-semibold text-dark">Click to upload</span><br>
																<small style="font-size: 0.75rem;">PNG, JPG, GIF</small>
															</div>
															<img class="dlc-preview img-fluid mt-2 rounded d-none shadow-sm">
														</label>
													</div>
												</div>
											</div>

										</div>
									</div>
								</div>
						<% } %>
					</div>
					<hr class="my-4 text-muted">
					<div class="d-flex align-items-center justify-content-between mt-2">
						<button type="submit" name="redirectTo" value="previous" formnovalidate
							class="btn btn-danger btn-modern shadow-sm">
							<i class="bi bi-arrow-left-short fs-5"></i> Previous Page
						</button>
						<span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill fw-medium">Step 3 of 7</span>
						<button type="submit"
							class="btn btn-primary btn-modern shadow-sm">
							Next Page <i class="bi bi-arrow-right-short fs-5"></i>
						</button>
					</div>
				</form>

				<script>
					function previewDlcDiagram(input) {
						const file = input.files && input.files[0];
						if (!file) return;

						const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
						if (!allowedTypes.includes(file.type) || file.size > 5 * 1024 * 1024) {
							input.value = '';
							alert(file.size > 5 * 1024 * 1024
								? 'DLC diagrams must be 5 MB or smaller.'
								: 'Choose a JPG, PNG, GIF, or WebP image.');
							return;
						}

						const row = input.closest('.pdlc-row');
						const preview = row && row.querySelector('.dlc-preview');
						if (!preview) return;

						if (preview.dataset.objectUrl) URL.revokeObjectURL(preview.dataset.objectUrl);
						const objectUrl = URL.createObjectURL(file);
						preview.dataset.objectUrl = objectUrl;
						preview.src = objectUrl;
						preview.classList.remove('d-none');
					}

					document.addEventListener('DOMContentLoaded', function () {
						var container = document.getElementById('pdlcRowsContainer');
						var sectionConfig = {
							collections: { containerClass: 'pdlc-collections', entryClass: 'pdlc-collection' },
							uses: { containerClass: 'pdlc-uses', entryClass: 'pdlc-use' },
							storages: { containerClass: 'pdlc-storages', entryClass: 'pdlc-storage' },
							sharings: { containerClass: 'pdlc-sharings', entryClass: 'pdlc-sharing' }
						};

						function clearEntryInputs(entry) {
							var textareas = entry.querySelectorAll('textarea');
							for (var i = 0; i < textareas.length; i++) {
								textareas[i].value = '';
							}

							var inputs = entry.querySelectorAll('input[type="text"], input[type="date"], input[type="file"]');
							for (var j = 0; j < inputs.length; j++) {
								inputs[j].value = '';
							}

							var diagramPaths = entry.querySelectorAll('[data-top-field="dlcDiagramPath"]');
							for (var k = 0; k < diagramPaths.length; k++) {
								diagramPaths[k].value = '';
							}

							var previews = entry.querySelectorAll('.dlc-preview');
							for (var p = 0; p < previews.length; p++) {
								if (previews[p].dataset.objectUrl) URL.revokeObjectURL(previews[p].dataset.objectUrl);
								previews[p].removeAttribute('src');
								previews[p].classList.add('d-none');
							}
						}

						function updateRowNumbers() {
							var rows = container.querySelectorAll('.pdlc-row');
							for (var i = 0; i < rows.length; i++) {
								var row = rows[i];
								var numSpan = row.querySelector('.row-number');
								if (numSpan) {
									numSpan.textContent = i + 1;
								}

								var removeBtn = row.querySelector('.remove-row-btn');
								if (removeBtn) {
									// Never allow deleting the very first row
									if (i > 0) {
										removeBtn.classList.remove('d-none');
										removeBtn.style.display = '';
									} else {
										removeBtn.classList.add('d-none');
										removeBtn.style.display = 'none';
									}
								}

							}
						}

						function updateSubEntryButtons(row) {
							Object.keys(sectionConfig).forEach(function (section) {
								var config = sectionConfig[section];
								var containerEl = row.querySelector('.' + config.containerClass);
								if (!containerEl) return;
								var entries = containerEl.querySelectorAll('.' + config.entryClass);
								for (var i = 0; i < entries.length; i++) {
									var removeBtn = entries[i].querySelector('.remove-subentry-btn');
									if (!removeBtn) continue;
									if (entries.length > 1) {
										removeBtn.classList.remove('d-none');
									} else {
										removeBtn.classList.add('d-none');
									}
								}
							});
						}

						function updateAllNames() {
							var rows = container.querySelectorAll('.pdlc-row');
							for (var i = 0; i < rows.length; i++) {
								var row = rows[i];
								var topFields = row.querySelectorAll('[data-top-field]');
								for (var j = 0; j < topFields.length; j++) {
									var field = topFields[j].getAttribute('data-top-field');
									topFields[j].name = field + '[' + i + ']';
								}

								Object.keys(sectionConfig).forEach(function (section) {
									var config = sectionConfig[section];
									var containerEl = row.querySelector('.' + config.containerClass);
									if (!containerEl) return;
									var entries = containerEl.querySelectorAll('.' + config.entryClass);
									for (var entryIndex = 0; entryIndex < entries.length; entryIndex++) {
										var inputs = entries[entryIndex].querySelectorAll('[data-field]');
										for (var k = 0; k < inputs.length; k++) {
											var fieldName = inputs[k].getAttribute('data-field');
											inputs[k].name = section + '[' + i + '][' + entryIndex + '][' + fieldName + ']';
										}
									}
								});
							}
						}

						// Attach listener safely by delegating to container just in case it takes time to render
						document.addEventListener('click', function (e) {
							if (e.target.closest('.add-row-btn')) {
								var rows = container.querySelectorAll('.pdlc-row');
								if (rows.length === 0) return;

								var firstRow = rows[0];
								var newRow = firstRow.cloneNode(true);

								// Delete the dark blue main header from the cloned row
								var mainHeader = newRow.querySelector('.pdlc-main-header');
								if (mainHeader) mainHeader.remove();

								// Reset toggle state to open
								var body = newRow.querySelector('.pdlc-row-body');
								if (body) body.style.display = 'block';
								var toggleIcon = newRow.querySelector('.toggle-collapse-btn i');
								if (toggleIcon) {
									toggleIcon.classList.remove('bi-chevron-down');
									toggleIcon.classList.add('bi-chevron-up');
								}

								// Reset inner toggle states to open
								var innerBodies = newRow.querySelectorAll('.inner-card-body');
								for (var b = 0; b < innerBodies.length; b++) {
									innerBodies[b].style.display = 'block';
								}
								var innerToggleIcons = newRow.querySelectorAll('.toggle-inner-collapse-btn i');
								for (var ti = 0; ti < innerToggleIcons.length; ti++) {
									innerToggleIcons[ti].classList.remove('bi-chevron-down');
									innerToggleIcons[ti].classList.add('bi-chevron-up');
								}

								// Reset values and keep only one sub-entry per section
								clearEntryInputs(newRow);
								Object.keys(sectionConfig).forEach(function (section) {
									var config = sectionConfig[section];
									var containerEl = newRow.querySelector('.' + config.containerClass);
									if (!containerEl) return;
									var entries = containerEl.querySelectorAll('.' + config.entryClass);
									for (var i = entries.length - 1; i >= 1; i--) {
										entries[i].parentNode.removeChild(entries[i]);
									}
									if (entries[0]) {
										clearEntryInputs(entries[0]);
									}
								});

								container.appendChild(newRow);
								updateRowNumbers();
								updateAllNames();
								updateSubEntryButtons(newRow);
							}
						});

						container.addEventListener('click', function (e) {
							var toggleInnerBtn = e.target.closest('.toggle-inner-collapse-btn');
							if (toggleInnerBtn) {
								var innerCard = toggleInnerBtn.closest('.inner-card');
								if (innerCard) {
									var innerBody = innerCard.querySelector('.inner-card-body');
									var innerIcon = toggleInnerBtn.querySelector('i');
									if (innerBody) {
										if (innerBody.style.display === 'none') {
											innerBody.style.display = 'block';
											innerIcon.classList.remove('bi-chevron-down');
											innerIcon.classList.add('bi-chevron-up');
										} else {
											innerBody.style.display = 'none';
											innerIcon.classList.remove('bi-chevron-up');
											innerIcon.classList.add('bi-chevron-down');
										}
									}
								}
							}

							var toggleBtn = e.target.closest('.toggle-collapse-btn');
							if (toggleBtn) {
								var row = toggleBtn.closest('.pdlc-row');
								if (row) {
									var body = row.querySelector('.pdlc-row-body');
									var icon = toggleBtn.querySelector('i');
									if (body) {
										if (body.style.display === 'none') {
											body.style.display = 'block';
											icon.classList.remove('bi-chevron-down');
											icon.classList.add('bi-chevron-up');
										} else {
											body.style.display = 'none';
											icon.classList.remove('bi-chevron-up');
											icon.classList.add('bi-chevron-down');
										}
									}
								}
							}

							var removeBtn = e.target.closest('.remove-row-btn');
							if (removeBtn) {
								var row = removeBtn.closest('.pdlc-row');
								if (row) {
									row.parentNode.removeChild(row);
									updateRowNumbers();
									updateAllNames();
								}
							}

							var addSubBtn = e.target.closest('.add-subentry-btn');
							if (addSubBtn) {
								var section = addSubBtn.getAttribute('data-section');
								var config = sectionConfig[section];
								if (!config) return;
								var row = addSubBtn.closest('.pdlc-row');
								if (!row) return;
								var containerEl = row.querySelector('.' + config.containerClass);
								if (!containerEl) return;
								var firstEntry = containerEl.querySelector('.' + config.entryClass);
								if (!firstEntry) return;
								var newEntry = firstEntry.cloneNode(true);
								clearEntryInputs(newEntry);
								containerEl.appendChild(newEntry);
								updateSubEntryButtons(row);
								updateAllNames();
							}

							var removeSubBtn = e.target.closest('.remove-subentry-btn');
							if (removeSubBtn) {
								var removeSection = removeSubBtn.getAttribute('data-section');
								var removeConfig = sectionConfig[removeSection];
								if (!removeConfig) return;
								var removeRow = removeSubBtn.closest('.pdlc-row');
								if (!removeRow) return;
								var removeEntry = removeSubBtn.closest('.' + removeConfig.entryClass);
								if (removeEntry) {
									var entryContainer = removeRow.querySelector('.' + removeConfig.containerClass);
									if (entryContainer && entryContainer.querySelectorAll('.' + removeConfig.entryClass).length > 1) {
										entryContainer.removeChild(removeEntry);
										updateSubEntryButtons(removeRow);
										updateAllNames();
									}
								}
							}
						});

						// Run on initial load to ensure state is correct
						updateRowNumbers();
						updateAllNames();
						var initRows = container.querySelectorAll('.pdlc-row');
						for (var r = 0; r < initRows.length; r++) {
							updateSubEntryButtons(initRows[r]);
						}
					});
				</script>
			</div>
		</main>
	</div>
</div>