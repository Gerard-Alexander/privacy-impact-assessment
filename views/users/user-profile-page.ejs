<%- include('../layouts/head', { title: title }) %>

<div class="d-flex">
  <!-- SIDEBAR -->
  <%- include('../layouts/sidebar', { activePage: 'profile' }) %>
  
  <!-- MAIN AREA -->
  <div class="flex-grow-1 main-content-offset">
    <!-- TOPBAR -->
    <%- include('../layouts/topbar', { title: title, user: user }) %>

    <!-- PAGE CONTENT -->
    <main class="container-fluid py-4">
        <div class="row justify-content-center">
            <div class="col-lg-11">
                
                <!-- Simple Header -->
                <div class="d-flex align-items-center gap-3 mb-4 ps-1">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm"
                         style="width: 64px; height: 64px; font-size: 1.5rem;">
                        <%= (user.firstName && user.lastName) ? (user.firstName[0] + user.lastName[0]).toUpperCase() : user.userName[0].toUpperCase() %>
                    </div>
                    <div>
                        <h2 class="fw-bold mb-0 text-dark">Account Profile</h2>
                        <p class="text-muted mb-0">Manage your personal information and system settings.</p>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Account Details Card -->
                    <div class="col-md-8">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-white py-3 border-bottom border-light">
                                <h5 class="fw-bold mb-0 text-primary">Account Details</h5>
                            </div>
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="row g-4 flex-grow-1">
                                    <div class="col-sm-6">
                                        <label class="small text-muted text-uppercase fw-bold mb-1 d-block">Full Name</label>
                                        <p class="fw-semibold text-dark mb-0 fs-5"><%= user.firstName %> <%= user.lastName %></p>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="small text-muted text-uppercase fw-bold mb-1 d-block">Username</label>
                                        <p class="text-dark mb-0 fs-5">@<%= user.userName %></p>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="small text-muted text-uppercase fw-bold mb-1 d-block">Email Address</label>
                                        <p class="text-dark mb-0 fs-5"><%= user.emailAddress %></p>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="small text-muted text-uppercase fw-bold mb-1 d-block">System Role</label>
                                        <p class="mb-0">
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold">
                                                <%= user.role %>
                                            </span>
                                        </p>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="small text-muted text-uppercase fw-bold mb-1 d-block">Unit</label>
                                        <p class="text-dark mb-0 fs-5"><%= user.units || 'n/a' %></p>
                                    </div>
                                    <div class="col-12 mt-4 pt-3 border-top border-light">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <label class="small text-muted text-uppercase fw-bold mb-0 d-block">Account Created</label>
                                                <p class="text-muted mb-0 small"><%= new Date(user.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                                            </div>
                                            <a href="/user-profile/edit" class="btn btn-outline-primary btn-sm px-4 rounded-pill">
                                                <i class="bi bi-pencil me-1"></i> Edit Profile
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Action Card -->
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-white py-3 border-bottom border-light">
                                <h5 class="fw-bold mb-0 text-dark">Quick Actions</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="d-grid gap-3">
                                    <a href="/assessment" class="d-flex align-items-center p-3 rounded-3 border border-light text-decoration-none hover-action shadow-sm-hover transition-all">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3">
                                            <i class="bi bi-plus-lg fs-5"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="fw-bold text-dark mb-0">New Assessment</h6>
                                            <small class="text-muted">Start a new PIA form</small>
                                        </div>
                                        <i class="bi bi-chevron-right text-muted opacity-50"></i>
                                    </a>

                                    <a href="/dashboard/all" class="d-flex align-items-center p-3 rounded-3 border border-light text-decoration-none hover-action shadow-sm-hover transition-all">
                                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 me-3">
                                            <i class="bi bi-collection-fill fs-5"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="fw-bold text-dark mb-0">My Records</h6>
                                            <small class="text-muted">View your submissions</small>
                                        </div>
                                        <i class="bi bi-chevron-right text-muted opacity-50"></i>
                                    </a>

                                    <a href="/logout" class="d-flex align-items-center p-3 rounded-3 border border-light text-decoration-none hover-action-danger shadow-sm-hover transition-all">
                                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-2 me-3">
                                            <i class="bi bi-box-arrow-right fs-5"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="fw-bold text-dark mb-0">Sign Out</h6>
                                            <small class="text-muted">End your session</small>
                                        </div>
                                        <i class="bi bi-chevron-right text-muted opacity-50"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>
  </div>
</div>

<style>
    .main-content-offset {
        background-color: #f1f5f9;
        min-height: 100vh;
    }
    .hover-action {
        background-color: white;
    }
    .hover-action:hover {
        background-color: rgba(13, 110, 253, 0.02);
        border-color: #0d6efd !important;
        transform: translateY(-2px);
    }
    .hover-action-danger:hover {
        background-color: rgba(220, 53, 69, 0.02);
        border-color: #dc3545 !important;
        transform: translateY(-2px);
    }
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
    .shadow-sm-hover:hover {
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.075)!important;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>