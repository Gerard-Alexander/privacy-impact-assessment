<%- include('../layouts/head', { title: title }) %>
<div class="d-flex">
	<%- include('../layouts/sidebar', { activePage: activePage }) %>
	<div class="flex-grow-1 main-content-offset">
		<%- include('../layouts/topbar', { title: title, user: user }) %>
		<main class="container-fluid py-4 px-4">
			<%- include('../layouts/stepper', { currentStep: 3, dpsTitle: 'Data Processing System' ,
				authParties: 'Authorized Parties' , processDataCycle: 'Process Data LifeCycle' , user: user
			}) %>
			<% if (error) { %>
			<div class="alert alert-danger mx-auto" style="max-width: 1000px;">
				<%= error %>
			</div>
			<% } %>
			<% if (success) { %>
				<div class="alert alert-success mx-auto" style="max-width: 1000px;">
					<%= success %>
				</div>
			<% } %>

			<div class="mx-auto" style="max-width: 1000px;">
					<style>
					/* Modern UI Enhancements */
					.form-floating > .form-control:focus ~ label,
					.form-floating > .form-control:not(:placeholder-shown) ~ label,
					.form-floating > .form-select ~ label {
						color: var(--bs-primary);
						font-weight: 600;
					}
					.form-control, .form-select {
						border-radius: 0.5rem;
						border: 1px solid #dee2e6;
						padding: 0.75rem 1rem;
						transition: all 0.2s ease-in-out;
					}
					.form-control:focus, .form-select:focus {
						border-color: var(--bs-primary);
						box-shadow: 0 0 0 0.25rem rgba(13, 27, 75, 0.1);
					}
					.custom-card {
						border-radius: 1rem;
						background: #ffffff;
						box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
						overflow: hidden;
						animation: fadeIn 0.5s ease-out;
					}
					.custom-header {
						background: linear-gradient(135deg, rgba(13, 27, 75, 0.05) 0%, transparent 100%);
						border-bottom: 2px solid rgba(13, 27, 75, 0.1);
						padding: 1.5rem 2rem;
					}
					.custom-header-title {
						color: #0d1b4b; /* matching sidebar primary color */
						font-weight: 700;
						letter-spacing: -0.5px;
					}
					.btn-modern {
						border-radius: 0.5rem;
						padding: 0.6rem 1.5rem;
						font-weight: 600;
						transition: all 0.3s ease;
						display: inline-flex;
						align-items: center;
						gap: 0.5rem;
					}
					.btn-modern:hover {
						transform: translateY(-2px);
						box-shadow: 0 5px 15px rgba(13, 27, 75, 0.2);
					}
					@keyframes fadeIn {
						from { opacity: 0; transform: translateY(10px); }
						to { opacity: 1; transform: translateY(0); }
					}
					.form-section {
						padding: 2rem;
					}
					.upload-box {
						border: 2px dashed #dee2e6;
						border-radius: 0.75rem;
						transition: all 0.2s ease;
					}
					.upload-box:hover {
						border-color: var(--bs-primary);
						background-color: rgba(13, 27, 75, 0.02);
					}
					</style>
				<form id="pdlcForm" action="/assessment/processdatalifecycle"
					method="POST">
					<input type="hidden" name="piaAssessment_id"
						value="<%= piaAssessmentId %>">

					<div id="pdlcRowsContainer">
						<% if (typeof pdlcData !=='undefined' && pdlcData &&
							pdlcData.length> 0) { %>
							<% pdlcData.forEach(function(pdlc, index) { %>
								<!-- Single Row Template (Populated) -->
								<div class="pdlc-row card border-0 custom-card mb-4">
									<% if (index === 0) { %>
									<!-- Header (First Row Only) -->
									<div class="custom-header pdlc-main-header d-flex justify-content-between align-items-center">
										<div class="d-flex align-items-center">
											<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
												<i class="bi bi-diagram-3-fill fs-5"></i>
											</div>
											<div>
												<h5 class="mb-0 custom-header-title">Section A - Process Data Life Cycle</h5>
												<small class="text-muted">Data life cycle and processes.</small>
											</div>
										</div>
										<button type="button" id="addRowBtn"
											class="btn btn-primary btn-modern shadow-sm">
											<i class="bi bi-plus-circle me-1"></i> Add Row
										</button>
									</div>
									<% } %>

									<!-- Sub-header -->
									<div class="card-body text-black shadow-sm d-flex justify-content-between align-items-center py-2 px-4"
										style="background-color: #c8ddf7;">
										<h6 class="fw-bold mb-0">Lifecycle Cycle
											<span class="row-number">
												<%= index + 1 %>
											</span></h6>
										<button type="button"
											class="btn btn-danger btn-sm py-1 remove-row-btn <%= index === 0 ? 'd-none' : '' %>">
											<i class="bi bi-trash me-1"></i> Remove
										</button>
									</div>

									<div class="card-body bg-white pb-4">
										<div class="row g-4">
											<!-- Card 1 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Stakeholders / Parties Involved</div>
													</div>
													<div class="small text-muted mb-3 d-block">Who is involved in this process?</div>
													<textarea name="stakeholderName[<%= index %>]" data-top-field="stakeholderName" class="form-control" style="min-height: 100px; resize: vertical;" placeholder="e.g. HR Department, Third-party vendors..." required><%= pdlc.stakeholderName || '' %></textarea>
												</div>
											</div>
											<!-- Card 2 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Collection & Creation</div>
													</div>
													<div class="small text-muted mb-2 d-block">How is data collected or created?</div>
													<div class="pdlc-collections">
														<% const collections = pdlc.collections && pdlc.collections.length ? pdlc.collections : [{}]; %>
														<% collections.forEach(function(entry, entryIndex) { %>
														<div class="pdlc-collection border rounded-3 p-3 mb-3">
															<textarea name="collections[<%= index %>][<%= entryIndex %>][collection]" data-field="collection" class="form-control mb-3" style="min-height: 70px; resize: vertical;" placeholder="e.g. Via online forms, paper documents..." required><%= entry.collection || '' %></textarea>
															<div class="fw-bold text-dark small mb-1">Indicate Date</div>
															<input type="date" name="collections[<%= index %>][<%= entryIndex %>][dateCollected]" data-field="dateCollected" class="form-control form-control-sm" value="<%= entry.dateCollected ? new Date(entry.dateCollected).toISOString().split('T')[0] : '' %>" required>
															<button type="button" class="btn btn-outline-danger btn-sm mt-3 remove-subentry-btn <%= entryIndex === 0 ? 'd-none' : '' %>" data-section="collections">
																<i class="bi bi-trash me-1"></i> Remove
															</button>
														</div>
														<% }); %>
													</div>
													<button type="button" class="btn btn-outline-primary btn-sm add-subentry-btn" data-section="collections">
														<i class="bi bi-plus-circle me-1"></i> Add Collection
													</button>
												</div>
											</div>
											<!-- Card 3 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Use / Processing</div>
													</div>
													<div class="small text-muted mb-3 d-block">How is the data used and processed?</div>
													<div class="pdlc-uses">
														<% const uses = pdlc.uses && pdlc.uses.length ? pdlc.uses : [{}]; %>
														<% uses.forEach(function(entry, entryIndex) { %>
														<div class="pdlc-use border rounded-3 p-3 mb-3">
															<textarea name="uses[<%= index %>][<%= entryIndex %>][useOfData]" data-field="useOfData" class="form-control mb-3" style="min-height: 70px; resize: vertical;" placeholder="e.g. Used for payroll processing, analytics..." required><%= entry.useOfData || '' %></textarea>
															<div class="fw-bold text-dark small mb-1">Storage & Transmission</div>
															<textarea name="uses[<%= index %>][<%= entryIndex %>][process]" data-field="process" class="form-control" style="min-height: 70px; resize: vertical;" placeholder="e.g. Stored in cloud DB, sent via encrypted email..." required><%= entry.process || '' %></textarea>
															<button type="button" class="btn btn-outline-danger btn-sm mt-3 remove-subentry-btn <%= entryIndex === 0 ? 'd-none' : '' %>" data-section="uses">
																<i class="bi bi-trash me-1"></i> Remove
															</button>
														</div>
														<% }); %>
													</div>
													<button type="button" class="btn btn-outline-primary btn-sm add-subentry-btn" data-section="uses">
														<i class="bi bi-plus-circle me-1"></i> Add Use
													</button>
												</div>
											</div>
											<!-- Card 4 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Retention</div>
													</div>
													<div class="small text-muted mb-2 d-block">How long is the data retained?</div>
													<div class="fw-bold text-dark small mb-1">Retention Period</div>
													<input type="text" name="retentionPeriod[<%= index %>]" data-top-field="retentionPeriod" class="form-control form-control-sm mb-3" placeholder="e.g. 2 years after collection" value="<%= pdlc.retentionPeriod || '' %>" required>
												
													<div class="fw-bold text-dark small mb-1">Indicate Date</div>
													<input type="date" name="retentionDate[<%= index %>]" data-top-field="retentionDate" class="form-control form-control-sm" value="<%= pdlc.retentionDate ? new Date(pdlc.retentionDate).toISOString().split('T')[0] : '' %>" required>
												</div>
											</div>
											<!-- Card 5 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Sharing</div>
													</div>
													<div class="small text-muted mb-3 d-block">How is the data being shared?</div>
													<div class="pdlc-sharings">
														<% const sharings = pdlc.sharings && pdlc.sharings.length ? pdlc.sharings : [{}]; %>
														<% sharings.forEach(function(entry, entryIndex) { %>
														<div class="pdlc-sharing border rounded-3 p-3 mb-3">
															<textarea name="sharings[<%= index %>][<%= entryIndex %>][dataSharing]" data-field="dataSharing" class="form-control mb-3" style="min-height: 70px; resize: vertical;" placeholder="e.g. Shared with external auditors, partners..." required><%= entry.dataSharing || '' %></textarea>
															<div class="small text-muted mb-2 d-block">Who is it shared?</div>
															<textarea name="sharings[<%= index %>][<%= entryIndex %>][sharedTo]" data-field="sharedTo" class="form-control" style="min-height: 70px; resize: vertical;" placeholder="e.g. Shared with external auditors, partners..." required><%= entry.sharedTo || '' %></textarea>
															<button type="button" class="btn btn-outline-danger btn-sm mt-3 remove-subentry-btn <%= entryIndex === 0 ? 'd-none' : '' %>" data-section="sharings">
																<i class="bi bi-trash me-1"></i> Remove
															</button>
														</div>
														<% }); %>
													</div>
													<button type="button" class="btn btn-outline-primary btn-sm add-subentry-btn" data-section="sharings">
														<i class="bi bi-plus-circle me-1"></i> Add Sharing
													</button>
												</div>
											</div>
											<!-- Card 6 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Disposal & Destruction</div>
													</div>
													<div class="small text-muted mb-2 d-block">How and when is the data destroyed?</div>
													<textarea name="disposalMethod[<%= index %>]" data-top-field="disposalMethod" class="form-control mb-3" style="min-height: 70px; resize: vertical;" placeholder="e.g. Secure wiping after 5 years, physical shredding..." required><%= pdlc.disposalMethod || '' %></textarea>
													
													<div class="mb-3">
														<label class="fw-bold text-dark m-0 form-label">Upload DLC Diagram</label>
														<label class="border border-2 border-dashed rounded p-4 text-center w-100 bg-light position-relative" style="cursor: pointer;">
															<input type="file" class="d-none"
																	name="dlcDiagram[<%= index %>]"
																	data-top-field="dlcDiagram"
																		accept=".jpg,.png,.jpeg,.gif,.pdf"
																		onchange="previewSig(this,'head-preview')">
																		<div class="text-muted">
																			<i class="bi bi-cloud-upload fs-3 d-block mb-2"></i>
																			<span class="fw-semibold">Click to upload</span><br>
																			<small>PNG, JPG, PDF allowed</small>
																		</div>
															<img id="head-preview" class="img-fluid mt-3 rounded d-none">
														</label>
													</div>																				</div>
											</div>
										</div>
									</div>
								</div>
								<% }); %>
								<% } else { %>
								<!-- Single Row Template (Empty) -->
								<div class="pdlc-row card border-0 custom-card mb-4">
									<!-- Header (First Row Only) -->
									<div class="custom-header pdlc-main-header d-flex justify-content-between align-items-center">
										<div class="d-flex align-items-center">
											<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
												<i class="bi bi-diagram-3-fill fs-5"></i>
											</div>
											<div>
												<h5 class="mb-0 custom-header-title">Section A - Process Data Life Cycle</h5>
												<small class="text-muted">Data life cycle and processes.</small>
											</div>
										</div>
										<button type="button" id="addRowBtn"
											class="btn btn-primary btn-modern shadow-sm">
											<i class="bi bi-plus-circle me-1"></i> Add Row
										</button>
									</div>
									<!-- Sub-header -->
									<div class="card-body text-black shadow-sm d-flex justify-content-between align-items-center py-2 px-4"
										style="background-color: #c8ddf7;">
										<h6 class="fw-bold mb-0">Lifecycle Cycle<span class="row-number">1</span></h6>
										<button type="button" class="btn btn-danger btn-sm py-1 remove-row-btn d-none">
											<i class="bi bi-trash me-1"></i> Remove
										</button>
									</div>
									<div class="card-body bg-white pb-4">
										<div class="row g-4">
											<!-- Card 1 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Stakeholders / Parties Involved</div>
													</div>
													<div class="small text-muted mb-3 d-block">Who is involved in this process?</div>
													<textarea name="stakeholderName[0]" data-top-field="stakeholderName" class="form-control" style="min-height: 100px; resize: vertical;" placeholder="e.g. HR Department, Third-party vendors..." required></textarea>
												</div>
											</div>
											<!-- Card 2 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Collection & Creation</div>
													</div>
													<div class="small text-muted mb-2 d-block">How is data collected or created?</div>
													<div class="pdlc-collections">
														<div class="pdlc-collection border rounded-3 p-3 mb-3">
															<textarea name="collections[0][0][collection]" data-field="collection" class="form-control mb-3" style="min-height: 70px; resize: vertical;" placeholder="e.g. Via online forms, paper documents..." required></textarea>
															<div class="fw-bold text-dark small mb-1">Indicate Date / Timing</div>
															<input type="date" name="collections[0][0][dateCollected]" data-field="dateCollected" class="form-control form-control-sm" placeholder="e.g. Upon submission of form" required>
															<button type="button" class="btn btn-outline-danger btn-sm mt-3 remove-subentry-btn d-none" data-section="collections">
																<i class="bi bi-trash me-1"></i> Remove
															</button>
														</div>
													</div>
													<button type="button" class="btn btn-outline-primary btn-sm add-subentry-btn" data-section="collections">
														<i class="bi bi-plus-circle me-1"></i> Add Collection
													</button>
												</div>
											</div>
											<!-- Card 3 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Use / Processing</div>
													</div>
													<div class="small text-muted mb-3 d-block">How is the data used and processed?</div>
													<div class="pdlc-uses">
														<div class="pdlc-use border rounded-3 p-3 mb-3">
															<textarea name="uses[0][0][useOfData]" data-field="useOfData" class="form-control mb-3" style="min-height: 70px; resize: vertical;" placeholder="e.g. Used for payroll processing, analytics..." required></textarea>
															<div class="fw-bold text-dark small mb-1">Storage & Transmission</div>
															<textarea name="uses[0][0][process]" data-field="process" class="form-control" style="min-height: 70px; resize: vertical;" placeholder="e.g. Stored in cloud DB, sent via encrypted email..." required></textarea>
															<button type="button" class="btn btn-outline-danger btn-sm mt-3 remove-subentry-btn d-none" data-section="uses">
																<i class="bi bi-trash me-1"></i> Remove
															</button>
														</div>
													</div>
													<button type="button" class="btn btn-outline-primary btn-sm add-subentry-btn" data-section="uses">
														<i class="bi bi-plus-circle me-1"></i> Add Use
													</button>
												</div>
											</div>
											<!-- Card 4 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Retention</div>
													</div>
													<div class="small text-muted mb-2 d-block">How long is the data retained?</div>
													<div class="fw-bold text-dark small mb-1">Retention Period</div>
													<input type="text" name="retentionPeriod[0]" data-top-field="retentionPeriod" class="form-control form-control-sm mb-3" placeholder="e.g. 2 years after collection" required>
												
													<div class="fw-bold text-dark small mb-1">Indicate Date</div>
													<input type="date" name="retentionDate[0]" data-top-field="retentionDate" class="form-control form-control-sm" required>
												</div>
											</div>
											<!-- Card 5 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Sharing</div>
													</div>
													<div class="small text-muted mb-3 d-block">How is the data being shared?</div>
													<div class="pdlc-sharings">
														<div class="pdlc-sharing border rounded-3 p-3 mb-3">
															<textarea name="sharings[0][0][dataSharing]" data-field="dataSharing" class="form-control mb-3" style="min-height: 70px; resize: vertical;" placeholder="e.g. Shared with external auditors, partners..." required></textarea>
															<div class="small text-muted mb-2 d-block">Who is it shared?</div>
															<textarea name="sharings[0][0][sharedTo]" data-field="sharedTo" class="form-control" style="min-height: 70px; resize: vertical;" placeholder="e.g. Shared with external auditors, partners..." required></textarea>
															<button type="button" class="btn btn-outline-danger btn-sm mt-3 remove-subentry-btn d-none" data-section="sharings">
																<i class="bi bi-trash me-1"></i> Remove
															</button>
														</div>
													</div>
													<button type="button" class="btn btn-outline-primary btn-sm add-subentry-btn" data-section="sharings">
														<i class="bi bi-plus-circle me-1"></i> Add Sharing
													</button>
												</div>
											</div>
											<!-- Card 6 -->
											<div class="col-12 col-md-6 col-lg-4">
												<div class="card bg-white border rounded-3 shadow-sm h-100 p-3">
													<div class="mb-2">
														<div class="fw-bold text-dark m-0">Disposal & Destruction</div>
													</div>
													<div class="small text-muted mb-2 d-block">How and when is the data destroyed?</div>
													<textarea name="disposalMethod[0]" data-top-field="disposalMethod" class="form-control mb-3" style="min-height: 70px; resize: vertical;" placeholder="e.g. Secure wiping after 5 years, physical shredding..." required></textarea>
													
													<div class="fw-bold text-dark small mb-1">Upload DLC Diagram</div>
													<input type="file" name="dlcDiagram[0]" data-top-field="dlcDiagram" class="form-control form-control-sm" accept="image/*">
												</div>
											</div>
										</div>
									</div>
								</div>
								<% } %>
					</div>
				</form>

				<script>
					document.addEventListener('DOMContentLoaded', function () {
						var container = document.getElementById('pdlcRowsContainer');
						var sectionConfig = {
							collections: { containerClass: 'pdlc-collections', entryClass: 'pdlc-collection' },
							uses: { containerClass: 'pdlc-uses', entryClass: 'pdlc-use' },
							sharings: { containerClass: 'pdlc-sharings', entryClass: 'pdlc-sharing' }
						};

						function clearEntryInputs(entry) {
							var textareas = entry.querySelectorAll('textarea');
							for (var i = 0; i < textareas.length; i++) {
								textareas[i].value = '';
							}

							var inputs = entry.querySelectorAll('input[type="text"], input[type="date"], input[type="file"]');
							for (var j = 0; j < inputs.length; j++) {
								inputs[j].value = '';
							}
						}

						function updateRowNumbers() {
							var rows = container.querySelectorAll('.pdlc-row');
							for (var i = 0; i < rows.length; i++) {
								var row = rows[i];
								var numSpan = row.querySelector('.row-number');
								if (numSpan) {
									numSpan.textContent = i + 1;
								}

								var removeBtn = row.querySelector('.remove-row-btn');
								if (removeBtn) {
									// Never allow deleting the very first row
									if (i > 0) {
										removeBtn.classList.remove('d-none');
										removeBtn.style.display = '';
									} else {
										removeBtn.classList.add('d-none');
										removeBtn.style.display = 'none';
									}
								}
							}
						}

						function updateSubEntryButtons(row) {
							Object.keys(sectionConfig).forEach(function (section) {
								var config = sectionConfig[section];
								var containerEl = row.querySelector('.' + config.containerClass);
								if (!containerEl) return;
								var entries = containerEl.querySelectorAll('.' + config.entryClass);
								for (var i = 0; i < entries.length; i++) {
									var removeBtn = entries[i].querySelector('.remove-subentry-btn');
									if (!removeBtn) continue;
									if (entries.length > 1) {
										removeBtn.classList.remove('d-none');
									} else {
										removeBtn.classList.add('d-none');
									}
								}
							});
						}

						function updateAllNames() {
							var rows = container.querySelectorAll('.pdlc-row');
							for (var i = 0; i < rows.length; i++) {
								var row = rows[i];
								var topFields = row.querySelectorAll('[data-top-field]');
								for (var j = 0; j < topFields.length; j++) {
									var field = topFields[j].getAttribute('data-top-field');
									topFields[j].name = field + '[' + i + ']';
								}

								Object.keys(sectionConfig).forEach(function (section) {
									var config = sectionConfig[section];
									var containerEl = row.querySelector('.' + config.containerClass);
									if (!containerEl) return;
									var entries = containerEl.querySelectorAll('.' + config.entryClass);
									for (var entryIndex = 0; entryIndex < entries.length; entryIndex++) {
										var inputs = entries[entryIndex].querySelectorAll('[data-field]');
										for (var k = 0; k < inputs.length; k++) {
											var fieldName = inputs[k].getAttribute('data-field');
											inputs[k].name = section + '[' + i + '][' + entryIndex + '][' + fieldName + ']';
										}
									}
								});
							}
						}

						// Attach listener safely by delegating to container just in case it takes time to render
						document.addEventListener('click', function (e) {
							if (e.target.closest('#addRowBtn')) {
								var rows = container.querySelectorAll('.pdlc-row');
								if (rows.length === 0) return;

								var firstRow = rows[0];
								var newRow = firstRow.cloneNode(true);

								// Delete the dark blue main header from the cloned row
								var mainHeader = newRow.querySelector('.pdlc-main-header');
								if (mainHeader) mainHeader.remove();

								// Reset values and keep only one sub-entry per section
								clearEntryInputs(newRow);
								Object.keys(sectionConfig).forEach(function (section) {
									var config = sectionConfig[section];
									var containerEl = newRow.querySelector('.' + config.containerClass);
									if (!containerEl) return;
									var entries = containerEl.querySelectorAll('.' + config.entryClass);
									for (var i = entries.length - 1; i >= 1; i--) {
										entries[i].parentNode.removeChild(entries[i]);
									}
									if (entries[0]) {
										clearEntryInputs(entries[0]);
									}
								});

								container.appendChild(newRow);
								updateRowNumbers();
								updateAllNames();
								updateSubEntryButtons(newRow);
							}
						});

						container.addEventListener('click', function (e) {
							var removeBtn = e.target.closest('.remove-row-btn');
							if (removeBtn) {
								var row = removeBtn.closest('.pdlc-row');
								if (row) {
									row.parentNode.removeChild(row);
									updateRowNumbers();
									updateAllNames();
								}
							}

							var addSubBtn = e.target.closest('.add-subentry-btn');
							if (addSubBtn) {
								var section = addSubBtn.getAttribute('data-section');
								var config = sectionConfig[section];
								if (!config) return;
								var row = addSubBtn.closest('.pdlc-row');
								if (!row) return;
								var containerEl = row.querySelector('.' + config.containerClass);
								if (!containerEl) return;
								var firstEntry = containerEl.querySelector('.' + config.entryClass);
								if (!firstEntry) return;
								var newEntry = firstEntry.cloneNode(true);
								clearEntryInputs(newEntry);
								containerEl.appendChild(newEntry);
								updateSubEntryButtons(row);
								updateAllNames();
							}

							var removeSubBtn = e.target.closest('.remove-subentry-btn');
							if (removeSubBtn) {
								var removeSection = removeSubBtn.getAttribute('data-section');
								var removeConfig = sectionConfig[removeSection];
								if (!removeConfig) return;
								var removeRow = removeSubBtn.closest('.pdlc-row');
								if (!removeRow) return;
								var removeEntry = removeSubBtn.closest('.' + removeConfig.entryClass);
								if (removeEntry) {
									var entryContainer = removeRow.querySelector('.' + removeConfig.containerClass);
									if (entryContainer && entryContainer.querySelectorAll('.' + removeConfig.entryClass).length > 1) {
										entryContainer.removeChild(removeEntry);
										updateSubEntryButtons(removeRow);
										updateAllNames();
									}
								}
							}
						});

						// Run on initial load to ensure state is correct
						updateRowNumbers();
						updateAllNames();
						var initRows = container.querySelectorAll('.pdlc-row');
						for (var r = 0; r < initRows.length; r++) {
							updateSubEntryButtons(initRows[r]);
						}
					});
				</script>

				<hr class="my-4 text-muted">
				<div class="d-flex align-items-center justify-content-between mt-2">
					<a href="/assessment/authorizedparties?id=<%= piaAssessmentId %>"
						class="btn btn-danger btn-modern shadow-sm">
						<i class="bi bi-arrow-left-short fs-5"></i> Previous Page
					</a>
					<span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill fw-medium">Step 3 of 5</span>
					<button type="submit" form="pdlcForm"
						class="btn btn-primary btn-modern shadow-sm">
						Next Page <i class="bi bi-arrow-right-short fs-5"></i>
					</button>
				</div>
			</div>
		</main>
	</div>
</div>