<%- include('../layouts/head', { title: title }) %>
<div class="d-flex">
	<%- include('../layouts/sidebar', { activePage: activePage }) %>
	<div class="flex-grow-1 main-content-offset">
		<%- include('../layouts/topbar', { title: title, user: user }) %>
		<main class="container-fluid py-4 px-4">
			<%
				const securityRows = Array.isArray(securityData) ? securityData : [];
				const typeOptions = typeof securityTypeOptions !== 'undefined' ? securityTypeOptions : ['TECHNICAL', 'ORGANIZATIONAL', 'PHYSICAL'];
				const assessmentId = typeof piaAssessmentId !== 'undefined' ? piaAssessmentId : '';
			%>
			<%- include('../layouts/stepper', { currentStep: 6, dpsTitle: 'Data Processing System' ,
				authParties: 'Authorized Parties' , processDataCycle: 'Process Data LifeCycle' , personalInfoInventory: 'Personal Information Inventory' , user: user
			}) %>
			
			<% if (error) { %>
				<div class="alert alert-danger mx-auto" style="max-width: 1000px;">
					<%= error %>
				</div>
			<% } %>
			<% if (success) { %>
				<div class="alert alert-success mx-auto" style="max-width: 1000px;">
					<%= success %>
				</div>
			<% } %>
			<div class="mx-auto" style="max-width: 1100px;">
				<style>
					/* Premium Modern UI Enhancements */
					:root {
						--primary-color: #0f172a;
						--primary-light: #1e293b;
						--accent-color: #3b82f6;
						--accent-hover: #2563eb;
						--bg-soft: #f8fafc;
						--border-light: #e2e8f0;
						--text-muted: #64748b;
						--text-dark: #0f172a;
						--shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
						--shadow-md: 0 8px 16px rgba(0,0,0,0.04);
						--shadow-hover: 0 12px 24px rgba(59, 130, 246, 0.1);
						--glass-bg: rgba(255, 255, 255, 0.95);
					}
					
					.cursor-pointer { cursor: pointer; }
					.transition-all { transition: all 0.2s ease-in-out; }
					.toggle-circle {
						width: 28px;
						height: 28px;
						border-radius: 50%;
						border: 2px solid var(--border-light);
						display: flex;
						align-items: center;
						justify-content: center;
						background-color: white;
						transition: all 0.2s;
					}
					.toggle-circle i {
						opacity: 0;
						font-size: 1.2rem;
					}
					.btn-check:checked + .toggle-card {
						border-color: var(--accent-color) !important;
						background-color: #eff6ff;
						box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
					}
					.btn-check:checked + .toggle-card .toggle-circle {
						background-color: var(--accent-color);
						border-color: var(--accent-color);
					}
					.btn-check:checked + .toggle-card .toggle-circle i {
						opacity: 1;
					}
					.security-panel {
						animation: fadeIn 0.3s ease-in-out;
					}
					@keyframes fadeIn {
						from { opacity: 0; transform: translateY(-5px); }
						to { opacity: 1; transform: translateY(0); }
					}
					
					.form-floating > .form-control:focus ~ label,
					.form-floating > .form-control:not(:placeholder-shown) ~ label,
					.form-floating > .form-select ~ label {
						color: var(--accent-color);
						font-weight: 600;
					}
					.form-control, .form-select {
						border-radius: 0.75rem;
						border: 1px solid var(--border-light);
						padding: 0.85rem 1.2rem;
						font-size: 0.95rem;
						background-color: #ffffff;
						transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
						box-shadow: inset 0 2px 4px rgba(0,0,0,0.01);
					}
					.form-control:focus, .form-select:focus {
						border-color: var(--accent-color);
						box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
						background-color: #ffffff;
						outline: none;
					}
					
					.custom-card {
						border-radius: 1.25rem;
						background: var(--glass-bg);
						backdrop-filter: blur(10px);
						border: 1px solid var(--border-light);
						box-shadow: var(--shadow-md);
						overflow: hidden;
						animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
					}
					.custom-header {
						background: linear-gradient(135deg, rgba(13, 27, 75, 0.05) 0%, transparent 100%);
						border-bottom: 2px solid rgba(13, 27, 75, 0.1);
						padding: 1.5rem 2rem;
					}
					.custom-header-title {
						color: #0d1b4b; /* matching sidebar primary color */
						font-weight: 700;
						letter-spacing: -0.5px;
					}
					.btn-modern.btn-sm {
						padding: 0.4rem 1rem;
						font-size: 0.875rem;
						border-radius: 0.5rem;
					}
					.btn-modern {
						border-radius: 0.75rem;
						padding: 0.75rem 1.75rem;
						font-weight: 600;
						transition: all 0.3s ease;
						display: inline-flex;
						align-items: center;
						gap: 0.5rem;
						border: none;
					}
					.btn-modern:hover {
						transform: translateY(-2px);
					}
					.btn-primary.btn-modern {
						background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
						color: white;
						box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
					}
					.btn-primary.btn-modern:hover {
						box-shadow: 0 8px 20px rgba(59, 130, 246, 0.35);
						background: linear-gradient(135deg, var(--accent-hover), #1d4ed8);
					}
					.btn-success.btn-modern {
						background: linear-gradient(135deg, #10b981, #059669);
						color: white;
						box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
					}
					.btn-success.btn-modern:hover {
						box-shadow: 0 8px 20px rgba(16, 185, 129, 0.35);
						background: linear-gradient(135deg, #059669, #047857);
					}
					.btn-danger.btn-modern {
						background: #fff;
						color: #ef4444;
						border: 1px solid #fee2e2;
						box-shadow: var(--shadow-sm);
					}
					.btn-danger.btn-modern:hover {
						background: #fef2f2;
						border-color: #fca5a5;
						transform: translateY(-2px);
					}
					@keyframes slideUpFade {
						from { opacity: 0; transform: translateY(20px); }
						to { opacity: 1; transform: translateY(0); }
					}
					
					.inner-card {
						background: #ffffff;
						border: 1px solid var(--border-light);
						border-radius: 1rem;
						box-shadow: var(--shadow-sm);
						padding: 1.5rem;
						height: 100%;
						transition: all 0.3s ease;
					}
					.inner-card:hover {
						transform: translateY(-4px);
						box-shadow: var(--shadow-hover);
						border-color: rgba(59, 130, 246, 0.3);
					}
					.inner-card-title {
						font-size: 1.1rem;
						font-weight: 700;
						color: var(--text-dark);
						margin-bottom: 0.5rem;
						display: flex;
						align-items: center;
						gap: 0.5rem;
						border-bottom: 1px solid var(--border-light);
						padding-bottom: 0.75rem;
					}
					.section-label {
						font-weight: 600;
						color: var(--text-dark);
						font-size: 0.9rem;
						margin-bottom: 0.5rem;
					}
				</style>
				<form id="securityForm" action="/assessment/securitymeasures" method="POST">
					<input type="hidden" name="piaAssessment_id" value="<%= assessmentId %>">

					<div class="border-0 custom-card mb-5 overflow-hidden">
						<div class="custom-header d-flex align-items-center">
							<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
								<i class="bi bi-shield-lock-fill fs-5"></i>
							</div>
							<div>
								<h5 class="mb-0 custom-header-title">Section F - Security Measures</h5>
								<small class="text-muted">Review and confirm security implementations.</small>
							</div>
						</div>
						<div class="card-body p-0" style="background-color: var(--bg-soft);">
							<div class="row g-0">
								
								<!-- Left Column: Controls -->
								<div class="col-12 col-md-5 col-lg-4 border-end bg-white">
									<div class="p-4 h-100">
										<h6 class="fw-bold mb-4 text-dark d-flex align-items-center">Select Security Types</h6>
										<div class="d-flex flex-column gap-3">
											
											<% 
												const orgMeasures = securityRows.filter(m => m.securityType === 'ORGANIZATIONAL');
												const physMeasures = securityRows.filter(m => m.securityType === 'PHYSICAL');
												const techMeasures = securityRows.filter(m => m.securityType === 'TECHNICAL');
											%>

											<!-- Organizational Toggle -->
											<label class="cursor-pointer d-block m-0">
												<input type="checkbox" class="btn-check security-toggle" id="toggle-org" data-target="panel-org" autocomplete="off" <%= orgMeasures.length ? 'checked' : '' %>>
												<div class="card border rounded-3 p-3 toggle-card transition-all h-100">
													<div class="d-flex align-items-center mb-2">
														<div class="toggle-circle me-3 flex-shrink-0">
															</div>
														<h6 class="fw-bold mb-0 text-dark">Organizational</h6>
													</div>
													<div class="small text-muted ps-5 lh-sm">ex. registration of DPO & DPS, conduct of PIA, ISO certification...</div>
												</div>
											</label>

											<!-- Physical Toggle -->
											<label class="cursor-pointer d-block m-0">
												<input type="checkbox" class="btn-check security-toggle" id="toggle-phys" data-target="panel-phys" autocomplete="off" <%= physMeasures.length ? 'checked' : '' %>>
												<div class="card border rounded-3 p-3 toggle-card transition-all h-100">
													<div class="d-flex align-items-center mb-2">
														<div class="toggle-circle me-3 flex-shrink-0">
															</div>
														<h6 class="fw-bold mb-0 text-dark">Physical</h6>
													</div>
													<div class="small text-muted ps-5 lh-sm">ex. CCTV, intrusion detection, biometric access, etc.</div>
												</div>
											</label>

											<!-- Technical Toggle -->
											<label class="cursor-pointer d-block m-0">
												<input type="checkbox" class="btn-check security-toggle" id="toggle-tech" data-target="panel-tech" autocomplete="off" <%= techMeasures.length ? 'checked' : '' %>>
												<div class="card border rounded-3 p-3 toggle-card transition-all h-100">
													<div class="d-flex align-items-center mb-2">
														<div class="toggle-circle me-3 flex-shrink-0">
															</div>
														<h6 class="fw-bold mb-0 text-dark">Technical</h6>
													</div>
													<div class="small text-muted ps-5 lh-sm">ex. antivirus, firewalls, encryption, passwords, etc.</div>
												</div>
											</label>

										</div>
									</div>
								</div>

								<!-- Right Column: Textareas -->
								<div class="col-12 col-md-7 col-lg-8">
									<div class="p-4 h-100 d-flex flex-column" id="descriptions-container">
										<h6 class="fw-bold mb-4 text-dark d-flex align-items-center">Measure Descriptions</h6>
										
										<!-- Placeholder when nothing is selected -->
										<div id="no-selection-placeholder" class="text-center text-muted my-auto py-5">
											Select a security type on the left to add its description.
										</div>

										<div class="d-flex flex-column gap-4 flex-grow-1">
											<!-- Org Panel -->
											<div id="panel-org" class="security-panel <%= orgMeasures.length ? '' : 'd-none' %>">
												<div class="card bg-white border border-primary border-opacity-50 shadow-sm rounded-3">
													<div class="card-body p-4">
														<div class="d-flex align-items-center justify-content-between mb-3">
															<div class="d-flex align-items-center">
																<div class="bg-primary rounded-circle me-2" style="width: 12px; height: 12px;"></div>
																<h6 class="fw-bold text-primary mb-0">Organizational Measures</h6>
															</div>
															<button type="button" class="btn btn-primary btn-sm add-measure-btn" data-panel="panel-org">
																<i class="bi bi-plus-lg"></i> Add
															</button>
														</div>
														<div class="measure-list">
															<% const orgList = orgMeasures.length ? orgMeasures : [{}]; %>
															<% orgList.forEach(function(measure, index) { %>
																<div class="measure-item">
																	<input type="hidden" name="securityType[]" value="ORGANIZATIONAL" class="type-input" <%= orgMeasures.length ? '' : 'disabled' %>>
																	<textarea name="description[]" class="form-control desc-input" style="min-height: 120px; resize: vertical;" placeholder="Describe the organizational security measures implemented..." <%= orgMeasures.length ? '' : 'disabled' %>><%= measure.description || '' %></textarea>
																	<div class="text-end mt-2">
																		<button type="button" class="btn btn-outline-danger btn-sm remove-measure-btn <%= orgList.length === 1 ? 'd-none' : '' %>">
																			<i class="bi bi-trash3 me-1"></i> Remove
																		</button>
																	</div>
																</div>
															<% }); %>
														</div>
														<div class="measure-template d-none">
															<div class="measure-item">
																<input type="hidden" name="securityType[]" value="ORGANIZATIONAL" class="type-input" disabled>
																<textarea name="description[]" class="form-control desc-input" style="min-height: 120px; resize: vertical;" placeholder="Describe the organizational security measures implemented..." disabled></textarea>
																<div class="text-end mt-2">
																	<button type="button" class="btn btn-outline-danger btn-sm remove-measure-btn">
																		<i class="bi bi-trash3 me-1"></i> Remove
																	</button>
																</div>
															</div>
														</div>
													</div>
												</div>
											</div>

											<!-- Phys Panel -->
											<div id="panel-phys" class="security-panel <%= physMeasures.length ? '' : 'd-none' %>">
												<div class="card bg-white border border-success border-opacity-50 shadow-sm rounded-3">
													<div class="card-body p-4">
														<div class="d-flex align-items-center justify-content-between mb-3">
															<div class="d-flex align-items-center">
																<div class="bg-success rounded-circle me-2" style="width: 12px; height: 12px;"></div>
																<h6 class="fw-bold text-success mb-0">Physical Measures</h6>
															</div>
															<button type="button" class="btn btn-success btn-sm add-measure-btn" data-panel="panel-phys">
																<i class="bi bi-plus-lg"></i> Add
															</button>
														</div>
														<div class="measure-list">
															<% const physList = physMeasures.length ? physMeasures : [{}]; %>
															<% physList.forEach(function(measure, index) { %>
																<div class="measure-item">
																	<input type="hidden" name="securityType[]" value="PHYSICAL" class="type-input" <%= physMeasures.length ? '' : 'disabled' %>>
																	<textarea name="description[]" class="form-control desc-input" style="min-height: 120px; resize: vertical;" placeholder="Describe the physical security measures implemented..." <%= physMeasures.length ? '' : 'disabled' %>><%= measure.description || '' %></textarea>
																	<div class="text-end mt-2">
																		<button type="button" class="btn btn-outline-danger btn-sm remove-measure-btn <%= physList.length === 1 ? 'd-none' : '' %>">
																			<i class="bi bi-trash3 me-1"></i> Remove
																		</button>
																	</div>
																</div>
															<% }); %>
														</div>
														<div class="measure-template d-none">
															<div class="measure-item">
																<input type="hidden" name="securityType[]" value="PHYSICAL" class="type-input" disabled>
																<textarea name="description[]" class="form-control desc-input" style="min-height: 120px; resize: vertical;" placeholder="Describe the physical security measures implemented..." disabled></textarea>
																<div class="text-end mt-2">
																	<button type="button" class="btn btn-outline-danger btn-sm remove-measure-btn">
																		<i class="bi bi-trash3 me-1"></i> Remove
																	</button>
																</div>
															</div>
														</div>
													</div>
												</div>
											</div>

											<!-- Tech Panel -->
											<div id="panel-tech" class="security-panel <%= techMeasures.length ? '' : 'd-none' %>">
												<div class="card bg-white border border-info border-opacity-50 shadow-sm rounded-3">
													<div class="card-body p-4">
														<div class="d-flex align-items-center justify-content-between mb-3">
															<div class="d-flex align-items-center">
																<div class="bg-info rounded-circle me-2" style="width: 12px; height: 12px;"></div>
																<h6 class="fw-bold text-info mb-0">Technical Measures</h6>
															</div>
															<button type="button" class="btn btn-info btn-sm add-measure-btn" data-panel="panel-tech">
																<i class="bi bi-plus-lg"></i> Add
															</button>
														</div>
														<div class="measure-list">
															<% const techList = techMeasures.length ? techMeasures : [{}]; %>
															<% techList.forEach(function(measure, index) { %>
																<div class="measure-item">
																	<input type="hidden" name="securityType[]" value="TECHNICAL" class="type-input" <%= techMeasures.length ? '' : 'disabled' %>>
																	<textarea name="description[]" class="form-control desc-input" style="min-height: 120px; resize: vertical;" placeholder="Describe the technical security measures implemented..." <%= techMeasures.length ? '' : 'disabled' %>><%= measure.description || '' %></textarea>
																	<div class="text-end mt-2">
																		<button type="button" class="btn btn-outline-danger btn-sm remove-measure-btn <%= techList.length === 1 ? 'd-none' : '' %>">
																			<i class="bi bi-trash3 me-1"></i> Remove
																		</button>
																	</div>
																</div>
															<% }); %>
														</div>
														<div class="measure-template d-none">
															<div class="measure-item">
																<input type="hidden" name="securityType[]" value="TECHNICAL" class="type-input" disabled>
																<textarea name="description[]" class="form-control desc-input" style="min-height: 120px; resize: vertical;" placeholder="Describe the technical security measures implemented..." disabled></textarea>
																<div class="text-end mt-2">
																	<button type="button" class="btn btn-outline-danger btn-sm remove-measure-btn">
																		<i class="bi bi-trash3 me-1"></i> Remove
																	</button>
																</div>
															</div>
														</div>
													</div>
												</div>
											</div>
										</div>

									</div>
								</div>

							</div>
						</div>
					</div>
					
					<!-- General Assessment Questionnaire -->
					<div class="border-0 custom-card mb-4">
						<div class="custom-header d-flex align-items-center">
							<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
								<i class="bi bi-ui-checks fs-5"></i>
							</div>
							<div>
								<h5 class="mb-0 custom-header-title">General Assessment Questionnaire</h5>
								<small class="text-muted">Final assessment questions.</small>
							</div>
						</div>
						<div class="card-body bg-white p-4">
							<div class="row g-4">
								
								<!-- Data Transfer & Sharing -->
								<div class="col-12 col-lg-6">
									<div class="inner-card d-flex flex-column">
										<div class="inner-card-title">
											Data Transfer & Sharing
										</div>
										
										<div class="mt-3 mb-4">
											<div class="section-label">Is personal data transferred outside of the Philippines?</div>
											<div class="d-flex gap-4 mt-2">
												<div class="form-check">
													<input class="form-check-input" type="radio" name="isDataTransferredOutsidePh" id="transferYes" value="true" <%= typeof assessment !== 'undefined' && assessment && assessment.isDataTransferredOutsidePh === true ? 'checked' : '' %>>
													<label class="form-check-label" for="transferYes">Yes</label>
												</div>
												<div class="form-check">
													<input class="form-check-input" type="radio" name="isDataTransferredOutsidePh" id="transferNo" value="false" <%= typeof assessment !== 'undefined' && assessment && assessment.isDataTransferredOutsidePh === false ? 'checked' : '' %>>
													<label class="form-check-label" for="transferNo">No</label>
												</div>
											</div>
										</div>

										<div class="mb-2">
											<div class="section-label">Is there any Data Sharing Agreements with other parties?</div>
											<div class="d-flex gap-4 mt-2">
												<div class="form-check">
													<input class="form-check-input" type="radio" name="hasDataSharingAgreement" id="dsaYes" value="true" <%= typeof assessment !== 'undefined' && assessment && assessment.hasDataSharingAgreement === true ? 'checked' : '' %>>
													<label class="form-check-label" for="dsaYes">Yes</label>
												</div>
												<div class="form-check">
													<input class="form-check-input" type="radio" name="hasDataSharingAgreement" id="dsaNo" value="false" <%= typeof assessment !== 'undefined' && assessment && assessment.hasDataSharingAgreement === false ? 'checked' : '' %>>
													<label class="form-check-label" for="dsaNo">No</label>
												</div>
											</div>
										</div>
									</div>
								</div>

								<!-- System Specifications -->
								<div class="col-12 col-lg-6">
									<div class="inner-card d-flex flex-column">
										<div class="inner-card-title">
											System Specifications
										</div>
										
										<div class="mt-3 mb-4">
											<div class="section-label">What is the name of the PIP?</div>
											<input type="text" name="pipName" class="form-control mt-2" value="<%= typeof assessment !== 'undefined' && assessment && assessment.pipName ? assessment.pipName : '' %>" placeholder="Enter PIP Name">
										</div>

										<div class="mb-2">
											<div class="section-label">Is the system a publicly facing online website or web-based application?</div>
											<div class="d-flex flex-column gap-2 mt-2">
												<div class="form-check">
													<input class="form-check-input" type="radio" name="isPublicFacing" id="facingExternal" value="EXTERNAL" <%= typeof assessment !== 'undefined' && assessment && assessment.isPublicFacing === 'EXTERNAL' ? 'checked' : '' %>>
													<label class="form-check-label" for="facingExternal">External</label>
												</div>
												<div class="form-check">
													<input class="form-check-input" type="radio" name="isPublicFacing" id="facingInternal" value="INTERNAL" <%= typeof assessment !== 'undefined' && assessment && assessment.isPublicFacing === 'INTERNAL' ? 'checked' : '' %>>
													<label class="form-check-label" for="facingInternal">Internal</label>
												</div>
												<div class="form-check">
													<input class="form-check-input" type="radio" name="isPublicFacing" id="facingBoth" value="BOTH" <%= typeof assessment !== 'undefined' && assessment && assessment.isPublicFacing === 'BOTH' ? 'checked' : '' %>>
													<label class="form-check-label" for="facingBoth">Both</label>
												</div>
											</div>
										</div>
									</div>
								</div>

								<!-- Processing Details -->
								<div class="col-12 col-lg-6">
									<div class="inner-card d-flex flex-column">
										<div class="inner-card-title">
											Processing Details
										</div>
										
										<div class="mt-3 mb-4">
											<div class="section-label">Is there any notification regarding any automated decision-making operation and/or profiling? (Check all that apply)</div>
											<div class="d-flex flex-column gap-2 mt-2">
												<div class="form-check">
													<input class="form-check-input" type="checkbox" name="hasAutomatedDecisionMaking" id="autoDec" value="true" <%= typeof assessment !== 'undefined' && assessment && assessment.hasAutomatedDecisionMaking === true ? 'checked' : '' %>>
													<label class="form-check-label" for="autoDec">Automated Decision Making</label>
												</div>
												<div class="form-check">
													<input class="form-check-input" type="checkbox" name="hasProfiling" id="profiling" value="true" <%= typeof assessment !== 'undefined' && assessment && assessment.hasProfiling === true ? 'checked' : '' %>>
													<label class="form-check-label" for="profiling">Profiling</label>
												</div>
											</div>
										</div>

										<div class="mb-4">
											<div class="section-label">What is the legal basis of processing personal data?</div>
											<input type="text" name="legalBasis" class="form-control mt-2" value="<%= typeof assessment !== 'undefined' && assessment && assessment.legalBasis ? assessment.legalBasis : '' %>" placeholder="E.g., Legitimate Interest, Contract...">
										</div>

										<div class="mb-2 mt-auto">
											<div class="section-label">What are other relevant information pertaining to the specified lawful basis?</div>
											<textarea name="otherLegalBasisInfo" class="form-control mt-2" style="min-height: 80px; resize: vertical;" placeholder="Enter details..."><%= typeof assessment !== 'undefined' && assessment && assessment.otherLegalBasisInfo ? assessment.otherLegalBasisInfo : '' %></textarea>
										</div>
									</div>
								</div>

								<!-- Consent Information -->
								<div class="col-12 col-lg-6">
									<div class="inner-card d-flex flex-column">
										<div class="inner-card-title">
											Consent Information
										</div>
										
										<div class="mt-3 mb-4">
											<div class="section-label">Is consent used as the basis for processing?</div>
											<div class="d-flex gap-4 mt-2">
												<div class="form-check">
													<input class="form-check-input" type="radio" name="isConsentUsed" id="consentYes" value="true" <%= typeof assessment !== 'undefined' && assessment && assessment.isConsentUsed === true ? 'checked' : '' %>>
													<label class="form-check-label" for="consentYes">Yes</label>
												</div>
												<div class="form-check">
													<input class="form-check-input" type="radio" name="isConsentUsed" id="consentNo" value="false" <%= typeof assessment !== 'undefined' && assessment && assessment.isConsentUsed === false ? 'checked' : '' %>>
													<label class="form-check-label" for="consentNo">No</label>
												</div>
											</div>
										</div>

										<div class="mb-2">
											<div class="section-label">Is consent form used and/or other proof for obtaining consent?</div>
											<div class="d-flex flex-column gap-2 mt-2">
												<div class="form-check">
													<input class="form-check-input" type="radio" name="consentProof" id="proofForm" value="CONSENT_FORM" <%= typeof assessment !== 'undefined' && assessment && assessment.consentProof === 'CONSENT_FORM' ? 'checked' : '' %>>
													<label class="form-check-label" for="proofForm">Consent Form</label>
												</div>
												<div class="form-check">
													<input class="form-check-input" type="radio" name="consentProof" id="proofOther" value="OTHER_PROOF" <%= typeof assessment !== 'undefined' && assessment && assessment.consentProof === 'OTHER_PROOF' ? 'checked' : '' %>>
													<label class="form-check-label" for="proofOther">Other proof of obtaining consent</label>
												</div>
												<div class="form-check">
													<input class="form-check-input" type="radio" name="consentProof" id="proofBoth" value="BOTH" <%= typeof assessment !== 'undefined' && assessment && assessment.consentProof === 'BOTH' ? 'checked' : '' %>>
													<label class="form-check-label" for="proofBoth">Both</label>
												</div>
											</div>
										</div>
									</div>
								</div>

							</div>
						</div>
						<hr class="my-4 text-muted mx-auto" style="max-width: 1100px;">
						<div class="d-flex justify-content-between align-items-center mt-2 mx-auto" style="max-width: 1100px;">
							<button type="submit" name="redirectTo" value="previous" formnovalidate
								class="btn btn-danger btn-modern shadow-sm">
								<i class="bi bi-arrow-left-short fs-5"></i> Previous Page
							</button>
							<span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill fw-medium">Step 6 of 7</span>
							<button type="submit" name="redirectTo" value="next"
								class="btn btn-primary btn-modern shadow-sm">
								Next Page <i class="bi bi-arrow-right-short fs-5"></i>
							</button>
						</div>
					</div>
				</form>
			</div>
		</main>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const toggles = document.querySelectorAll('.security-toggle');
		const placeholder = document.getElementById('no-selection-placeholder');
		const container = document.getElementById('descriptions-container');

		const updateRemoveButtons = (panel) => {
			const items = panel.querySelectorAll('.measure-item');
			items.forEach((item, index) => {
				const removeBtn = item.querySelector('.remove-measure-btn');
				if (removeBtn) {
					removeBtn.classList.toggle('d-none', items.length === 1 && index === 0);
				}
			});
		};

		const enablePanelInputs = (panel, enabled) => {
			panel.querySelectorAll('.type-input, .desc-input').forEach((input) => {
				if (enabled) {
					input.removeAttribute('disabled');
				} else {
					input.setAttribute('disabled', 'disabled');
				}
			});
		};

		const ensureOneItem = (panel) => {
			const list = panel.querySelector('.measure-list');
			if (!list) {
				return;
			}
			const items = list.querySelectorAll('.measure-item');
			if (items.length > 0) {
				return;
			}
			const template = panel.querySelector('.measure-template .measure-item');
			if (!template) {
				return;
			}
			const clone = template.cloneNode(true);
			list.appendChild(clone);
		};

		const updatePanels = () => {
			let anyChecked = false;
			toggles.forEach(toggle => {
				const targetId = toggle.getAttribute('data-target');
				const panel = document.getElementById(targetId);
				if (!panel) {
					return;
				}

				if (toggle.checked) {
					panel.classList.remove('d-none');
					ensureOneItem(panel);
					enablePanelInputs(panel, true);
					updateRemoveButtons(panel);
					anyChecked = true;
				} else {
					panel.classList.add('d-none');
					enablePanelInputs(panel, false);
				}
			});

			if (anyChecked) {
				placeholder.classList.add('d-none');
			} else {
				placeholder.classList.remove('d-none');
			}
		};

		toggles.forEach(toggle => {
			toggle.addEventListener('change', updatePanels);
		});

		if (container) {
			container.addEventListener('click', (event) => {
				const addBtn = event.target.closest('.add-measure-btn');
				if (addBtn) {
					event.preventDefault();
					const panelId = addBtn.getAttribute('data-panel');
					const panel = panelId ? document.getElementById(panelId) : addBtn.closest('.security-panel');
					if (!panel) {
						return;
					}
					const list = panel.querySelector('.measure-list');
					const template = panel.querySelector('.measure-template .measure-item');
					if (!list || !template) {
						return;
					}
					const clone = template.cloneNode(true);
					list.appendChild(clone);
					enablePanelInputs(panel, true);
					updateRemoveButtons(panel);
				}

				const removeBtn = event.target.closest('.remove-measure-btn');
				if (removeBtn) {
					event.preventDefault();
					const item = removeBtn.closest('.measure-item');
					const panel = removeBtn.closest('.security-panel');
					if (!item || !panel) {
						return;
					}
					item.remove();
					ensureOneItem(panel);
					updateRemoveButtons(panel);
				}
			});
		}

		updatePanels();
	});
</script>
