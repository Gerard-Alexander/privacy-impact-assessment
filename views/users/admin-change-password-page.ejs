<%- include('../layouts/head', { title: title }) %>

<div class="d-flex">
  <%- include('../layouts/sidebar', { activePage: 'manage-users' }) %>

  <div class="flex-grow-1 main-content-offset">
    <%- include('../layouts/topbar', { title: title, user: user }) %>

    <main class="container-fluid py-4">
      <div class="row justify-content-center">
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom border-light">
              <h5 class="fw-bold mb-1 text-primary">Change User Password</h5>
              <p class="text-muted mb-0 small">
                <%= targetUser.firstName %> <%= targetUser.lastName %> (@<%= targetUser.userName %>)
              </p>
            </div>
            <div class="card-body p-4">
              <% if (error === 'password') { %>
                <div class="alert alert-danger" role="alert">Password must be at least 6 characters.</div>
              <% } else if (error === 'confirm') { %>
                <div class="alert alert-danger" role="alert">The passwords do not match.</div>
              <% } else if (error === 'server') { %>
                <div class="alert alert-danger" role="alert">The password could not be changed. Please try again.</div>
              <% } %>

              <% if (success === '1') { %>
                <div class="alert alert-success" role="alert">Password changed successfully and saved to the database.</div>
              <% } %>

              <form action="/user-profile/manage-users/password/<%= targetUser.id %>" method="POST">
                <div class="mb-3">
                  <label for="password" class="form-label small fw-bold text-muted text-uppercase">New Password</label>
                  <input id="password" type="password" name="password" class="form-control rounded-3" minlength="6" required autocomplete="new-password">
                </div>
                <div class="mb-4">
                  <label for="confirmPassword" class="form-label small fw-bold text-muted text-uppercase">Confirm New Password</label>
                  <input id="confirmPassword" type="password" name="confirmPassword" class="form-control rounded-3" minlength="6" required autocomplete="new-password">
                </div>

                <div class="d-flex gap-2 pt-3 border-top border-light">
                  <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold">
                    <i class="bi bi-key me-1"></i> Change Password
                  </button>
                  <a href="/user-profile/manage-users" class="btn btn-outline-secondary px-4 rounded-pill fw-bold">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<style>
  .main-content-offset {
    background-color: #f1f5f9;
    min-height: 100vh;
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
